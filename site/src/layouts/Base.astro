---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean; // sign-in and parent pages: kept out of search results
}
const { title, description, noindex = false } = Astro.props;
// private pages (game, parent, sign-in) stay out of search results; the Library stays indexable
const path = Astro.url.pathname.replace(/\/+$/, '');
const hidden = noindex || path === '' || /^\/(train|quiz|paper|collection|parent|login|admin)(\/|$)/.test(path);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {hidden && <meta name="robots" content="noindex, nofollow" />}
    <!-- Login gate, step 1 (instant): game pages need a stored session, /parent needs an admin one. The module
         script below does the real check (idle limit, admin and authenticator level). -->
    <script is:inline>
      (function () {
        var p = location.pathname.replace(/\/+$/, ''), g = '';
        if (p === '' || /^\/(train|quiz|paper|collection)(\/|$)/.test(p)) g = 'game';
        else if (p === '/parent') g = 'admin';
        document.documentElement.setAttribute('data-gate', g);
        if (!g) return;
        var has = false;
        // the one allowed storage read outside store.ts; the key is AUTH_KEY in lib/supabase.ts
        try { has = localStorage.getItem('ccx:auth') !== null; } catch (e) {}
        document.documentElement.className += ' gate-pending';
        if (!has) { location.replace('/login'); return; }
        // fail-safe: never leave the page blank. A game page is shown; an admin page goes to the admin sign-in.
        setTimeout(function () {
          if (!document.documentElement.classList.contains('gate-pending')) return;
          if (g === 'admin') location.replace('/admin/');
          else document.documentElement.classList.remove('gate-pending');
        }, 5000);
      })();
    </script>
    <noscript><style>html.gate-pending body { visibility: visible !important; }</style></noscript>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600&family=Noto+Sans+SC:wght@400;600&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header" id="top">
      <div class="wrap bar">
        <a class="brand" href="/"><span class="brand-name"></span>Cookie Codex</a>
        <nav class="nav" aria-label="Main">
          <a href="/">Home</a>
          <a href="/codex/">Library</a>
          <a href="/collection/">My House</a>
          <a href="/parent/">Parents</a>
          <button type="button" id="logout" class="logout" hidden>Log out</button>
        </nav>
      </div>
      <div class="scallop" aria-hidden="true"></div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>Fan project, not affiliated with Devsisters.</p>
        <p>
          Cookie portraits from <a href="https://www.noff.gg/cookie-run-kingdom/cookies">noff.gg</a>.
          Backstories and personality text from the
          <a href="https://cookierunkingdom.fandom.com/">Cookie Run: Kingdom Wiki</a>,
          used under <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA</a>.
        </p>
      </div>
    </footer>
    <script>
      import { currentSession, offlineAllowed, supabase } from '../lib/supabase';
      import { initSync, logout, isChildSession } from '../lib/sync';
      import { kv } from '../lib/store';

      // The one place the signed-in child's name is shown: header brand, tab title, and every
      // <span class="player-sep"> (becomes ", <Name>"). It comes from the profile at login (kv player-name,
      // cleared on logout) and is never written into the save. Signed-out pages stay a plain "Cookie Codex".
      // ponytail: a profile rename shows after the child's next PIN login
      const showName = () => {
        const name = kv.get('player-name');
        if (!name) return;
        const brand = document.querySelector('.brand-name');
        if (brand) brand.textContent = `${name}'s `;
        if (document.title.endsWith('Cookie Codex')) document.title = document.title.replace(/Cookie Codex$/, `${name}'s Cookie Codex`);
        document.querySelectorAll('.player-sep').forEach((el) => (el.textContent = `, ${name}`));
      };

      const root = document.documentElement;
      const gate = root.getAttribute('data-gate');
      const release = () => root.classList.remove('gate-pending');
      document.getElementById('logout')?.addEventListener('click', () => { void logout(); });

      (async () => {
        let leaving = false; // a redirect is under way: keep the body hidden
        let child = false; // a child is playing (signed in, or offline on a remembered device)
        const go = (to: string) => { leaving = true; location.replace(to); };
        try {
          let session = null;
          try { session = await currentSession(); } catch { /* unreachable storage: treated as signed out */ }
          if (session) document.getElementById('logout')!.hidden = false;
          if (gate && !session) {
            if (gate === 'game' && await offlineAllowed()) {
              // offline with an expired token: play from the local save; sync resumes on reconnect
              document.getElementById('logout')!.hidden = false;
              child = true;
              return;
            }
            go('/login');
            return;
          }
          if (gate === 'admin') {
            let ok = false;
            try {
              const aal = await supabase.auth.mfa.getAuthenticatorAssuranceLevel();
              ok = session!.user.app_metadata?.role === 'admin' && aal.data?.currentLevel === 'aal2';
            } catch { /* fail closed */ }
            if (!ok) { go('/admin/'); return; }
          }
          if (session && isChildSession(session.user)) {
            child = true;
            // hold the page back (up to 4 s) while the newer server save is pulled, so it never shows stale progress
            await Promise.race([initSync().catch(() => {}), new Promise((r) => setTimeout(r, 4000))]);
          }
        } catch {
          if (gate === 'admin') go('/admin/'); // fail closed
        } finally {
          if (!leaving) { if (child) { try { showName(); } catch { /* storage unavailable */ } } release(); }
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  html.gate-pending body { visibility: hidden; }
</style>

<style>
  .site-header { background: var(--crust); }
  .bar {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1rem;
    padding-block: 1rem 0.4rem;
  }
  .brand {
    font-family: var(--font-display); font-weight: 600; font-size: 1.6rem;
    color: var(--cocoa); text-decoration: none; min-height: 44px; display: inline-flex; align-items: center;
  }
  .brand-sub { color: var(--cocoa-soft); font-size: 0.95rem; }
  .nav { margin-left: auto; display: flex; flex-wrap: wrap; gap: 0 1rem; }
  .nav a {
    font-family: var(--font-display); font-weight: 600; color: var(--berry);
    min-height: 44px; display: inline-flex; align-items: center;
  }
  .logout {
    font-family: var(--font-display); font-weight: 600; color: var(--berry); background: none; cursor: pointer;
    border: 1.5px solid var(--berry); border-radius: 10px; padding: 0 14px; min-height: 44px; align-self: center;
  }
  .site-header .scallop { background-color: var(--cream); }
  .site-footer {
    margin-top: 4rem; padding-block: 2rem; border-top: 1.5px dashed var(--crust);
    color: var(--cocoa-soft); font-size: 0.95rem;
  }
  .site-footer p { margin: 0.25rem 0; max-width: 70ch; }
</style>
