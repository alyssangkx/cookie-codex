---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
// One list of private routes: the login gate below guards GAME and PARENT; all of them (plus the sign-in
// pages) are kept out of search results with "noindex, follow", so the Library stays findable through them.
const GAME = '^/(train|quiz|paper|collection|shop)(/|$)';
const path = Astro.url.pathname.replace(/\/+$/, '');
const hidden = path === '' || new RegExp(GAME).test(path) || /^\/(parent|login|admin|grownups|signup|reset)(\/|$)/.test(path);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {hidden && <meta name="robots" content="noindex, follow" />}
    <!-- Login gate, step 1 (instant): game pages need a stored session, /parent a grown-up one. The module
         script below does the real check (idle limit, role and authenticator level). -->
    <script is:inline define:vars={{ GAME }}>
      (function () {
        var p = location.pathname.replace(/\/+$/, ''), g = '';
        if (p === '' || new RegExp(GAME).test(p)) g = 'game';
        else if (p === '/parent') g = 'admin';
        document.documentElement.setAttribute('data-gate', g);
        // the one allowed storage read outside store.ts: the player's session key (AUTH_KEY in lib/supabase.ts) and the
        // grown-up's (GROWNUP_AUTH_KEY); /parent needs the grown-up one, game pages the player one
        var key = g === 'admin' ? 'ccx:auth-gu' : 'ccx:auth';
        // signed-out visitors do not see the links that only lead to the sign-in page
        try { if (localStorage.getItem('ccx:auth') !== null || localStorage.getItem('ccx:auth-gu') !== null) document.documentElement.className += ' has-auth'; } catch (e) {}
        if (!g) return;
        var has = false;
        try { has = localStorage.getItem(key) !== null; } catch (e) {}
        document.documentElement.className += ' gate-pending';
        if (!has) { location.replace(g === 'admin' ? '/grownups/' : '/login'); return; }
        // fail-safe: never leave the page blank. A game page is shown; the parent page goes to the grown-ups sign-in.
        setTimeout(function () {
          if (!document.documentElement.classList.contains('gate-pending')) return;
          if (g === 'admin') location.replace('/grownups/');
          else document.documentElement.classList.remove('gate-pending');
        }, 5000);
      })();
    </script>
    <noscript><style>html.gate-pending body { visibility: visible !important; }</style></noscript>
    <!-- Noto Sans SC (Chinese glyphs) is only fetched when a page shows Chinese text: ccxZh() is called on load
         when the page has any, and by the quiz page when a Chinese question is drawn. -->
    <script is:inline>
      window.ccxZh = function () {
        if (window.ccxZhDone) return; window.ccxZhDone = true;
        var l = document.createElement('link'); l.rel = 'stylesheet';
        l.href = 'https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;600&display=swap';
        document.head.appendChild(l);
      };
      document.addEventListener('DOMContentLoaded', function () {
        var w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, { acceptNode: function (n) {
          var t = n.parentNode && n.parentNode.nodeName;
          return t === 'SCRIPT' || t === 'STYLE' ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT;
        } });
        while (w.nextNode()) if (/[\u3000-\u303f\u3400-\u9fff\uff00-\uffef]/.test(w.currentNode.nodeValue)) { window.ccxZh(); return; }
        // Chinese drawn later by scripts (parent lists, suggestions, review details) loads the font when it appears
        var mo = new MutationObserver(function (ms) {
          for (var i = 0; i < ms.length; i++) for (var j = 0; j < ms[i].addedNodes.length; j++)
            if (/[\u3000-\u303f\u3400-\u9fff\uff00-\uffef]/.test(ms[i].addedNodes[j].textContent || '')) { mo.disconnect(); window.ccxZh(); return; }
        });
        mo.observe(document.body, { childList: true, subtree: true, characterData: true });
      });
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header" id="top">
      <div class="wrap bar">
        <a class="brand" href="/"><span class="brand-name"></span>Cookie Codex</a>
        <nav class="nav" aria-label="Main">
          <a href="/">Home</a>
          <a href="/codex/">Library</a>
          <!-- always shown (owner, 23 Nov 2026): /parent sends anyone not signed in as a grown-up to the grown-ups sign-in -->
          <a href="/parent/">Grown-ups</a>
          <a class="gated" href="/collection/">My House</a>
          <a class="gated crumb-bal" href="/shop/" id="crumb-bal">Shop</a>
          <button type="button" id="logout" class="logout" hidden>Log out</button>
        </nav>
      </div>
      <div class="scallop" aria-hidden="true"></div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>Fan project, not affiliated with Devsisters.</p>
        <p>
          Cookie portraits from <a href="https://www.noff.gg/cookie-run-kingdom/cookies">noff.gg</a>.
          Backstories and personality text from the
          <a href="https://cookierunkingdom.fandom.com/">Cookie Run: Kingdom Wiki</a>,
          used under <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA</a>.
        </p>
      </div>
    </footer>
    <script>
      import { currentSession, offlineAllowed, grownup, adoptGrownup } from '../lib/supabase';
      import { initSync, logout, isChildSession } from '../lib/sync';
      import { kv, crumbBalance } from '../lib/store';

      // The one place the signed-in child's name is shown: header brand, tab title, and every
      // <span class="player-sep"> (becomes ", <Name>"). It comes from the profile at login (kv player-name,
      // cleared on logout) and is never written into the save. Signed-out pages stay a plain "Cookie Codex".
      // ponytail: a profile rename shows after the child's next PIN login
      const showName = () => {
        const name = kv.get('player-name');
        if (!name) return;
        const brand = document.querySelector('.brand-name');
        if (brand) brand.textContent = `${name}'s\u00a0`; // no-break space: the header's layout drops a plain one
        if (document.title.endsWith('Cookie Codex')) document.title = document.title.replace(/Cookie Codex$/, `${name}'s Cookie Codex`);
        document.querySelectorAll('.player-sep').forEach((el) => (el.textContent = `, ${name}`));
        // the Crumbs balance rides on the Shop link (the shop page updates it after a purchase)
        const bal = document.getElementById('crumb-bal');
        if (bal) bal.textContent = `Shop · ${crumbBalance()} Crumbs`;
      };

      const root = document.documentElement;
      const gate = root.getAttribute('data-gate');
      const release = () => root.classList.remove('gate-pending');
      // grown-up pages run on the grown-up's own session (lib/supabase.ts grownup): its Log out signs only the grown-up out
      const grown = /^\/(parent|admin|grownups|signup|reset)(\/|$)/.test(location.pathname);
      document.getElementById('logout')?.addEventListener('click', () => {
        if (!grown) { void logout(); return; }
        void grownup.auth.signOut({ scope: 'local' }).finally(() => location.replace('/grownups/'));
      });

      (async () => {
        let leaving = false; // a redirect is under way: keep the body hidden
        let child = false; // a child is playing (signed in, or offline on a remembered device)
        const go = (to: string) => { leaving = true; location.replace(to); };
        try {
          let session = null;
          try { if (await adoptGrownup()) { go(location.href); return; } session = await currentSession(grown ? grownup : undefined); } catch { /* unreachable storage: treated as signed out */ }
          if (session) document.getElementById('logout')!.hidden = false;
          if (gate && !session) {
            if (gate === 'game' && await offlineAllowed()) {
              // offline with an expired token: play from the local save; sync resumes on reconnect
              document.getElementById('logout')!.hidden = false;
              child = true;
              return;
            }
            go(gate === 'admin' ? '/grownups/' : '/login');
            return;
          }
          if (gate === 'admin') {
            // the admin always at aal2; a parent at aal1, or aal2 once they have enrolled an authenticator
            let ok = false;
            try {
              const aal = (await grownup.auth.mfa.getAuthenticatorAssuranceLevel()).data;
              const role = session!.user.app_metadata?.role;
              ok = role === 'admin' ? aal?.currentLevel === 'aal2'
                : role === 'parent' && (aal?.nextLevel !== 'aal2' || aal?.currentLevel === 'aal2');
            } catch { /* fail closed */ }
            if (!ok) { go('/grownups/'); return; }
          }
          if (session && isChildSession(session.user)) {
            child = true;
            // hold the page back (up to 4 s) while the newer server save is pulled, so it never shows stale progress
            await Promise.race([initSync().catch(() => {}), new Promise((r) => setTimeout(r, 4000))]);
          }
        } catch {
          if (gate === 'admin') go('/grownups/'); // fail closed
        } finally {
          if (!leaving) { if (child) { try { showName(); } catch { /* storage unavailable */ } } release(); }
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  html.gate-pending body { visibility: hidden; }
  html:not(.has-auth) .nav .gated { display: none; }
</style>

<style>
  .site-header { background: var(--crust); }
  .bar {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1rem;
    padding-block: 1rem 0.4rem;
  }
  .brand {
    font-family: var(--font-display); font-weight: 600; font-size: 1.6rem;
    color: var(--cocoa); text-decoration: none; min-height: 44px; display: inline-flex; align-items: center;
  }
  .brand-sub { color: var(--cocoa-soft); font-size: 0.95rem; }
  .nav { margin-left: auto; display: flex; flex-wrap: wrap; gap: 0 1rem; }
  .nav a {
    font-family: var(--font-display); font-weight: 600; color: var(--berry);
    min-height: 44px; display: inline-flex; align-items: center;
  }
  .logout {
    font-family: var(--font-display); font-weight: 600; color: var(--berry); background: none; cursor: pointer;
    border: 1.5px solid var(--berry); border-radius: 10px; padding: 0 14px; min-height: 44px; align-self: center;
  }
  .site-header .scallop { background-color: var(--cream); }
  .site-footer {
    margin-top: 4rem; padding-block: 2rem; border-top: 1.5px dashed var(--crust);
    color: var(--cocoa-soft); font-size: 0.95rem;
  }
  .site-footer p { margin: 0.25rem 0; max-width: 70ch; }
  .site-footer a { display: inline-block; padding-block: 0.85rem; margin-block: -0.85rem; }
</style>
