---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Alyssa's Cookie Codex" description="This page is not on the shelf.">
  <section class="wrap">
    <h1>This page isn't on the shelf</h1>
    <p>The link may be old, or the cookie's name may be spelled differently here.</p>
    <p><a href="/">Browse all cookies</a></p>
  </section>
</Base>

<style>
  section { padding-block: 3rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 0.75rem; }
</style>
