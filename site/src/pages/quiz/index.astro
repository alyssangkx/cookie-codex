---
import Base from '../../layouts/Base.astro';
import { triesPerDay } from '../../lib/store';
import { subs, hasContent, slots, cardInfo, banks, subSlug, paperTopics, clozeSubs, editingSubs, rarityOrder, competencyTopics, competencySubjects, banksHash } from '../../lib/train';

// Everything the runner needs, small enough to inline; question banks are fetched on demand.
const meta = {
  subs: Object.fromEntries(subs.filter(hasContent).map((s) => [s.id, {
    tries: triesPerDay(s.id), name: s.name, topicName: s.topicName, school: s.school, file: s.file, slug: subSlug(s.id), count: s.count,
    pool: s.pool ?? 0, // a one-pool sub-topic's past-paper question count (ADR 0011); 0 = tiers
  }])),
  files: banks.map((b) => b.topic),
  banks: banksHash, // the bank set Daily Review parks against (store.ts syncParked)
  cloze: clozeSubs,
  editing: editingSubs, // Editing: one passage, the printed wrong words underlined with a correction box each (lib/editing.ts)
  slots,
  cards: cardInfo,
  order: rarityOrder, // replacement order per rarity (crumbs.ts)
  topics: competencyTopics, // Super Epic topics
  subjects: competencySubjects, // subject Legendary
  topicNames: Object.fromEntries(paperTopics.map((t) => [t.id, t.name])),
};
const data = JSON.stringify(meta).replace(/</g, '\\u003c');
---
<Base title="Quiz · PSLE training" description="Timed PSLE practice quiz.">
  <section class="wrap quiz" id="quiz">
    <p class="crumbs" id="crumbs"><a href="/train/">Schools of Mastery</a></p>
    <h1 id="title">Quiz</h1>

    <div id="start" class="panel">
      <div id="start-info"><p>Loading…</p></div>
      <button id="start-btn" class="primary" type="button" hidden>Start quiz</button>
    </div>

    <div id="play" class="panel" hidden>
      <div class="status">
        <span id="count"></span>
        <span id="nocalc" class="nocalc" hidden>No calculator</span>
        <span id="timer" class="timer" role="timer" aria-label="Time left"></span>
      </div>
      <div id="pbar" class="pbar" hidden>
        <button id="p-sheet" type="button" aria-expanded="false" aria-controls="p-grid">Sheet</button>
        <button id="p-pause" type="button">Pause</button>
      </div>
      <div id="p-grid" class="p-grid" role="group" aria-label="Jump to a question" hidden></div>
      <div id="p-paused" class="p-paused" hidden>
        <p><strong>Paused.</strong> The questions are hidden and the paper clock has stopped.</p>
        <p id="p-paused-left" role="timer"></p>
        <button id="p-resume" class="primary" type="button">Resume</button>
      </div>
      <div id="qbody">
        <div id="visual" hidden></div>
        <p id="stem" class="stem"></p>
        <div id="options" class="options" role="group" aria-label="Answer options"></div>
      </div>
      <div id="feedback" class="feedback" hidden></div>
      <span id="fb-live" class="sr-only" aria-live="polite"></span>
      <button id="next" class="primary" type="button" hidden>Next question</button>
      <div id="pnav" class="pnav" hidden>
        <button id="p-prev" type="button">Back</button>
        <button id="p-next" class="primary" type="button">Next</button>
        <button id="p-submit" type="button">Submit</button>
      </div>
    </div>

    <div id="rv" class="panel" hidden>
      <div class="status"><span id="rv-count"></span><button id="rv-done" class="linkish" type="button">Back to results</button></div>
      <div id="rv-body"></div>
      <div class="pnav">
        <button id="rv-prev" type="button">Back</button>
        <button id="rv-next" class="primary" type="button">Next</button>
      </div>
    </div>

    <div id="done" class="panel" hidden>
      <h2 id="score"></h2>
      <div id="verdict" aria-live="polite"></div>
      <div id="review"></div>
      <p class="actions" id="actions"></p>
    </div>
  </section>
  <dialog id="leave-dlg" class="leave-dlg" aria-labelledby="leave-title">
    <h2 id="leave-title">Leave this quiz?</h2>
    <p id="leave-msg">It still counts as today's try and your answers so far are lost.</p>
    <p class="leave-actions"><button id="leave-stay" class="primary" type="button">Stay</button>
      <button id="leave-go" type="button">Leave</button></p>
  </dialog>
  <dialog id="submit-dlg" class="leave-dlg" aria-labelledby="submit-title">
    <h2 id="submit-title">Submit your paper?</h2>
    <p id="submit-msg"></p>
    <p class="leave-actions"><button id="submit-stay" type="button">Keep working</button>
      <button id="submit-go" class="primary" type="button">Submit</button></p>
  </dialog>
  <script type="application/json" id="meta" set:html={data} />
</Base>

<script>
  import { MIN_POOL,
    load, save, answer, finishQuiz, mergeRetests, beginQuiz, dayBlock, blockMessage, triesUsedUp, tierOpen, minutesFor,
    QUIZ_SIZE, tierState, poolProgress, TIER_NAME, MILESTONE_NAME, LEFT_BLANK, closeStalePapers, syncParkedStored, revisionDue, type Tier, type SaveV1, type QuizResult,
  PICK_MAX,
  } from '../../lib/store';
  import { stopLine, stopWord, poolRightText } from '../../lib/section';
  import type { Visual, Figure } from '../../lib/train';
  import { pickTier, pickPool, pickPassage, pickReview, reviewPassages, pickPaper, MIXES } from '../../lib/pick';
  import { PP_ENABLED, ppSubsFor, poolModeFor, mergePool, tierPoolIds, ppMode, ppFigureHtml, ppBadge, optionLabel, isPoolSub, isStub, isPpId, easierFirst, countingPool, underlineMarks, correctionHtml, type CxMark, type PpFig } from '../../lib/pastpaper';
  import { typedOk, compose, scaffoldHtml } from '../../lib/typed';
  import { wordBox, strikes, passageEnd } from '../../lib/cloze';
  import { replaceBlanks, hasOwnBlank, dropAskedLine, textFigureHtml, blanksIn, choose as pickBlank, place, unplace, usedPhrases, emptyBlanks, nextEmpty, optionIndex, setCorrections, type SetMark } from '../../lib/passageset';
  import { editingHtml, editWord, editAsk, editCorrections } from '../../lib/editing';
  import { esc, boldAns } from '../../lib/boldans';
  import { glossOption, type Gloss, type GlossLine } from '../../lib/zhgloss';
  import { toEconomy, balanceOf } from '../../lib/crumbs';
  import { lineForLast, bilingual } from '../../lib/encourage';
  import {
    newClock, tickPaper, canPause, startPause, endPause, pauseLeft, timeUsed, blanks, reviewList, paperOk, draftState,
    loadDraft, saveDraft, draftCurrent, clearDraft, discardDraft, draftOwner, paperSubject, staleText, type PaperDraft, type Pick,
  } from '../../lib/paper';

  type Q = { id: string; sub: string; level: string; figure?: Figure; topic?: string; stem: string; options: string[]; answer: number;
    explain: ({ tag: string; why: string } | null)[]; solution: string[]; group?: string; seq?: number; visual?: Visual; calc?: false;
    numbered?: true; ppFigs?: PpFig[]; ppText?: string[]; ppYear?: number | null; typed?: { accept: string[]; scaffold: string | null } }; // past-paper items only (pastpaper.ts; off while PP_ENABLED is false)
  type Meta = {
    subs: Record<string, { tries: number; name: string; topicName: string; school: string; file: string | null; slug: string; count: Record<Tier, number>; pool: number }>;
    files: string[]; banks: string; slots: Record<string, { slug: string; dup: boolean }>;
    cards: Record<string, { name: string; image: string; rarity: string }>;
    topicNames: Record<string, string>;
    cloze: string[];
    editing: string[];
    order: Record<string, string[]>; topics: Record<string, string[]>; subjects: Record<string, string[]>;
  };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const meta: Meta = JSON.parse($('meta').textContent!);
  const params = new URLSearchParams(location.search);
  const mode = (['review', 'paper'].includes(params.get('mode') ?? '') ? params.get('mode') : 'tier') as 'tier' | 'review' | 'paper';
  let paperTopics = (params.get('topics') ?? '').split(',').filter((t) => meta.files.includes(t));
  const paperN = Math.min(40, Math.max(5, Number(params.get('n')) || 20));
  let mixKey = Object.hasOwn(MIXES, params.get('mix') ?? '') ? params.get('mix')! : 'wa';
  let paperMix = MIXES[mixKey];
  const PER_Q: Record<string, number> = { basic: 1.2, intermediate: 1.5, competent: 2 };
  const subId = params.get('sub') ?? '';
  if (subId.startsWith('chi-')) queueMicrotask(() => loadGloss()); // early, so a wrong first answer already has it
  const tier = (params.get('tier') ?? 'b') as Tier;
  const sub = meta.subs[subId];
  const POOL = mode === 'tier' && !!sub?.pool; // a one-pool sub-topic (ADR 0011): no tier, milestones
  const LEVEL: Record<Tier, string> = { b: 'basic', i: 'intermediate', c: 'competent' };
  const rewardFor = (sid: string, t: Tier) => meta.slots[`${sid}|${t}`];
  const eco = toEconomy(meta); // replacement cards, star bonuses and achievement cards (crumbs.ts)
  let retestsPassed = 0; // due retest steps passed in this quiz: 1 Crumb each at the finish

  // the asked cloze blank (four ＿, or English "(N) " + 8 underscores) is marked and kept on one line; other blanks have fewer
  const fmt = (x: string, ans?: string) =>
    (ans ? boldAns(esc(x).replace(/\*\*([^*\n]+?)\*\*/g, '<strong>$1</strong>'), ans) : esc(x).replace(/\*\*([^*\n]+?)\*\*/g, '<strong>$1</strong>')).replace(/（(\d+)）＿＿＿＿/g, '<mark class="ask">（$1）＿＿＿＿</mark>')
      .replace(/\((\d+)\) (_{8})(?!_)/g, '<mark class="ask">($1) $2</mark>').split(/(<[^>]+>)/).map((p, n) => n % 2 ? p : p.replace(/(?:(\d+) )?(\d+)\/(\d+)/g, (_, w, n, d) =>
      `${w ? `${w}&#8239;` : ''}<span class="fr"><span class="n">${n}</span><span class="sr">/</span><span class="d">${d}</span></span>`)).join('');

  // Visual text (English): a poster, notice, brochure, timetable or email drawn as a styled card. Every string goes
  // through vfmt (escape + **bold** only, so "12/5" and "24/7" stay as written), so the data can never inject markup.
  const vfmt = (x: string) => esc(x).replace(/\*\*([^*\n]+?)\*\*/g, '<strong>$1</strong>');
  const visualCard = (v: Visual) => {
    const hdr = /^(From|To|Cc|Date|Subject):\s/;
    const head = v.kind === 'email' ? v.blocks.flatMap((b) => b.lines).filter((l) => hdr.test(l)) : [];
    const body = (b: Visual['blocks'][number]) => {
      const h = b.heading ? `<h4>${vfmt(b.heading)}</h4>` : '';
      if (v.kind === 'timetable' && b.lines.some((l) => l.includes(' | ')))
        return `${h}<table>${b.lines.map((l) => `<tr>${l.split(' | ').map((c) => `<td>${vfmt(c)}</td>`).join('')}</tr>`).join('')}</table>`;
      return `${h}${b.lines.filter((l) => !head.includes(l)).map((l) => `<p>${vfmt(l)}</p>`).join('')}`;
    };
    // one Subject row only: a Subject: line among the header lines wins over the title
    const subj = head.some((l) => l.startsWith('Subject:')) ? '' : /^Subject:\s/.test(v.title) ? v.title : `Subject: ${v.title}`;
    const mail = v.kind === 'email'
      ? `<div class="vt-mail">${v.subtitle ? `<p>${vfmt(v.subtitle)}</p>` : ''}${head.map((l) => `<p><strong>${vfmt(l.split(':')[0])}:</strong> ${vfmt(l.slice(l.indexOf(':') + 1).trim())}</p>`).join('')}${subj ? `<p><strong>Subject:</strong> ${vfmt(subj.replace(/^Subject:\s*/, ''))}</p>` : ''}</div>` : '';
    return `<div class="vt vt-${v.kind}" role="group" aria-label="${esc(v.kind)}: ${esc(v.title)}">`
      + (v.kind === 'email' ? mail : `<div class="vt-title">${vfmt(v.title)}</div>${v.subtitle ? `<div class="vt-sub">${vfmt(v.subtitle)}</div>` : ''}`)
      + v.blocks.map((b) => `<div class="vt-block">${body(b)}</div>`).join('')
      + (v.footer ? `<div class="vt-foot">${vfmt(v.footer)}</div>` : '') + '</div>';
  };

  // dialogue sets: shown disabled when already answered correctly for an earlier blank (a hint only; scoring is unchanged)
  const usedRight = new Map<string, Set<number>>();
  // the asked dialogue blank (the K in the last line 第（K）空…) is marked, like an asked cloze blank
  // blanks the child answered correctly in this quiz (group -> seq -> phrase) are shown filled in later questions
  const filledBlanks = new Map<string, Map<number, { t: string; ok: boolean }>>();
  const dialogueStem = (q: Q) => {
    const k = /第（(\d+)）空[^\n]*$/.exec(q.stem)?.[1];
    let h = fmt(q.stem);
    const fill = new Map(q.group ? filledBlanks.get(q.group) ?? [] : []);
    // blanks of this dialogue that are not in this quiz (a cut set, or already mastered) show their answer,
    // so only the blanks being asked are open and nothing looks skipped
    if (q.group) for (const o of members.get(q.group) ?? [])
      if (o.seq != null && !inQuiz.has(o.id)) fill.set(o.seq, { t: o.options[o.answer], ok: true });
    for (const [n, f] of fill) {
      if (String(n) === k) continue; // never fill the blank being asked
      h = h.replace(`（${n}）＿＿`, () => `（${n}）<span class="filled">${esc(f.t)}</span>`); // a function, so '$' in a phrase stays literal
    }
    return k ? h.replace(`（${k}）＿＿`, (m) => `<mark class="ask">${m}</mark>`) : h;
  };

  // cloze passage sets: a blank answered earlier in this quiz (right or wrong) reads as the correct text in later questions;
  // right = green, wrong = amber "correct answer". reveal = feedback state, the asked blank is filled too.
  // cloze sub-topics come from the syllabus JSON (`cloze: true` on the sub-topic), so a renamed or new cloze
  // section keeps its blank filling
  const CLOZE = new Set(meta.cloze);
  const EDIT = new Set(meta.editing); // Editing sections: marked words {{n|printed word}} in the passage
  const WHOLE = new Set([...meta.cloze, ...meta.editing]); // sections whose quiz is one whole passage with one Submit
  const MATES = new Set([...WHOLE, 'chi-dialogue-mcq']); // sets drawn as one passage: the blanks outside the quiz are fetched to show their answers
  const clozeStem = (q: Q, reveal: boolean) => {
    if (q.sub === 'eng-vocab-cloze') return underlineMarks(fmt(q.stem), q.seq ?? null); // a read passage: underlines
    const zh = q.sub === 'chi-cloze-mcq';
    const asked = zh ? /（(\d+)）＿＿＿＿/.exec(q.stem)?.[1] : /\((\d+)\) _{8}(?!_)/.exec(q.stem)?.[1];
    let h = fmt(q.stem);
    const span = (f: { t: string; ok: boolean }) => f.ok ? `<span class="filled">${esc(f.t)}</span>`
      : `<span class="filled fixed" title="correct answer">${esc(f.t)}</span>`;
    for (const [n, f] of filledBlanks.get(q.group ?? '') ?? []) {
      if (String(n) === asked) continue;
      const lead = zh ? `（${n}）` : `(${n}) `;
      h = h.replace(zh ? `（${n}）＿＿` : `(${n}) ____`, () => lead + span(f)); // a function, so '$' stays literal
    }
    // the other blanks of this passage: not in this quiz -> shown with their answer (grey, nothing looks skipped);
    // in this quiz and not answered yet -> a button that jumps to that question
    if (q.group) for (const o of members.get(q.group) ?? []) {
      if (o.seq == null || String(o.seq) === asked || filledBlanks.get(q.group)?.has(o.seq)) continue;
      const lead = zh ? `（${o.seq}）` : `(${o.seq}) `, blank = zh ? `（${o.seq}）＿＿` : `(${o.seq}) ____`;
      // a past-paper blank whose content was never fetched (a pool stub) has no answer text: it stays a blank
      const given = o.typed ? o.typed.accept[0] : o.options[o.answer]; // a typed blank (015) shows its model answer
      if (!inQuiz.has(o.id)) { if (given) h = h.replace(blank, () => `${lead}<span class="filled given" title="not in this quiz">${esc(given)}</span>`); }
      else if (!reveal && quiz.indexOf(o.id) > i) h = h.replace(blank, () => `<button type="button" class="blank-jump" data-id="${esc(o.id)}" aria-label="Go to blank ${o.seq}">${blank}</button>`);
    }
    const mine = filledBlanks.get(q.group ?? '')?.get(Number(asked));
    if (reveal && asked && mine) {
      h = h.replace(zh ? `<mark class="ask">（${asked}）＿＿＿＿</mark>` : `<mark class="ask">(${asked}) ________</mark>`,
        () => `<mark class="ask">${zh ? `（${asked}）` : `(${asked}) `}${span(mine)}</mark>`);
    }
    return h;
  };
  /** figs: past-paper pictures in the stem; the result list puts them in the row's body instead (a link or a folded
   * block inside a <summary> would open a tab, or is not valid). Reviewed one at a time, a set's pages show in full. */
  /** Soft-keyboard guard: only a mouse or trackpad user gets focus moved on render. */
  const mouseUser = () => matchMedia('(pointer: fine)').matches;
  /** The pinned word box or phrase bank's height, so a focused blank scrolls clear of it (CSS --pin-h). */
  const pinHeight = () => {
    const pin = document.querySelector<HTMLElement>('.quiz .wbox, .quiz .phrase-bank');
    document.documentElement.style.setProperty('--pin-h', pin ? `${Math.ceil(pin.getBoundingClientRect().height)}px` : '0px');
  };
  window.addEventListener('resize', () => pinHeight());
  /** Short text for the always-rendered live region (#feedback is hidden until filled, so screen readers can miss it). */
  const announce = (t: string) => { $('fb-live').textContent = ''; setTimeout(() => { $('fb-live').textContent = t; }, 50); };
  const ppFigsHtml = (q: Q, again: boolean) =>
    q.ppFigs?.length ? `<span class="qfig-wrap${q.group ? ' qfig-set' : ''}">${ppFigureHtml(q.ppFigs, again)}</span>` : '';
  const stemHtml = (q: Q, reveal = false, figs = true) => {
    const many = q.sub === 'chi-dialogue-mcq';
    const t = many ? dialogueStem(q) : CLOZE.has(q.sub) && q.group ? clozeStem(q, reveal)
      : EDIT.has(q.sub) ? editingHtml(fmt(q.stem), editWord) : fmt(q.stem);
    return ppBadge(q) + t + (q.figure ? `<span class="qfig-wrap">${figureHtml(q.figure)}</span>` : '')
      // a dialogue cannot be answered without its page: shown with every blank, never folded away
      + (figs ? ppFigsHtml(q, !reveal && laterInSet(q) && q.sub !== 'chi-dialogue-mcq') : '');
  };

  /** A question of a passage set after the set's first one in this quiz: its pages were already shown in full. */
  const laterInSet = (q: Q) => !!q.group && quiz.indexOf(q.id) > quiz.findIndex((id) => byId.get(id)?.group === q.group);
  let byId = new Map<string, Q>();
  let members = new Map<string, Q[]>(); // passage group -> its questions (built once per quiz, not per render)
  let inQuiz = new Set<string>(); // ids in the current quiz
  let quiz: string[] = [], i = 0, score = 0, deadline = 0, tick = 0, startedAt = 0, answered = false, over = false;
  let pausedAt = 0; // the clock stops while the worked solution is on screen
  let wrongs: { q: Q; chose: number; tag: string; typed?: string }[] = []; // typed: the sentence a typed answer made
  // papers (submit-then-review): a pick per question, the wall clock, and the draft that survives a reload
  let picks: Pick[] = [], pclock = newClock(0, 0), draft: PaperDraft | null = null, mins = 0, paperUsed = 0;
  let rvList: number[] = [], rvAt = 0;
  const PAPER = mode === 'paper';
  if (PAPER) $('quiz').classList.add('paper');

  const show = (p: 'start' | 'play' | 'done' | 'rv') => ['start', 'play', 'done', 'rv'].forEach((x) => ($(x).hidden = x !== p));
  const stop = (msg: string, links = '<a href="/train/">Back to the Schools</a>') => {
    $('start-info').innerHTML = `${msg}<br>${links}`;
    show('start');
  };

  async function fetchBank(file: string): Promise<Q[]> {
    const r = await fetch(`/data/quiz/${file}.json`);
    if (!r.ok) throw new Error(`Could not load questions (${r.status}).`);
    return r.json();
  }

  let genAll: Q[] = [], ppAll: Q[] = [], ppLoaded = false; // pools before the merge: tierIds() reports the tier quiz's pool, not the merged one
  let ppFailed = false; // a failed past-paper fetch: Daily Review must not park pp retests it never saw
  async function loadBanks(files: string[]): Promise<Q[]> {
    genAll = []; ppAll = []; ppLoaded = false; ppFailed = false;
    let all = (await Promise.all(files.filter(Boolean).map(async (f) => (await fetchBank(f)).map((q) => ({ ...q, topic: f }))))).flat();
    // past-paper items (ADR 0004): fetched from Supabase for a signed-in player, never from /data/quiz; OFF for now
    if (PP_ENABLED) {
      const subs = ppSubsFor(mode, subId, all.map((q) => q.sub));
      if (subs.length) {
        // ids, sub-topic, level and rank only (ADR 0012): the picked ones are fetched in full by hydrate() before they show
        const { fetchPool } = await import('../../lib/ppfetch');
        const pp = await fetchPool(subs, (x) => meta.subs[x]?.file ?? undefined);
        if (pp === null) { ppFailed = true; if (mode !== 'review' && !POOL) notice += ppNote(false, mode === 'paper' ? 'paper' : 'quiz'); }
        genAll = all; ppAll = (pp ?? []) as Q[]; ppLoaded = true;
        if (pp !== null) all = mergePool(all, ppAll, poolModeFor(mode)); // failed: keep every generated question (a pool quiz stops)
      }
    }
    // papers use 4-option items outside passage sets only (no 8-option dialogue item, no split passage)
    if (mode === 'paper') all = all.filter(paperOk);
    byId = new Map(all.map((q) => [q.id, q]));
    indexMembers();
    return all;
  }
  /** Passage groups from the questions loaded (again after a fallback adds generated questions). */
  const passage = (id: string) => { const q = byId.get(id); return q?.group ? { group: q.group, seq: q.seq ?? 0 } : undefined; };
  const ppReason = (limit: boolean) => (limit ? 'Past-paper questions are resting until tomorrow' : 'Past-paper questions could not load');
  const ppNote = (limit: boolean, what: string) => `<p class="note">${ppReason(limit)}, so this ${what} uses the other questions.</p>`;
  const KEPT = 'Your answers are kept: open the paper again later.';
  const due = (limit: boolean) => (limit ? 'Its time is up and it cannot be marked before then, so it will be put away unmarked.'
    : 'Its time is up and it cannot be marked without them. Try again soon: a paper left long past its time is put away unmarked.');
  function indexMembers() {
    members = new Map();
    for (const q of byId.values()) if (q.group) (members.get(q.group) ?? members.set(q.group, []).get(q.group)!).push(q);
  }

  /**
   * The picked past-paper questions are stubs (ids only, ADR 0012): fetch their text and pictures now, at most 15 a call.
   * Returns a reason to stop, or '' when the quiz is ready. A tier or pool quiz stops when they cannot load; Daily Review
   * and papers drop them and go on with the rest (and park nothing, as ppFailed says).
   */
  /** topUp: a new paper is picked again without them; keep: a resumed paper still running stops (draft kept) instead of
   * dropping them, as the next save would lose their answers. A due paper drops them and is handed in with the rest. */
  async function hydrate(topUp = true, keep: () => boolean = () => false): Promise<string> {
    // a cloze passage's blanks outside the quiz come too: shown with their answers, so nothing looks skipped
    const gs = new Set(quiz.map((id) => byId.get(id)).filter((q) => q?.group && MATES.has(q.sub)).map((q) => q!.group!));
    const mates = [...byId.values()].filter((q) => q.group && gs.has(q.group) && !quiz.includes(q.id)).map((q) => q.id);
    const want = [...quiz, ...mates].filter((id) => isStub(byId.get(id)));
    if (!want.length) return '';
    const { fetchItems } = await import('../../lib/ppfetch');
    const r = await fetchItems(want, (x) => meta.subs[x]?.file ?? undefined);
    if ('items' in r) {
      for (const q of r.items) byId.set(q.id, q as Q);
      indexMembers(); // the passages now hold the fetched rows, not their stubs
      // a stub always looks paper-ready (4 placeholder options); the real row may be typed (015) or 8-option: a paper drops it
      // ponytail: a new paper can come out a question short then; pp_pool carrying `kind` would let pickPaper skip them first
      if (mode === 'paper') quiz = quiz.filter((id) => paperOk(byId.get(id)!));
      return quiz.length ? '' : 'There are not enough questions for this paper right now. Try again later.';
    }
    const limit = r.error === 'daily_limit';
    if (mode === 'tier' && !POOL) { // a merged tier: carry on with its generated questions
      ppFailed = true;
      const gen = genAll.filter((q) => q.sub === subId && q.level === LEVEL[tier]).map((q) => q.id);
      const side = genAll.filter((q) => q.sub === subId && q.level !== LEVEL[tier]).map((q) => q.id);
      for (const q of genAll) if (q.sub === subId) byId.set(q.id, q);
      indexMembers();
      quiz = pickTier(gen, load().questions, QUIZ_SIZE, Date.now(), Math.random, side, passage);
      notice += ppNote(limit, 'quiz');
      return quiz.length >= QUIZ_SIZE ? '' : 'This tier does not have enough questions right now. Try again later.';
    }
    if (mode === 'paper' && keep()) return `${ppReason(limit)}. ${KEPT}`; // asked now: the paper may have come due meanwhile
    if (mode === 'tier') {
      return limit ? 'You have answered a lot of past-paper questions today. They open again tomorrow.'
        : 'Past-paper questions could not load. Check your connection and try again.';
    }
    ppFailed = true;
    if (mode === 'paper' && topUp) { // a new paper: pick it again from the generated questions (same mix, order and minutes)
      const gen = genAll.filter(paperOk);
      for (const q of gen) byId.set(q.id, q);
      indexMembers();
      quiz = pickPaper(gen as any, load().questions, paperN, paperMix.mix);
    } else quiz = quiz.filter((id) => !isStub(byId.get(id))); // a resumed paper or review drops them (with their picks)
    notice += ppNote(limit, mode === 'paper' ? 'paper' : 'review');
    return quiz.length ? '' : mode === 'review' ? 'Nothing to review right now. Try again later.'
      : topUp ? 'There are not enough questions for this paper right now. Try again later.' : `${ppReason(limit)}. ${due(limit)}`; // only a due paper gets here
  }

  let notice = ''; // a line shown above the start text (e.g. an old paper was put away)
  let handInChosen = false; // the child chose to hand in a paper whose time was up: never put it away on a later tick
  async function init() {
    const s = load();
    if (mode === 'tier') {
      if (!sub) return stop('This quiz does not exist.');
      $('title').textContent = POOL ? sub.name : `${sub.name}: ${TIER_NAME[tier]}`;
      $('crumbs').innerHTML = `<a href="/train/">Schools</a> › <a href="/train/${sub.school}/">${sub.school[0].toUpperCase() + sub.school.slice(1)}</a> › <a href="/train/${sub.school}/${sub.slug}/">${esc(sub.name)}</a>`;
    } else if (mode === 'paper') {
      $('title').textContent = 'Practice paper';
      // a paper already started on this device (by this player): its clock kept running while the page was closed.
      // Long past its time it is put away unscored; otherwise it is resumed when this link is that paper (a reload)
      // or asks to resume, and a different paper waits until the child chooses (never silently replaced).
      draft = loadDraft(draftOwner(s.createdAt));
      if (draft) {
        const st = draftState(draft.clock, Date.now());
        if (st === 'stale') {
          notice = `<p class="note">${esc(staleText(draft))}</p>`;
          putAway(draft);
        } else if (params.get('resume') === '1' || isThisPaper(draft)) {
          handInChosen = st === 'due'; // opened while due: the decision to hand it in is taken now, not on a later tick
          return resumePaper(draft);
        }
        else return draftChoice(draft);
      }
      if (!paperTopics.length) return stop(`${notice}Choose at least one topic.`, '<a href="/paper/">Build a paper</a>');
    } else {
      $('title').textContent = 'Daily Review';
    }
    const blocked = dayBlock(s, mode);
    if (blocked) return stop(blockMessage(blocked, s), '<a href="/collection/">See your cards</a> · <a href="/">Browse the Codex</a>');
    const playable = { b: sub?.count.b >= MIN_POOL, i: sub?.count.i >= MIN_POOL, c: sub?.count.c >= MIN_POOL };
    if (POOL && triesUsedUp(s, subId)) return stop(`You have had ${sub.tries} tries at this topic today. Try again tomorrow.`);
    if (mode === 'tier' && !POOL && !playable[tier]) return stop('This tier has no questions yet.');
    if (mode === 'tier' && !POOL && !tierOpen(s, subId, tier, playable)) return stop(`Clear ${tier === 'i' ? 'Basic' : 'Intermediate'} first.`);
    if (mode === 'tier' && !POOL && triesUsedUp(s, subId, tier)) return stop(`You have had ${sub.tries} tries at this tier today. Try again tomorrow.`);

    try {
      const files = mode === 'tier' ? [sub.file] : mode === 'paper' ? paperTopics : meta.files;
      const all = await loadBanks(files);
      // only Daily Review loads every bank, so only it parks retests whose question is gone; any page unparks the ids it
      // loaded (an older tab missing newer bank files may have parked them). Nothing is deleted (ADR 0002).
      // the save as stored now, not `s` from before the await: another tab may have bought or earned meanwhile
      const cur = syncParkedStored(all.map((q) => q.id), mode === 'review' && !ppFailed, meta.banks);
      if (POOL) {
        if (ppFailed) return stop('Past-paper questions could not load. Check your connection and try again.');
        const pool = easierFirst(all.filter((q) => q.sub === subId) as { id: string; ord?: number | null }[]);
        // a cloze section: one whole passage per quiz, every blank (owner, 24 Nov 2026); else the usual 10 questions
        quiz = WHOLE.has(subId) && pool.some((id) => passage(id)) ? pickPassage(pool, cur.questions, Date.now(), passage)
          : pickPool(pool, cur.questions, QUIZ_SIZE, Date.now(), passage);
        if (quiz.length < (WHOLE.has(subId) ? 2 : QUIZ_SIZE)) return stop('This topic does not have enough questions yet.');
      } else if (mode === 'tier') {
        const ids = all.filter((q) => q.sub === subId && q.level === LEVEL[tier]).map((q) => q.id);
        const side = all.filter((q) => q.sub === subId && q.level !== LEVEL[tier]).map((q) => q.id);
        quiz = pickTier(ids, cur.questions, QUIZ_SIZE, Date.now(), Math.random, side, passage);
        if (quiz.length < QUIZ_SIZE) return stop('This tier does not have enough questions yet. Try another tier.');
      } else if (mode === 'paper') {
        quiz = pickPaper(all as any, cur.questions, paperN, paperMix.mix);
      } else {
        // a passage's due blanks are asked together in passage order; its other blanks show their answer (clozeStem)
        // a revision test the parent sent is asked on its own first, while any of it is still due
        const have = new Set(all.map((q) => q.id)), rev = revisionDue(cur, Date.now(), meta.banks).filter((id) => have.has(id));
        quiz = reviewPassages(rev.length ? rev : pickReview(all.map((q) => q.id), cur.questions), passage);
        if (rev.length) $('title').textContent = 'Revision test';
        if (!quiz.length) return stop('Nothing to review today. Great work!');
      }
      const why = await hydrate();
      if (why) return stop(why);
    } catch (e) {
      return stop((e as Error).message);
    }
    const x = s.settings.extraTime ? 1.5 : 1;
    // a whole passage may be longer or shorter than 10 questions: its minutes scale with its blanks (at least 5)
    mins = POOL ? Math.max(5, Math.ceil(minutesFor(s, 'c') * quiz.length / QUIZ_SIZE)) : mode === 'tier' ? minutesFor(s, tier)
      : mode === 'paper' ? Math.ceil(quiz.reduce((m, id) => m + PER_Q[byId.get(id)!.level], 0) * x)
      : Math.ceil(quiz.length * 1.5 * x);
    deadline = mins * 60_000;
    $('start-info').innerHTML = notice + esc(POOL
      ? `${quiz.length} past-paper questions in ${mins} minutes. Every one you get right counts toward your milestones.`
      : mode === 'tier'
      ? `${quiz.length} questions in ${mins} minutes. Every question you get right counts toward clearing the tier.`
      : mode === 'paper' ? `${paperMix.label}: ${quiz.length} questions from ${paperTopics.length} topic${paperTopics.length > 1 ? 's' : ''} in ${mins} minutes, ordered from easier to harder. Answer them all, then submit; you see your score and the ones to fix after you submit. You can pause once, for up to 10 minutes.`
      : `${quiz.length} questions you got wrong before, in ${mins} minutes. Review counts toward today's goal.`);
    $('start-btn').hidden = false;
    show('start');
  }

  function begin() {
    retestsPassed = 0;
    if (!quiz.length) return; // nothing to play (locked, capped or empty tier)
    // re-check the daily block right before starting: the page may have been open since before the cap was reached
    const s0 = load();
    const now = Date.now();
    if (PAPER) { // another tab may have started a paper since this page loaded: never replace one that is running
      const d = loadDraft(draftOwner(s0.createdAt));
      if (d && draftState(d.clock, now) !== 'stale') return draftChoice(d);
      closeStalePapers(s0, now); // open paper records over 2 days old (abandoned, draft lost): no paper runs that long
    }
    const blocked = beginQuiz(s0, mode, { sub: mode === 'tier' ? subId : undefined, tier: mode === 'tier' && !POOL ? tier : undefined, total: quiz.length }, now);
    if (blocked) { quiz = []; return stop(blockMessage(blocked, s), '<a href="/collection/">See your cards</a> · <a href="/">Browse the Codex</a>'); }
    save(s0);
    i = 0; score = 0; wrongs = []; over = false; pausedAt = 0; usedRight.clear(); filledBlanks.clear(); setCards.clear(); setUi = null;
    inQuiz = new Set(quiz);
    startedAt = now;
    if (PAPER) {
      picks = quiz.map(() => null);
      pclock = newClock(now, mins * 60_000);
      // the draft's ts is the open attempt's ts: the paper's id
      draft = saveDraft({ v: 1, owner: draftOwner(s0.createdAt), ts: now, rev: 0, topics: paperTopics, mix: mixKey, ids: quiz, picks, at: 0, clock: pclock, mins }, now);
      if (!draft) { // lost a race with another tab: undo this paper's open record and offer that one instead
        s0.attempts = s0.attempts.filter((a) => !(a.open && a.ts === now));
        save(s0);
        const d = loadDraft(draftOwner(s0.createdAt));
        return d ? draftChoice(d) : stop('Something changed in another tab. Please reload the page.');
      }
      return playPaper();
    }
    history.pushState({ quiz: 1 }, ''); // a back press lands here first, so the leave guard can ask
    deadline += startedAt;
    tick = window.setInterval(clock, 250);
    clock();
    show('play');
    render();
  }

  const mmss = (ms: number) => `${Math.floor(ms / 60000)}:${String(Math.floor((ms % 60000) / 1000)).padStart(2, '0')}`;

  function clock() {
    if (PAPER) return paperClock();
    if (pausedAt) return;
    const left = Math.max(0, deadline - Date.now());
    $('timer').textContent = mmss(left);
    $('timer').classList.toggle('low', left < 60000);
    if (left === 0) finish(true);
  }

  // a figure is either inline SVG made by our own build scripts (a string) or line art with HTML labels over it
  // (Science): the image path is limited to /science/ and every text and the alt go through esc()
  const figureHtml = (f: Figure) => {
    if (typeof f === 'string') return f;
    if ('text' in f) return textFigureHtml(f.text, esc); // a passage as text: escaped, paragraphs on blank lines
    if (!/^\/science\/[\w.-]+\.webp$/.test(f.img)) return '';
    const pct = (n: number) => Math.min(100, Math.max(0, Number(n) || 0));
    const tags = (f.labels ?? []).map((l) =>
      `<span class="qfig-label" style="left:${pct(l.x)}%;top:${pct(l.y)}%">${esc(l.text)}</span>`).join('');
    return `<span class="qfig-art"><img src="${esc(f.img)}" alt="${esc(f.alt)}" loading="lazy" decoding="async">${tags}</span>`;
  };

  // ------------------------------------------------------------ papers: answer everything, then submit

  /** Shared by a new paper and a resumed one. The clock is the wall clock, so a resumed paper may already be over. */
  function playPaper(at = draft?.at ?? 0) {
    i = Math.min(Math.max(0, at), quiz.length - 1);
    over = false; wrongs = []; score = 0;
    inQuiz = new Set(quiz);
    $('leave-title').textContent = 'Leave this paper?';
    $('leave-msg').textContent = 'Your answers are kept, but the clock keeps running. Open Practice paper again to finish it.';
    history.pushState({ quiz: 1 }, ''); // a back press lands here first, so the leave guard can ask
    $('pbar').hidden = false;
    $('pnav').hidden = false;
    show('play');
    renderPaper();
    showPaused(!!pclock.pausedAt);
    tick = window.setInterval(clock, 250);
    clock(); // submits at once when the time ran out while the page was closed
  }

  async function resumePaper(d: PaperDraft) {
    paperTopics = d.topics.filter((t) => meta.files.includes(t));
    mixKey = Object.hasOwn(MIXES, d.mix) ? d.mix : 'wa';
    paperMix = MIXES[mixKey];
    try { await loadBanks(paperTopics); } catch (e) { return stop((e as Error).message); }
    notice = ''; // this paper's own notes only (not a new paper's set up earlier on this page)
    const running = () => !handInChosen && draftState(d.clock, Date.now()) === 'live'; // a due paper is handed in with what loaded
    if (ppFailed && d.ids.some((id) => isPpId(id) && !byId.has(id))) {
      if (running() || d.ids.every((id) => isPpId(id) || !byId.has(id))) return stop(`${ppReason(false)}. ${running() ? KEPT : due(false)}`); // nothing else to hand in
      notice = ppNote(false, 'paper');
    }
    // a bank rebuilt since the paper began may have lost a question: keep the rest
    const keep = d.ids.map((id, k) => [id, d.picks[k]] as const).filter(([id]) => byId.has(id));
    if (!keep.length) {
      clearDraft(); draft = null;
      return stop("That paper's questions have changed since you started it. Please build a new paper.", '<a href="/paper/">Build a paper</a>');
    }
    quiz = keep.map(([id]) => id);
    // past-paper questions are stubs after the reload (ADR 0012): fetch them, or drop them with their picks
    try { const why = await hydrate(false, running); if (why) return stop(why); } catch (e) { return stop((e as Error).message); }
    const left = keep.filter(([id]) => quiz.includes(id));
    const wasAt = d.ids[Math.min(Math.max(0, d.at ?? 0), d.ids.length - 1)]; // the question left on, or the next one still here
    const from = d.ids.indexOf(wasAt), at = left.findIndex(([id]) => d.ids.indexOf(id) >= from);
    picks = left.map(([id, p]) => (typeof p === 'number' && p >= 0 && p < byId.get(id)!.options.length ? p : null));
    pclock = { ...d.clock, pauseTaken: d.clock.pauseTaken ?? (d.clock.pauseUsed > 0 || !!d.clock.pausedAt) };
    startedAt = d.ts; mins = d.mins;
    $('title').textContent = 'Practice paper (resumed)';
    document.querySelector('.resume-note')?.remove();
    if (notice) { $('title').insertAdjacentHTML('afterend', `<div class="resume-note">${notice}</div>`); notice = ''; }
    playPaper(at < 0 ? left.length - 1 : at);
  }

  /** The link is the same paper as the draft (a reload of it): same topics and mix. */
  const isThisPaper = (d: PaperDraft) => !!paperTopics.length && mixKey === d.mix
    && [...paperTopics].sort().join() === [...d.topics].sort().join();

  /** Put the draft away unscored: no result, no retests; its own open record (by ts) is closed at once. */
  function putAway(d: PaperDraft) {
    const s = load();
    discardDraft(s, d);
    save(s);
    draft = null;
  }

  /** Another paper is running (or just ran out): finish it first, or discard it. Nothing starts by itself. */
  function draftChoice(d: PaperDraft) {
    const now = Date.now();
    const due = draftState(d.clock, now) === 'due';
    const n = d.ids.length;
    $('start-info').innerHTML = due
      ? `<p>Your ${esc(paperSubject(d))} paper's time is up. It will be handed in when you open it, and you will see your score.</p>`
      : `<p>You already have a ${esc(paperSubject(d))} paper in progress (${n} questions, ${mmss(tickPaper(d.clock, now).left)} left). Finish it before starting a new one.</p>`;
    $('start-info').innerHTML += `<p class="choice"><button id="d-resume" class="primary" type="button">${due ? 'Hand it in' : 'Resume that paper'}</button>`
      + ` <button id="d-discard" type="button">Discard it</button></p>`
      + '<p class="note">Discarding throws away its answers.</p>';
    $('start-btn').hidden = true;
    show('start');
    // read the draft again on click: the screen may have sat open while another tab answered, handed in or discarded it
    const fresh = () => { const f = loadDraft(draftOwner(load().createdAt)); return f && f.ts === d.ts ? f : null; };
    $('d-resume').onclick = () => {
      const f = fresh();
      if (!f) { notice = ''; return init(); } // gone or replaced meanwhile: look again
      const st = draftState(f.clock, Date.now());
      if (due) handInChosen = true; // "Hand it in" was chosen: hand it in even if the grace ran out while this screen sat open
      else if (st === 'stale') { notice = `<p class="note">${esc(staleText(f))}</p>`; putAway(f); return init(); }
      else handInChosen = st === 'due';
      draft = f;
      resumePaper(f);
    };
    $('d-discard').onclick = () => {
      const f = fresh();
      if (f) putAway(f);
      notice = f ? `<p class="note">The ${esc(paperSubject(f))} paper was discarded.</p>` : '';
      init();
    };
  }

  /** The page slept past the time by more than the grace (a locked phone, a tab left open): put away, not handed in. */
  function abandonStale() {
    const d = draft;
    over = true;
    clearInterval(tick);
    if (history.state?.quiz) history.back();
    for (const id of ['leave-dlg', 'submit-dlg']) { const dlg = $(id) as HTMLDialogElement; if (dlg.open) dlg.close(); }
    if (d && draftCurrent(d)) putAway(d);
    stop(d ? staleText(d) : 'This paper ran out of time a while ago, so it was put away without a score.', '<a href="/paper/">Build a new paper</a>');
  }

  /** Keep the draft in step; a stale tab (another tab wrote or submitted) stops here. */
  function persist() {
    if (!draft) return;
    const next = saveDraft({ ...draft, ids: quiz, picks, at: i, clock: pclock });
    if (next) { draft = next; return; }
    over = true;
    clearInterval(tick);
    if (history.state?.quiz) history.back();
    stop('This paper was changed or submitted in another tab or window, so this copy has stopped. Reload the page to carry on.',
      '<a href="/paper/">Practice paper</a>');
  }

  function paperClock() {
    if (over) return;
    const now = Date.now();
    const r = tickPaper(pclock, now);
    if (r.resumed) { pclock = r.clock; persist(); if (over) return; showPaused(false); }
    $('timer').textContent = mmss(r.left) + (pclock.pausedAt ? ' paused' : '');
    $('timer').classList.toggle('low', r.left < 60000);
    $('timer').classList.toggle('paused', !!pclock.pausedAt);
    if (pclock.pausedAt) $('p-paused-left').textContent = `Pause time left: ${mmss(pauseLeft(pclock, now))}`;
    if (r.submit) {
      if (draftState(pclock, now) === 'stale' && !handInChosen) return abandonStale();
      finish(true);
    }
  }

  function updatePauseBtn() {
    const b = $<HTMLButtonElement>('p-pause');
    b.disabled = !canPause(pclock, Date.now());
    b.textContent = pclock.pausedAt ? 'Paused' : pclock.pauseTaken ? 'Pause used' : 'Pause';
  }

  /** Paused: the questions, the sheet and the buttons are hidden; only Resume shows. */
  function showPaused(on: boolean) {
    $('p-paused').hidden = !on;
    $('qbody').hidden = on;
    $('pnav').hidden = on;
    $<HTMLButtonElement>('p-sheet').disabled = on;
    if (on) toggleSheet(false);
    updatePauseBtn();
  }

  function toggleSheet(open: boolean) {
    $('p-grid').hidden = !open;
    $('p-sheet').setAttribute('aria-expanded', String(open));
  }

  function drawSheet() {
    const b = blanks(picks);
    $('p-sheet').textContent = `Sheet · ${quiz.length - b}/${quiz.length} done`;
    $('p-grid').innerHTML = quiz.map((_, k) => `<button type="button" class="cell${picks[k] != null ? ' done' : ''}${k === i ? ' cur' : ''}" data-j="${k}"`
      + ` aria-label="Question ${k + 1}, ${picks[k] != null ? 'answered' : 'blank'}"${k === i ? ' aria-current="true"' : ''}>${k + 1}</button>`).join('')
      + `<p class="legend">${quiz.length - b} answered, ${b} blank. Tap a number to go there.</p>`;
  }

  function renderPaper() {
    const q = byId.get(quiz[i])!;
    $('count').textContent = `Question ${i + 1} of ${quiz.length}`;
    $('nocalc').hidden = q.calc !== false;
    $('visual').hidden = !q.visual;
    $('visual').innerHTML = q.visual ? visualCard(q.visual) : '';
    $('stem').innerHTML = stemHtml(q);
    $('options').classList.remove('many');
    $('options').innerHTML = q.options.map((o, k) => `<button type="button" class="opt${picks[i] === k ? ' sel' : ''}" data-k="${k}" aria-pressed="${picks[i] === k}">`
      + `<span class="letter">${optionLabel(q, k)}</span> <span>${fmt(o)}</span></button>`).join('');
    $<HTMLButtonElement>('p-prev').disabled = i === 0;
    $<HTMLButtonElement>('p-next').disabled = i + 1 >= quiz.length;
    $('p-submit').classList.toggle('primary', i + 1 >= quiz.length);
    drawSheet();
    updatePauseBtn();
  }

  /** Choose (or change) an answer. Nothing says right or wrong until the paper is submitted. */
  function choosePaper(k: number) {
    if (over || pclock.pausedAt || k < 0 || k >= byId.get(quiz[i])!.options.length) return;
    picks[i] = k;
    persist();
    if (over) return;
    $('options').querySelectorAll<HTMLButtonElement>('button').forEach((b, j) => {
      b.classList.toggle('sel', j === k);
      b.setAttribute('aria-pressed', String(j === k));
    });
    drawSheet();
  }

  function goTo(j: number) {
    if (over || pclock.pausedAt || j < 0 || j >= quiz.length) return;
    i = j;
    persist();
    if (over) return;
    renderPaper();
    $('quiz').scrollIntoView({ block: 'start' });
  }

  // ------------------------------------------------------------ feedback pieces shared by the quiz, paper review and results list

  /** The right answer, bold: a passage blank "(15) **word**", an MCQ "(2) **option**", a typed question "**model answer**". */
  const boldAnswer = (q: Q, seq?: number | null) => q.typed
    ? `${seq != null ? `(${seq}) ` : ''}<strong>${fmt(q.typed.accept[0])}</strong>`
    : `${optionLabel(q, q.answer)} <strong>${fmt(q.options[q.answer])}</strong>`;
  // a past-paper question's one-line reason (migration 014), shown open as "(15) **answer** why" (owner, 25 Nov 2026: no
  // "Why?" fold, the answer bold with its explanation, every section); generated questions keep their numbered steps
  /** The reason line itself states the answer (past-paper reasons only; generated steps may never say it). */
  const reasonSaysAnswer = (q: Q) => isPpId(q.id) && q.solution.length > 0;
  const stepsHtml = (q: Q, seq?: number | null) => !q.solution.length ? '' : (isPpId(q.id) // nothing written yet: nothing shown
    ? `<p class="why-right">${boldAnswer(q, seq)} ${fmt(q.solution[0])}</p>` // no answer-bolding inside the reason: "has" would light up everywhere
    : `<ol class="steps">${q.solution.map((st) => `<li>${fmt(st, q.options[q.answer])}</li>`).join('')}</ol>`);
  /** The answer as the results list writes it: the option with its label, or a typed question's model answer. */
  const answerText = (q: Q) => (q.typed ? fmt(q.typed.accept[0]) : `${optionLabel(q, q.answer)} (${fmt(q.options[q.answer])})`);
  /** "Report a problem" under the answer (migration 005): the question id goes to report_question; a grown-up looks it up. */
  const REPORT_KINDS: [string, string][] = [['picture', 'The picture is wrong or cut off'], ['answer', 'The answer looks wrong'],
    ['question', 'The question or options are muddled'], ['other', 'Something else']];
  const reported = new Set<string>(); // sent from this page: shown again (paper review Back/Next) as done, not as an empty form
  const reportHtml = (q: Q) => reported.has(q.id)
    ? '<p class="qz-report qz-report-msg">You reported a problem with this question. Thank you!</p>'
    : `<details class="qz-report" data-qid="${esc(q.id)}"><summary>Report a problem with this question</summary>`
    + `<fieldset><legend>What looks wrong?</legend>${REPORT_KINDS.map(([v, t], j) => `<label><input type="radio" name="rk-${esc(q.id)}" value="${v}"${j ? '' : ' checked'}> ${t}</label>`).join('')}</fieldset>`
    + `<label class="qz-report-note">Tell us more (optional)<input type="text" maxlength="300" autocomplete="off"></label>`
    + `<button type="button" class="qz-report-send">Send</button><p class="qz-report-msg" aria-live="polite"></p></details>`;
  async function sendReport(box: HTMLElement) {
    const btn = box.querySelector<HTMLButtonElement>('.qz-report-send')!, msg = box.querySelector('.qz-report-msg')!;
    const kind = box.querySelector<HTMLInputElement>('input[type=radio]:checked')?.value ?? 'other';
    const note = box.querySelector<HTMLInputElement>('.qz-report-note input')!.value.trim();
    btn.disabled = true;
    msg.textContent = 'Sending...';
    try {
      const { supabase } = await import('../../lib/supabase');
      const { error } = await supabase.rpc('report_question', { p_qid: box.dataset.qid, p_kind: kind, p_note: note || null });
      if (error) throw error;
      reported.add(box.dataset.qid!);
      msg.textContent = 'Thank you! A grown-up will check this question.';
    } catch {
      btn.disabled = false;
      msg.textContent = 'Could not send just now. Please try again later.';
    }
  }
  /** "Why B is tempting" for a wrong pick; nothing for a blank (k < 0 or null) or a pick without a note. A Chinese
   *  question also shows the pinyin and meaning of the answer's word and of the word picked (zhgloss.ts). */
  const temptingHtml = (q: Q, k: number | null) => {
    const why = k != null && k >= 0 ? q.explain[k] : null;
    const label = isPpId(q.id) ? "doesn't fit" : 'is tempting'; // a past-paper reason says why the option is wrong
    return (why?.why ? `<p class="mistake"><strong>Why ${optionLabel(q, k!)} ${label}:</strong> ${fmt(why.why, isPpId(q.id) ? undefined : q.options[q.answer])}</p>` : '')
      + glossHtml(q, k);
  };
  // the Chinese word list (CC-CEDICT, /zh-gloss.json): fetched once, when the first Chinese question is shown
  let zhGloss: Gloss | null = null, zhAsked = false;
  const loadGloss = () => {
    if (zhAsked) return;
    zhAsked = true;
    // any failure (network or a non-OK answer) lets the next Chinese question try again
    fetch('/zh-gloss.json').then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); })
      .then((j) => { zhGloss = j; }).catch(() => { zhAsked = false; });
  };
  const glossLine = (l: GlossLine) => `<span lang="zh">${esc(l.text)}</span> <span class="py">${esc(l.py)}</span>: ${esc(l.mean)}`;
  function glossHtml(q: Q, k: number | null) {
    if (!zhGloss || !q.sub.startsWith('chi-')) return '';
    const right = glossOption(zhGloss, q.sub, q.stem, q.options[q.answer] ?? '');
    const picked = k != null && k >= 0 && k !== q.answer ? glossOption(zhGloss, q.sub, q.stem, q.options[k] ?? '', true) : [];
    if (!right.length && !picked.length) return '';
    return '<div class="gloss">'
      + (right.length ? `<p><strong>The answer:</strong> ${right.map(glossLine).join(' · ')}</p>` : '')
      + (picked.length ? `<p><strong>You chose:</strong> ${picked.map(glossLine).join(' · ')}</p>` : '')
      + '<p class="credit">Pinyin and meanings: <a href="https://cc-cedict.org/" target="_blank" rel="noopener">CC-CEDICT</a>, '
      + '<a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA 4.0</a></p></div>';
  }

  // ------------------------------------------------------------ paper review: wrong and blank answers only

  function renderRv() {
    const k = rvList[rvAt], q = byId.get(quiz[k])!, p = picks[k];
    $('rv-count').textContent = `${rvAt + 1} of ${rvList.length} · Question ${k + 1}`;
    const opts = q.options.map((o, j) => `<div class="opt${j === q.answer ? ' right' : j === p ? ' wrong' : ''}"><span class="letter">${optionLabel(q, j)}</span> <span>${fmt(o)}</span></div>`).join('');
    $('rv-body').innerHTML = (q.visual ? visualCard(q.visual) : '')
      + `<p class="stem">${stemHtml(q, true)}</p><div class="options">${opts}</div><div class="feedback">`
      + `<p class="verdict bad">${p == null ? 'You left this blank.' : `You chose ${optionLabel(q, p)}.`} The answer is ${optionLabel(q, q.answer)}.</p>`
      + temptingHtml(q, p) + stepsHtml(q) + reportHtml(q) + '</div>';
    $<HTMLButtonElement>('rv-prev').disabled = rvAt === 0;
    $('rv-next').textContent = rvAt + 1 < rvList.length ? 'Next' : 'Back to results';
  }
  function openReview() {
    rvList = reviewList(quiz.map((id) => byId.get(id)!.answer), picks);
    if (!rvList.length) return;
    rvAt = 0;
    renderRv();
    show('rv');
    $('quiz').scrollIntoView({ block: 'start' });
  }
  function rvStep(d: number) {
    if (rvAt + d >= rvList.length) { show('done'); $('quiz').scrollIntoView({ block: 'start' }); return; }
    rvAt = Math.max(0, rvAt + d);
    renderRv();
    $('quiz').scrollIntoView({ block: 'start' });
  }

  function render() {
    const q = byId.get(quiz[i])!;
    if (pausedAt) { deadline += Date.now() - pausedAt; pausedAt = 0; $('timer').classList.remove('paused'); clock(); }
    answered = false;
    setUi = null;
    $('options').classList.remove('set');
    if (isWhole(q)) return renderPassage();
    if (isSetQ(q)) return renderSet();
    $('count').textContent = `Question ${i + 1} of ${quiz.length}`;
    $('nocalc').hidden = q.calc !== false;
    // figures are SVG generated by our own build scripts (scripts/quiz/math/figures.py)
    const many = q.sub === 'chi-dialogue-mcq'; // the 8-phrase dialogue sets (grid, struck-through used phrases)
    if (/^chi-|^duihua/.test(q.sub) || /[\u3400-\u9fff]/.test(q.stem)) { (window as unknown as { ccxZh?: () => void }).ccxZh?.(); loadGloss(); }
    $('visual').hidden = !q.visual;
    $('visual').innerHTML = q.visual ? visualCard(q.visual) : '';
    $('stem').innerHTML = stemHtml(q);
    const used = (many && q.group && usedRight.get(q.group)) || new Set<number>();
    $('options').classList.toggle('many', many);
    $('options').classList.toggle('typed', !!q.typed);
    if (q.typed) { // migration 015: a box in each blank of the answer line, then Check (or Enter)
      $('feedback').hidden = true;
      $('next').hidden = true;
      $('options').innerHTML = `<p class="typed-line">${q.seq != null && !q.typed.scaffold && CLOZE.has(q.sub) ? `<b>(${q.seq})</b> ` : ''}${scaffoldHtml(q.typed.scaffold, esc)}</p>`
        + '<p class="typed-hint" aria-live="polite"></p><button type="button" class="primary typed-check">Check my answer</button>';
      pinHeight(); // nothing pinned on a single question: a cloze word box's height must not linger in --pin-h
      if (mouseUser()) $('options').querySelector<HTMLInputElement>('.typed-box')?.focus();
      return;
    }
    $('options').innerHTML = q.options
      .map((o, k) => `<button type="button" class="opt${used.has(k) ? ' used' : ''}" data-k="${k}"${used.has(k) ? ' disabled' : ''}><span class="letter">${optionLabel(q, k)}</span> <span>${fmt(o)}</span></button>`)
      .join('');
    $('feedback').hidden = true;
    $('next').hidden = true;
    if (mouseUser()) $('options').querySelector<HTMLButtonElement>('button:not(:disabled)')?.focus();
  }

  /** A past-paper question of a one-pool sub-topic: wrong comes back after 1 day and counts once right then (ADR 0011). */
  const shortRetest = (id: string) => isPpId(id) && isPoolSub(byId.get(id)?.sub ?? '');
  /** For finishQuiz: every one-pool sub-topic this quiz loaded, with its counting pool (milestones count the pool, capped at
   * POOL_CAP easier-first, not the quiz). Left out when the past-paper list failed to load (a partial pool would store a
   * wrong total). */
  function pools(): Record<string, string[]> {
    return Object.fromEntries(Object.entries(poolRows()).map(([sub, qs]) => [sub, countingPool(qs)]));
  }
  function poolRows(): Record<string, { id: string; ord?: number | null; group?: string }[]> {
    if (!ppLoaded || ppFailed) return {};
    const by: Record<string, { id: string; ord?: number | null; group?: string }[]> = {};
    for (const q of ppAll) if (isPoolSub(q.sub)) (by[q.sub] ??= []).push(q as { id: string; ord?: number | null; group?: string });
    return by;
  }
  /** For finishQuiz: sub -> {id: passage group} over each section's counting pool, for the passages-done display field. */
  function poolGroups(): Record<string, Record<string, string>> {
    const out: Record<string, Record<string, string>> = {};
    for (const [sub, qs] of Object.entries(poolRows())) {
      const counted = new Set(countingPool(qs));
      const g = Object.fromEntries(qs.filter((q) => q.group && counted.has(q.id)).map((q) => [q.id, q.group!]));
      if (Object.keys(g).length) out[sub] = g;
    }
    return out;
  }
  // ---- Grammar / Comprehension Cloze answered whole (owner, 24 Nov 2026): every blank of the passage typed in place, one
  // Submit marks them all (each blank still its own question: score, retests); the Grammar Cloze word box is a grid whose
  // words strike through as the child ticks them (a note for a word not in the box or already used, never refused)
  const isWhole = (q: Q) => !PAPER && !!q.typed && !q.typed.scaffold && !!q.group && q.seq != null && WHOLE.has(q.sub);
  /** An MCQ question of a passage set (any subject): its set is one screen with one Submit (renderSet). */
  const isSetQ = (q: Q) => !PAPER && !q.typed && !!q.group && q.seq != null;
  const wholeGroup = (id: string) => { const o = byId.get(id); return o && (isWhole(o) || isSetQ(o)) ? o.group! : null; };
  let runEnd = 0, czWarned = false, czTicks = 0;
  /** A passage's blanks not in this quiz -> their answers (a blank never fetched has none: it stays a blank). */
  const givenFor = (g: string) => {
    const m = new Map<number, string>();
    for (const o of members.get(g) ?? []) { const a = o.typed ? o.typed.accept[0] : o.options[o.answer]; if (o.seq != null && !inQuiz.has(o.id) && a) m.set(o.seq, a); }
    return m;
  };
  const wordGrid = (words: string[]) => words.length
    ? `<span class="wbox" role="list" aria-label="Word box">${words.map((w, k) => `<span class="wb-w" role="listitem" data-k="${k}">${esc(w)}</span>`).join('')}</span>` : '';
  /** One passage's blanks after marking: right words filled, mistakes "(n) ~~typed~~ answer", blanks not in the quiz grey. */
  function passageFix(g: string, report = false, only?: Set<string>) {
    const marks = new Map<number, CxMark>();
    for (const [n, a] of givenFor(g)) marks.set(n, { kind: 'given', answer: a }); // not in this quiz: the answer in grey
    for (const [n, f] of filledBlanks.get(g) ?? []) marks.set(n, { kind: f.ok ? 'right' : 'wrong', typed: null, answer: f.t });
    const mine = wrongs.filter((w) => w.q.group === g && (!only || only.has(w.q.id))); // `only`: the blanks just submitted
    for (const w of mine) if (w.q.seq != null) marks.set(w.q.seq, { kind: 'wrong',
      typed: w.chose >= 0 ? w.q.options[w.chose] : w.typed ?? '', answer: w.q.typed ? w.q.typed.accept[0] : w.q.options[w.q.answer] });
    const q0 = (members.get(g) ?? []).find((o) => o.stem) ?? mine[0].q;
    const { words, rest } = wordBox(q0.stem);
    const { html, placed } = EDIT.has(q0.sub) ? editCorrections(fmt(rest), marks, esc) // Editing: each printed word struck, then the fix
      : correctionHtml(fmt(rest).replace(/<mark class="ask">([^<]*)<\/mark>/g, '$1'), marks, esc);
    const lost = mine.filter((w) => w.q.seq == null || !placed.has(w.q.seq)) // never dropped: listed under the passage
      .map((w) => `<p>(${w.q.seq ?? '?'}) ${w.typed ? `You wrote: ${esc(w.typed)}. ` : ''}Answer: ${answerText(w.q)}.</p>`).join('');
    const why = mine.map((w) => { const seq = w.q.seq ?? null;
      const rp = report ? reportHtml(w.q) : ''; // the report button lives in the quiz feedback, not the results list
      return (stepsHtml(w.q, seq) || `<p class="why-right">${boldAnswer(w.q, seq)}</p>`) + rp; }).join('');
    return { html: wordGrid(words) + html + ppFigsHtml(q0, false), lost, why, wrong: mine.length };
  }
  function renderPassage() {
    const q = byId.get(quiz[i])!, g = q.group!;
    // the passage's other blanks later in this quiz (a retest first, its passage's new blanks after) join this screen
    const later = quiz.slice(i + 1), same = later.filter((id) => wholeGroup(id) === g);
    quiz = [...quiz.slice(0, i + 1), ...same, ...later.filter((id) => wholeGroup(id) !== g)];
    runEnd = passageEnd(quiz, i, wholeGroup);
    czWarned = false;
    czTicks = 0;
    const run = quiz.slice(i, runEnd).map((id) => byId.get(id)!);
    const bySeq = new Map(run.map((o) => [o.seq!, o]));
    const boxed = new Set<string>();
    $('count').textContent = run.length > 1 ? `Questions ${i + 1}–${runEnd} of ${quiz.length}` : `Question ${i + 1} of ${quiz.length}`;
    $('nocalc').hidden = true;
    $('visual').hidden = true;
    $('visual').innerHTML = '';
    const given = givenFor(g);
    const { words, rest } = wordBox(q.stem);
    const tick = words.length ? '<button type="button" class="cz-tick" aria-label="Use this word from the box">✓</button>' : '';
    const box = (o: Q) => { boxed.add(o.id);
      return `<span class="ask-inline"><b>(${o.seq})</b> <input type="text" class="typed-box inline cz" data-id="${esc(o.id)}" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Answer for blank ${o.seq}">${tick}<span class="cz-note" aria-live="polite"></span></span>`; };
    // Editing: the printed wrong word, underlined and numbered, with its correction box beside it
    const edBox = (o: Q) => { boxed.add(o.id);
      return `<input type="text" class="typed-box inline cz" data-id="${esc(o.id)}" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Correction for number ${o.seq}">`; };
    const edFix = (n: number, word: string) => {
      const o = bySeq.get(n), f = filledBlanks.get(g)?.get(n), gv = given.get(n);
      if (o && !boxed.has(o.id)) return editAsk(n, word, edBox(o));
      if (f || gv) return editCorrections(`{{${n}|${word}}}`, new Map([[n, f ? { kind: f.ok ? 'right' as const : 'wrong' as const, typed: null, answer: f.t }
        : { kind: 'given' as const, answer: gv! }]]), esc).html;
      return editWord(n, word);
    };
    let html = EDIT.has(q.sub) ? editingHtml(fmt(rest), edFix)
      : fmt(rest).replace(/<mark class="ask">([^<]*)<\/mark>/g, '$1').replace(/\((\d{1,3})\) ?_{4,}/g, (all, n: string) => {
      const o = bySeq.get(Number(n)), f = filledBlanks.get(g)?.get(Number(n)), gv = given.get(Number(n));
      if (o && !boxed.has(o.id)) return box(o);
      if (f) return `(${n}) <span class="filled${f.ok ? '' : ' fixed'}">${esc(f.t)}</span>`;
      if (gv) return `(${n}) <span class="filled given" title="not in this quiz">${esc(gv)}</span>`;
      return `(${n}) ____`;
    });
    // a question whose blank the passage text does not show: its box under the passage, never skipped unmarked
    const extra = run.filter((o) => !boxed.has(o.id));
    if (extra.length) html += `<br><br>${extra.map(box).join('<br>')}`;
    $('stem').innerHTML = wordGrid(words) + ppBadge(q) + html + ppFigsHtml(q, false);
    $('options').classList.remove('many');
    $('options').classList.add('typed');
    $('options').innerHTML = `<p class="typed-hint" aria-live="polite"></p><button type="button" class="primary cz-submit">Submit all ${run.length} answer${run.length === 1 ? '' : 's'}</button>`;
    $('feedback').hidden = true;
    $('next').hidden = true;
    pinHeight();
    const first = $('stem').querySelector<HTMLInputElement>('input.cz');
    if (mouseUser()) { // on a phone, focusing a blank opens the keyboard before the passage is read (web guidelines audit M2)
      first?.focus({ preventScroll: true });
      first?.scrollIntoView({ block: 'center' });
    }
  }
  /** Strike the box words the ticked answers use; a note beside an answer not in the box, or whose word is used up. */
  function czStrikes() {
    const ws = [...$('stem').querySelectorAll<HTMLElement>('.wb-w')];
    const boxes = [...$('stem').querySelectorAll<HTMLInputElement>('input.cz')];
    const noteOf = (b: HTMLElement) => b.closest('.ask-inline')?.querySelector('.cz-note'); // an Editing box sits inside .ed-pair
    boxes.forEach((b) => { const n = noteOf(b); if (n) n.textContent = ''; });
    if (!ws.length) return;
    const ticked = boxes.filter((b) => b.dataset.ticked && b.value.trim()).sort((a, b) => Number(a.dataset.ticked) - Number(b.dataset.ticked)); // tick order
    const { struck, notes } = strikes(ws.map((w) => w.textContent ?? ''), ticked.map((b) => b.value));
    ws.forEach((w, k) => w.classList.toggle('used', struck.has(k)));
    ticked.forEach((b, k) => { const n = noteOf(b); if (n) n.textContent = notes[k] === 'not-in-box' ? 'not in the box' : notes[k] === 'used' ? 'already used' : ''; });
  }
  /** Tick (or Enter): the word strikes in the box; then on to the next empty blank. */
  function czTick(box: HTMLInputElement) {
    if (box.value.trim()) box.dataset.ticked = String(++czTicks);
    czStrikes();
    const boxes = [...$('stem').querySelectorAll<HTMLInputElement>('input.cz')];
    const next = boxes.slice(boxes.indexOf(box) + 1).find((b) => !b.value.trim()) ?? boxes.find((b) => !b.value.trim());
    if (next) { next.focus({ preventScroll: true }); next.scrollIntoView({ block: 'center' }); }
    else ($('options').querySelector('.cz-submit') as HTMLElement | null)?.focus();
  }
  /** Submit: every blank marked at once (an empty one after one warning; all of them when the time runs out). */
  function czSubmit(timeUp = false) {
    if (answered) return;
    const q0 = byId.get(quiz[i])!, g = q0.group!;
    const boxes = [...$('stem').querySelectorAll<HTMLInputElement>('input.cz')];
    const empty = boxes.filter((b) => !b.value.trim());
    if (empty.length && !timeUp && !czWarned) {
      czWarned = true;
      $('options').querySelector('.typed-hint')!.textContent = `${empty.length} blank${empty.length === 1 ? ' is' : 's are'} still empty. Press Submit again to hand it in as it is.`;
      empty[0].focus({ preventScroll: true });
      empty[0].scrollIntoView({ block: 'center' });
      return;
    }
    answered = true;
    pausedAt = Date.now();
    $('timer').classList.add('paused');
    $('timer').textContent += ' paused';
    let right = 0;
    const sv = load(), now = Date.now(); // one load and save for the whole passage
    for (const b of boxes) {
      const q = byId.get(b.dataset.id!)!, v = b.value.trim();
      const ok = !!v && typedOk(null, [v], q.typed!.accept);
      if (answer(sv, q.id, ok, now, true, ok ? undefined : v ? (v.length > PICK_MAX ? `${v.slice(0, PICK_MAX - 1)}…` : v) : timeUp ? undefined : LEFT_BLANK, shortRetest(q.id))) retestsPassed++;
      if (ok) { score++; right++; } else wrongs.push({ q, chose: -1, tag: v ? 'typed' : timeUp ? 'ran_out_of_time' : 'blank', typed: v });
      if (!filledBlanks.has(g)) filledBlanks.set(g, new Map());
      filledBlanks.get(g)!.set(q.seq!, { t: ok ? v : q.typed!.accept[0], ok });
    }
    save(sv);
    i = runEnd - 1; // Next goes past the whole passage
    const fx = passageFix(g, true, new Set(boxes.map((b) => b.dataset.id!)));
    $('stem').innerHTML = ppBadge(q0) + fx.html;
    $('options').innerHTML = '';
    const n = boxes.length;
    $('feedback').innerHTML = `<p class="verdict ${right === n ? 'good' : 'bad'}">${right} of ${n} right${right === n ? '!' : '.'}</p>`
      + (fx.wrong ? '<p>In the passage, what you wrote is crossed out and the answer is in bold.</p>' : '') + fx.lost + fx.why
      + (fx.wrong ? '' : reportHtml(q0));
    $('feedback').hidden = false;
    announce(`${right} of ${n} right${right === n ? '!' : '.'}`);
    $('next').textContent = i + 1 < quiz.length ? 'Next question' : 'See results';
    $('next').hidden = false;
    $('next').focus({ preventScroll: true });
    $('stem').scrollIntoView({ block: 'start' });
  }

  // ---- Passage sets answered whole (owner, 26 Nov 2026, docs/passage-sets-ui.md): one screen per set, every question
  // answered, ONE Submit marks them all. Each question stays its own question (answer(): score, retests). Three screens:
  // cloze chips (the passage is text, a blank's 4 options sit inline), dialogue (a phrase bank, drag or tap-tap) and a
  // list (passage on top, questions below; also the fallback for a set whose stem is one sentence under a page image).
  type SetUi = { kind: 'chips' | 'dialogue' | 'list'; run: string[]; picks: Map<number, number>; phrases: string[]; sel: number | null; warned: boolean };
  let setUi: SetUi | null = null;
  const setCards = new Map<string, string>(); // group -> the finished set's card for the results list (wrong ones only)
  const clip = (s: string) => (s.length > PICK_MAX ? `${s.slice(0, PICK_MAX - 1)}…` : s);
  const sameAll = (run: Q[], f: (o: Q) => unknown) => run.every((o) => JSON.stringify(f(o)) === JSON.stringify(f(run[0])));
  const figsTop = (o: Q) => (o.figure ? `<span class="qfig-wrap">${figureHtml(o.figure)}</span>` : '')
    + (o.ppText ?? []).map((t) => textFigureHtml(t, esc)).join('');
  /** A cloze or dialogue set's pictures, text passages and (when not shared by the whole set) visual cards, each once. */
  const setExtras = (run: Q[], sharedVis: boolean) =>
    [...new Map(run.filter((o) => o.figure).map((o) => [JSON.stringify(o.figure), o.figure!])).values()].map((f) => `<span class="qfig-wrap">${figureHtml(f)}</span>`).join('')
    + [...new Set(run.flatMap((o) => o.ppText ?? []))].map((x) => textFigureHtml(x, esc)).join('')
    + (sharedVis ? '' : [...new Map(run.filter((o) => o.visual).map((o) => [JSON.stringify(o.visual), o.visual!])).values()]
      .map((v) => `<details class="rev-vis" open><summary>The ${esc(v.kind)}</summary>${visualCard(v)}</details>`).join(''));
  /** The passage's own text for a set read as a list (a vocabulary cloze keeps its underlined words). */
  const listText = (o: Q, asked: number | null) => (o.sub === 'eng-vocab-cloze' ? underlineMarks(fmt(o.stem), asked) : fmt(o.stem));
  const unmark = (h: string) => h.replace(/<mark class="ask">([^<]*)<\/mark>/g, '$1');

  /** The passage with a blank swapped for `fn`'s html; blanks of the set not in this quiz show their answer in grey. */
  function setPassage(run: Q[], kind: 'chips' | 'dialogue', fn: (o: Q) => string, marks?: Map<number, SetMark>) {
    const q = run[0];
    const bySeq = new Map(run.map((o) => [o.seq!, o]));
    const given = givenFor(q.group!);
    const stem = kind === 'dialogue' ? dropAskedLine(q.stem) : q.stem;
    const base = unmark(fmt(stem));
    if (marks) {
      for (const [n, a] of given) if (!marks.has(n)) marks.set(n, { kind: 'given', answer: a });
      return setCorrections(base, marks, esc).html;
    }
    return replaceBlanks(base, (n, zh) => {
      const o = bySeq.get(n);
      if (o) return fn(o);
      const gv = given.get(n);
      const lead = zh ? `（${n}）` : `(${n}) `;
      return gv ? `${lead}<span class="filled given" title="not in this quiz">${esc(gv)}</span>` : zh ? `（${n}）＿＿＿＿` : `(${n}) ____`;
    }).html;
  }
  const chipHtml = (o: Q) => `<span class="chips" role="group" aria-label="Blank ${o.seq}"><b>${o.seq}</b>`
    + o.options.map((t, k) => `<button type="button" class="chip" data-seq="${o.seq}" data-k="${k}" aria-pressed="false" aria-label="Blank ${o.seq}: ${esc(t)}">${fmt(t)}</button>`).join('') + '</span>';
  const blankBtn = (o: Q) => `<button type="button" class="dblank" data-seq="${o.seq}"></button>`;

  function renderSet() {
    const q = byId.get(quiz[i])!, g = q.group!;
    const later = quiz.slice(i + 1), same = later.filter((id) => wholeGroup(id) === g);
    quiz = [...quiz.slice(0, i + 1), ...same, ...later.filter((id) => wholeGroup(id) !== g)];
    runEnd = passageEnd(quiz, i, wholeGroup);
    const run = quiz.slice(i, runEnd).map((id) => byId.get(id)!).sort((a, b) => (a.seq ?? 0) - (b.seq ?? 0)); // passage order on screen
    // inline only when the passage drawn (the first row's stem) shows every question's blank: else a blank would get no control
    const dlg = q.sub === 'chi-dialogue-mcq';
    const shown = blanksIn(unmark(fmt(dlg ? dropAskedLine(run[0].stem) : run[0].stem)));
    const inline = run.every((o) => hasOwnBlank(o.stem, o.seq) && shown.has(o.seq!));
    const kind = inline ? (dlg ? 'dialogue' : 'chips') : 'list';
    const ui: SetUi = { kind, run: run.map((o) => o.id), picks: new Map(), phrases: kind === 'dialogue' ? [...run[0].options] : [], sel: null, warned: false };
    setUi = ui;
    $('count').textContent = run.length > 1 ? `Questions ${i + 1}–${runEnd} of ${quiz.length}` : `Question ${i + 1} of ${quiz.length}`;
    $('nocalc').hidden = q.calc !== false;
    if (/^chi-/.test(q.sub) || /[㐀-鿿]/.test(q.stem)) { (window as unknown as { ccxZh?: () => void }).ccxZh?.(); loadGloss(); }
    const sharedVis = !!q.visual && sameAll(run, (o) => o.visual);
    $('visual').hidden = !sharedVis;
    $('visual').innerHTML = sharedVis ? visualCard(q.visual!) : '';
    $('feedback').hidden = true;
    $('next').hidden = true;
    const submit = `<p class="set-hint" aria-live="polite"></p><button type="button" class="primary set-submit">Submit all ${run.length} answer${run.length === 1 ? '' : 's'}</button>`;
    const opts = $('options');
    opts.classList.remove('many', 'typed');
    opts.classList.add('set');
    if (kind === 'chips') {
      $('stem').innerHTML = ppBadge(q) + setExtras(run, sharedVis) + setPassage(run, 'chips', chipHtml) + ppFigsHtml(q, false);
      opts.innerHTML = submit;
      if (mouseUser()) $('stem').querySelector<HTMLElement>('.chip')?.focus({ preventScroll: true });
    } else if (kind === 'dialogue') {
      const bank = `<div class="phrase-bank" role="group" aria-label="Phrases: drag one onto a blank, or tap a phrase and then a blank">`
        + ui.phrases.map((t, p) => `<button type="button" class="phrase" draggable="true" data-p="${p}" aria-pressed="false">${fmt(t)}</button>`).join('') + '</div>';
      $('stem').innerHTML = bank + ppBadge(q) + setExtras(run, sharedVis) + `<div class="dlg">${setPassage(run, 'dialogue', blankBtn)}</div>` + ppFigsHtml(q, false);
      opts.innerHTML = submit;
      dlgPaint();
      if (mouseUser()) $('stem').querySelector<HTMLElement>('.phrase')?.focus({ preventScroll: true });
    } else {
      const shared = run.length > 1 && sameAll(run, (o) => o.stem);
      const sharedFig = sameAll(run, (o) => [o.figure, o.ppText]);
      $('stem').innerHTML = ppBadge(q) + (sharedFig ? figsTop(q) : '') + (shared ? `<div class="set-text">${listText(q, null)}</div>` : '') + ppFigsHtml(q, false);
      const many = run.some((o) => o.options.length > 4);
      opts.innerHTML = run.map((o) => `<div class="set-q" role="group" aria-labelledby="sq-${o.seq}"><p class="set-qstem" id="sq-${o.seq}"><b>${o.seq}.</b> `
        + (shared ? '' : `${listText(o, o.seq ?? null)}${!sharedFig ? figsTop(o) : ''}`) + '</p>'
        + (!sharedVis && o.visual ? `<details class="rev-vis" open><summary>The ${esc(o.visual.kind)}</summary>${visualCard(o.visual)}</details>` : '')
        + `<div class="set-opts${many ? ' many' : ''}">${o.options.map((t, k) => `<button type="button" class="opt" data-sk="${o.seq}" data-k="${k}" aria-pressed="false"><span class="letter">${optionLabel(o, k)}</span> <span>${fmt(t)}</span></button>`).join('')}</div></div>`).join('') + submit;
      if (mouseUser()) opts.querySelector<HTMLElement>('.opt')?.focus({ preventScroll: true });
    }
    pinHeight();
    $('stem').scrollIntoView({ block: 'start' });
  }

  /** Paint the dialogue: the bank (a placed phrase greys out, the tapped one is pressed) and each blank (its phrase, or empty). */
  function dlgPaint() {
    const ui = setUi;
    if (!ui || ui.kind !== 'dialogue') return;
    const used = usedPhrases(ui.picks);
    $('stem').querySelectorAll<HTMLButtonElement>('.phrase').forEach((b) => {
      const p = Number(b.dataset.p);
      b.disabled = used.has(p);
      b.draggable = !used.has(p);
      b.setAttribute('aria-pressed', String(ui.sel === p));
    });
    $('stem').querySelectorAll<HTMLButtonElement>('.dblank').forEach((b) => {
      const n = Number(b.dataset.seq), p = ui.picks.get(n);
      b.classList.toggle('filled', p != null);
      b.innerHTML = p != null ? fmt(ui.phrases[p]) : `（${n}）＿＿＿＿`;
      b.setAttribute('aria-label', p != null ? `Blank ${n}: ${ui.phrases[p]}. Press to send this phrase back.`
        : `Blank ${n}, empty.${ui.sel != null ? ` Press to put "${ui.phrases[ui.sel]}" here.` : ' Choose a phrase first, or drag one here.'}`);
    });
  }
  function dlgPlace(phrase: number, seq: number) {
    const ui = setUi;
    if (!ui || ui.kind !== 'dialogue' || answered) return;
    ui.picks = place(ui.picks, phrase, seq);
    ui.sel = null;
    ui.warned = false;
    dlgPaint();
    const nx = nextEmpty(ui.run.map((id) => byId.get(id)!.seq!), ui.picks, seq);
    ($('stem').querySelector<HTMLElement>(nx != null ? `.dblank[data-seq="${nx}"]` : '.dblank:last-of-type') ?? $('stem')).focus({ preventScroll: true });
    if (nx == null) $('options').querySelector<HTMLElement>('.set-submit')?.focus({ preventScroll: true });
  }
  function dlgTapPhrase(p: number) {
    const ui = setUi;
    if (!ui || answered || ui.picks && usedPhrases(ui.picks).has(p)) return;
    ui.sel = ui.sel === p ? null : p;
    dlgPaint();
  }
  function dlgTapBlank(seq: number) {
    const ui = setUi;
    if (!ui || answered) return;
    if (ui.sel != null) return dlgPlace(ui.sel, seq);
    if (ui.picks.has(seq)) { ui.picks = unplace(ui.picks, seq); ui.warned = false; dlgPaint(); } // a filled blank sends its phrase back
  }
  /** A chip (cloze) or an option button (list): this blank or question now holds that option. */
  function setPickOption(seq: number, k: number, from: HTMLElement) {
    const ui = setUi;
    if (!ui || answered) return;
    ui.picks = pickBlank(ui.picks, seq, k);
    ui.warned = false;
    const scope = from.closest<HTMLElement>('.chips, .set-opts')!;
    scope.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
      const on = Number(b.dataset.k) === k;
      b.setAttribute('aria-pressed', String(on));
      b.classList.toggle('sel', on);
      b.classList.toggle('off', !on && ui.kind === 'chips'); // a cloze blank greys out its other options (tap one to change)
    });
  }

  /** Submit: every question marked at once (an empty one after one warning; all of them when the time runs out). */
  function setSubmit(timeUp = false) {
    const ui = setUi;
    if (answered || !ui) return;
    const run = ui.run.map((id) => byId.get(id)!);
    const empty = emptyBlanks(run.map((o) => o.seq!), ui.picks);
    if (empty.length && !timeUp && !ui.warned) {
      ui.warned = true;
      $('options').querySelector('.set-hint')!.textContent = `${empty.length} ${ui.kind === 'list' ? `question${empty.length === 1 ? ' is' : 's are'}` : `blank${empty.length === 1 ? ' is' : 's are'}`} still empty. Press Submit again to hand it in as it is.`;
      const first = ui.kind === 'list' ? $('options').querySelector<HTMLElement>(`[data-sk="${empty[0]}"]`)
        : ui.kind === 'chips' ? $('stem').querySelector<HTMLElement>(`.chip[data-seq="${empty[0]}"]`) : $('stem').querySelector<HTMLElement>(`.dblank[data-seq="${empty[0]}"]`);
      first?.focus({ preventScroll: true });
      first?.scrollIntoView({ block: 'center' });
      return;
    }
    answered = true;
    pausedAt = Date.now();
    $('timer').classList.add('paused');
    $('timer').textContent += ' paused';
    const g = run[0].group!, sv = load(), now = Date.now(); // one load and save for the whole set
    const marks = new Map<number, SetMark>(), got = new Map<string, { k: number; text: string | null }>();
    let right = 0;
    for (const o of run) {
      const p = ui.picks.get(o.seq!);
      const k = p == null ? -1 : ui.kind === 'dialogue' ? optionIndex(o.options, ui.phrases[p]) : p;
      const text = k >= 0 ? o.options[k] : p != null ? ui.phrases[p] : null; // a phrase not among this row's options is still shown
      const ok = k === o.answer;
      if (answer(sv, o.id, ok, now, true, ok ? undefined : text != null ? clip(text) : timeUp ? undefined : LEFT_BLANK, shortRetest(o.id))) retestsPassed++;
      if (ok) { score++; right++; } else wrongs.push({ q: o, chose: k, tag: k >= 0 ? o.explain[k]?.tag ?? 'wrong' : p != null ? 'wrong' : timeUp ? 'ran_out_of_time' : 'blank' });
      got.set(o.id, { k, text });
      marks.set(o.seq!, ok ? { kind: 'right', answer: o.options[o.answer] } : { kind: 'wrong', picked: text, answer: o.options[o.answer] });
      if (!filledBlanks.has(g)) filledBlanks.set(g, new Map());
      filledBlanks.get(g)!.set(o.seq!, { t: o.options[o.answer], ok });
    }
    save(sv);
    i = runEnd - 1; // Next goes past the whole set
    const n = run.length, bad = run.filter((o) => !marks.get(o.seq!) || marks.get(o.seq!)!.kind !== 'right');
    // the answers in place: a cloze or dialogue passage shows each blank, a list shows each question's options marked
    const why = run.map((o) => setWhy(o, got.get(o.id)!.k, marks.get(o.seq!)!.kind === 'right')).join('');
    let body: string, card: string;
    const q0 = run[0];
    if (ui.kind === 'list') {
      const shared = run.length > 1 && sameAll(run, (o) => o.stem), sharedFig = sameAll(run, (o) => [o.figure, o.ppText]);
      const top = ppBadge(q0) + (sharedFig ? figsTop(q0) : '') + (shared ? `<div class="set-text">${listText(q0, null)}</div>` : '') + ppFigsHtml(q0, false);
      const block = (o: Q) => { const r = got.get(o.id)!;
        return `<div class="set-q"><p class="set-qstem"><b>${o.seq}.</b> ${shared ? '' : listText(o, o.seq ?? null)}</p><div class="set-opts${o.options.length > 4 ? ' many' : ''}">`
          + o.options.map((t, k) => `<div class="opt${k === o.answer ? ' right' : k === r.k ? ' wrong' : ''}"><span class="letter">${optionLabel(o, k)}</span> <span>${fmt(t)}</span></div>`).join('') + '</div></div>'; };
      $('stem').innerHTML = top;
      $('options').innerHTML = run.map(block).join('');
      const vis = !!q0.visual && sameAll(run, (o) => o.visual) ? `<details class="rev-vis" open><summary>The ${esc(q0.visual!.kind)}</summary>${visualCard(q0.visual!)}</details>` : '';
      card = `<div class="rev rev-passage"><p class="rev-ph">${bad.length} to look at again in this set.</p>${vis}${top}${bad.map(block).join('')}`
        + bad.map((o) => setWhy(o, got.get(o.id)!.k, false)).join('') + '</div>';
    } else {
      const html = setPassage(run, ui.kind, () => '', new Map(marks));
      const extras = setExtras(run, !!q0.visual && sameAll(run, (o) => o.visual)), cardExtras = setExtras(run, false); // the results card has no #visual
      body = ppBadge(q0) + extras + (ui.kind === 'dialogue' ? `<div class="dlg">${html}</div>` : html) + ppFigsHtml(q0, false);
      $('stem').innerHTML = body;
      $('options').innerHTML = '';
      card = `<div class="rev rev-passage"><p class="rev-ph">${ppBadge(q0)}${bad.length} to fix in this passage: what you chose is crossed out, the answer is in bold.</p>${cardExtras}`
        + `<p class="stem">${ui.kind === 'dialogue' ? `<span class="dlg">${html}</span>` : html}</p>${bad.map((o) => setWhy(o, got.get(o.id)!.k, false)).join('')}</div>`;
    }
    if (bad.length) setCards.set(g, card);
    $('feedback').innerHTML = `<p class="verdict ${right === n ? 'good' : 'bad'}">${right} of ${n} right${right === n ? '!' : '.'}</p>`
      + (ui.kind !== 'list' && bad.length ? '<p>In the passage, what you chose is crossed out and the answer is in bold.</p>' : '') + why
      + (bad.length ? bad.map(reportHtml).join('') : reportHtml(q0));
    $('feedback').hidden = false;
    announce(`${right} of ${n} right${right === n ? '!' : '.'}`);
    $('next').textContent = i + 1 < quiz.length ? 'Next question' : 'See results';
    $('next').hidden = false;
    $('next').focus({ preventScroll: true });
    $('stem').scrollIntoView({ block: 'start' });
  }
  /** "(n) **answer** reason" for one question of a set (the past-paper line; a generated question keeps its numbered steps),
   *  then why a wrong pick was tempting. */
  function setWhy(o: Q, k: number, ok: boolean) {
    const lead = `(${o.seq}) <strong>${fmt(o.options[o.answer])}</strong>`;
    const line = isPpId(o.id) && o.solution.length ? `<p class="why-right">${lead} ${fmt(o.solution[0])}</p>`
      : `<p class="why-right">${lead}</p>${o.solution.length && !isPpId(o.id) ? `<ol class="steps">${o.solution.map((st) => `<li>${fmt(st, o.options[o.answer])}</li>`).join('')}</ol>` : ''}`;
    if (ok || k < 0) return line;
    const why = o.explain[k]?.why;
    const mine = why ? `<p class="mistake"><strong>Why “${fmt(o.options[k])}” ${isPpId(o.id) ? "doesn't fit" : 'is tempting'}:</strong> ${fmt(why, isPpId(o.id) ? undefined : o.options[o.answer])}</p>` : '';
    return line + mine + glossHtml(o, k);
  }

  function record(id: string, ok: boolean, picked?: string) {
    const s = load();
    if (answer(s, id, ok, Date.now(), true, picked, shortRetest(id))) retestsPassed++; // tier quizzes and Daily Review only: papers record in submitPaper()
    save(s);
  }

  /** An answered blank of a passage set fills in (a cloze shows the word in the passage; a dialogue greys the phrase out). */
  function fillBlank(q: Q, text: string, ok: boolean) {
    if (!q.group || q.seq == null) return;
    if (!filledBlanks.has(q.group)) filledBlanks.set(q.group, new Map());
    filledBlanks.get(q.group)!.set(q.seq, { t: text, ok });
    if (CLOZE.has(q.sub)) $('stem').innerHTML = stemHtml(q, true);
  }

  function choose(k: number) {
    if (answered || over) return;
    answered = true;
    pausedAt = Date.now();
    $('timer').classList.add('paused');
    $('timer').textContent += ' paused';
    const q = byId.get(quiz[i])!;
    const ok = k === q.answer;
    record(q.id, ok, ok ? undefined : q.options[k]); // the option text: options are shuffled, letters are not stable
    if (ok && q.group) { if (!usedRight.has(q.group)) usedRight.set(q.group, new Set()); usedRight.get(q.group)!.add(k); }
    if (q.group && q.seq != null && (CLOZE.has(q.sub) || (ok && q.sub === 'chi-dialogue-mcq'))) fillBlank(q, q.options[q.answer], ok);
    if (ok) score++; else wrongs.push({ q, chose: k, tag: q.explain[k]!.tag });
    $('options').querySelectorAll<HTMLButtonElement>('button').forEach((b, j) => {
      b.disabled = true;
      if (j === q.answer) b.classList.add('right');
      else if (j === k) b.classList.add('wrong');
    });
    $('feedback').innerHTML =
      (ok ? '<p class="verdict good">Correct!</p>'
          : `<p class="verdict bad">Not yet. The answer is ${optionLabel(q, q.answer)}.</p>${temptingHtml(q, k)}`) + stepsHtml(q) + reportHtml(q);
    $('feedback').hidden = false;
    announce(ok ? 'Correct.' : 'Not quite.');
    $('next').textContent = i + 1 < quiz.length ? 'Next question' : 'See results';
    $('next').hidden = false;
    $('next').focus();
  }

  /** A typed answer (migration 015): every box filled, the sentence it makes compared with the accepted answers (typed.ts). */
  function chooseTyped() {
    if (answered || over) return;
    const q = byId.get(quiz[i])!;
    if (!q.typed) return;
    const boxes = [...document.querySelectorAll<HTMLInputElement>('#stem .typed-box, #options .typed-box')]; // in the passage or below
    const parts = boxes.map((b) => b.value);
    if (parts.some((p) => !p.trim())) { // never marked half-typed: an empty box is a slip, not an answer
      const hint = document.querySelector('#stem .typed-hint, #options .typed-hint'); // beside an inline box, or under the line
      if (hint) hint.textContent = boxes.length > 1 ? 'Fill in every box first.' : 'Type your answer first.';
      boxes.find((b) => !b.value.trim())?.focus();
      return;
    }
    answered = true;
    pausedAt = Date.now();
    $('timer').classList.add('paused');
    $('timer').textContent += ' paused';
    const mine = compose(q.typed.scaffold, parts);
    const ok = typedOk(q.typed.scaffold, parts, q.typed.accept);
    // the parent page lists what was typed; the save keeps PICK_MAX characters, so a longer sentence ends in …
    record(q.id, ok, ok ? undefined : mine.length > PICK_MAX ? `${mine.slice(0, PICK_MAX - 1)}…` : mine);
    if (ok) score++; else wrongs.push({ q, chose: -1, tag: 'typed', typed: mine });
    boxes.forEach((b) => { b.disabled = true; b.classList.add(ok ? 'right' : 'wrong'); });
    document.querySelectorAll<HTMLButtonElement>('.typed-check').forEach((b) => { b.hidden = true; });
    document.querySelectorAll('.typed-hint').forEach((h) => { h.textContent = ''; });
    // an inline cloze box is then replaced by the filled-in word (the feedback says what was typed)
    if (q.group && q.seq != null && CLOZE.has(q.sub)) fillBlank(q, ok ? mine.trim() : q.typed.accept[0], ok); // as an MCQ cloze blank
    const also = q.typed.accept.length > 1 ? `<p class="typed-also">Also accepted: ${q.typed.accept.slice(1, 4).map(fmt).join(' · ')}</p>` : '';
    $('feedback').innerHTML = (ok ? '<p class="verdict good">Correct!</p>'
      : `<p class="verdict bad">Not yet.</p><p class="typed-mine"><strong>You wrote:</strong> ${esc(mine)}</p>`)
      + (reasonSaysAnswer(q) ? '' : `<p class="typed-model"><strong>${ok ? 'Model answer' : 'Answer'}:</strong> ${fmt(q.typed.accept[0])}</p>`) + stepsHtml(q) + also + reportHtml(q);
    $('feedback').hidden = false;
    announce(ok ? 'Correct.' : 'Not quite.');
    $('next').textContent = i + 1 < quiz.length ? 'Next question' : 'See results';
    $('next').hidden = false;
    $('next').focus(); // scrolls Next (and the verdict above it) into view: no scrolling by hand after a long passage
  }

  // "sub|tier" -> every question id of that tier, for the subs in this quiz. store.ts clears a tier when
  // all of these are retired. Only tiers with a full pool (MIN_POOL+ questions) can be cleared.
  function tierIds(): Record<string, string[]> {
    const subsInQuiz = new Set(quiz.map((id) => byId.get(id)!.sub));
    const tierOf = Object.fromEntries(Object.entries(LEVEL).map(([t, l]) => [l, t]));
    const out: Record<string, string[]> = {};
    // the tier quiz's pool per tier (pp swapped in on 'replace' tiers), whichever pool this quiz drew from
    const gen = (ppLoaded ? genAll : [...byId.values()]).filter((q) => subsInQuiz.has(q.sub) && tierOf[q.level]);
    const pool = tierPoolIds(gen, ppAll.filter((q) => subsInQuiz.has(q.sub)), (x) => ppMode(x), ppFailed);
    for (const [k, ids] of Object.entries(pool)) { const [sub, lvl] = k.split('|'); out[`${sub}|${tierOf[lvl]}`] = ids; }
    for (const k of Object.keys(out)) if (out[k].length < MIN_POOL) delete out[k];
    return out;
  }

  function finish(timeUp = false) {
    if (over) return;
    over = true;
    clearInterval(tick);
    if (history.state?.quiz) history.back(); // drop the guard entry so Back on the result screen leaves at once
    // the quiz ended (time up) while "Leave this quiz?" or "Submit?" was showing: it no longer applies
    for (const d of ['leave-dlg', 'submit-dlg']) { const dlg = $(d) as HTMLDialogElement; if (dlg.open) dlg.close(); }
    if (PAPER) return submitPaper(timeUp);
    if (!answered && $('stem').querySelector('input.cz')) czSubmit(true); // a passage on screen: its typed answers count
    else if (!answered && setUi) setSubmit(true); // a passage set on screen: its picks count, the empty ones as ran out of time
    // unanswered questions count as wrong when time runs out (design section 3)
    const unanswered = quiz.slice(i + (answered ? 1 : 0));
    for (const id of unanswered) { record(id, false); wrongs.push({ q: byId.get(id)!, chose: -1, tag: 'ran_out_of_time' }); }
    const ms = (pausedAt || Date.now()) - startedAt;
    const s: SaveV1 = load();
    const res = finishQuiz(s, {
      mode, sub: mode === 'tier' ? subId : undefined, tier: mode === 'tier' && !POOL ? tier : undefined,
      topics: mode === 'paper' ? paperTopics : undefined,
      score, total: quiz.length, ms, tags: wrongs.map((w) => w.tag),
    }, rewardFor, Date.now(), tierIds(), undefined, { eco, retests: retestsPassed, pools: pools(), poolGroups: poolGroups() });
    if (mode === 'tier') s.last = { sub: subId, tier: POOL ? 'b' : tier };
    save(s);
    results(s, res, timeUp ? `<p>Time's up! ${unanswered.length} question${unanswered.length === 1 ? '' : 's'} not answered.</p>` : '');
  }

  /**
   * Submit a paper: every answer goes through the same answer() as a tier quiz, with retireNew = false (papers never
   * retire new questions), so wrong and blank answers are due again in 1, 3 and 7 days exactly as before.
   */
  function submitPaper(timeUp: boolean) {
    if (!draft || !draftCurrent(draft)) {
      return stop('This paper was already submitted in another tab or window.', '<a href="/paper/">Build another paper</a>');
    }
    const now = Date.now();
    pclock = endPause(pclock, now);
    const s: SaveV1 = load();
    wrongs = []; score = 0;
    let retests = 0;
    quiz.forEach((id, k) => {
      const q = byId.get(id)!, p = picks[k];
      const ok = p === q.answer;
      // retireNew = false: papers never retire new questions. A blank is LEFT_BLANK, or '' (time ran out) when handed in at zero
      if (answer(s, id, ok, now, false, ok ? undefined : p == null ? (timeUp ? undefined : LEFT_BLANK) : q.options[p], shortRetest(id))) retests++;
      if (ok) score++;
      else wrongs.push({ q, chose: p ?? -1, tag: p == null ? (timeUp ? 'ran_out_of_time' : 'blank') : q.explain[p]?.tag ?? 'wrong' });
    });
    clearDraft(); draft = null;
    paperUsed = timeUsed(pclock, startedAt, now);
    const res = finishQuiz(s, {
      mode, topics: paperTopics, score, total: quiz.length, ms: paperUsed, tags: wrongs.map((w) => w.tag),
    }, rewardFor, now, {}, startedAt, { eco, retests, paperTopics: quiz.map((id) => byId.get(id)!.topic ?? '').filter(Boolean) }); // {}: papers never clear tiers (byId holds only paperOk items); startedAt = its open record's ts
    mergeRetests(s, Object.fromEntries(quiz.map((id) => [id, byId.get(id)!.sub])), quiz); // papers never get the pool: only their retests reach the section's rq
    closeStalePapers(s, now);
    save(s);
    const b = blanks(picks);
    results(s, res, timeUp ? `<p>Time's up! The paper was handed in for you${b ? ` with ${b} question${b === 1 ? '' : 's'} blank` : ''}.</p>` : '');
  }

  // Growth-mindset line (encourage.ts): Chinese-subject results show the Chinese line, with the English under it in Term 1
  const isZh = () => mode === 'tier' ? sub.school === 'chinese' : quiz.length > 0 && quiz.every((id) => byId.get(id)?.sub.startsWith('chi-'));
  function cheerHtml(s: SaveV1) {
    const l = lineForLast(s.attempts);
    if (!l) return '';
    if (!isZh()) return `<p class="cheer">${esc(l.en)}</p>`;
    return `<p class="cheer" lang="zh-Hans">${esc(l.zh)}</p>${bilingual() ? `<p class="cheer-en" lang="en">${esc(l.en)}</p>` : ''}`;
  }

  function results(s: SaveV1, res: QuizResult, note: string) {
    $('score').textContent = `${score} / ${quiz.length}`;
    // Crumbs earned sit next to the encouragement line (owner's economy, 20 Nov 2026)
    const gain = res.crumbs ? `<span class="crumb-gain" title="Crumbs: spend them in the Shop">+${res.crumbs} Crumb${res.crumbs === 1 ? '' : 's'} <small>(${balanceOf(s)} in all)</small></span>` : '';
    const head = document.getElementById('crumb-bal'); // the header balance was read when the page loaded
    if (head && head.textContent !== 'Shop') head.textContent = `Shop · ${balanceOf(s)} Crumbs`;
    let html = `<div class="cheer-row">${cheerHtml(s)}${gain}</div>` + note;
    if (mode === 'tier' && POOL) {
      const pp = poolProgress(s, subId), hit = res.newlyCleared.filter((x) => x.sub === subId).map((x) => stopLine(x.tier, x.reward, x.reward ? meta.cards[x.reward.slug]?.name : '')); // worded by what was given: a card, a star, or nothing (the slot was paid before)
      html += `<p class="verdict${hit.length || score >= 0.8 * quiz.length ? ' good' : ''}">${hit.length ? `${hit.join(' and ')}! ` : ''}${poolRightText(pp.counted, pp.total || sub.pool, CLOZE.has(subId))}. Missed ones come back the next day.</p>`;
    } else if (mode === 'tier') {
      const st = tierState(s, subId, tier);
      html += res.autoPromoted ? `<p class="verdict good">Perfect first try! ${{ b: 'Basic', i: 'Intermediate', c: 'Competent' }[tier] ?? 'Tier'} cleared, and the next tier is open.</p>`
        : res.cleared ? `<p class="verdict good">Tier cleared! All ${st.total} questions mastered.</p>`
        : st.cleared ? `<p class="verdict good">This tier is cleared (you keep its card). ${Math.min(st.mastered ?? 0, sub.count[tier] ?? st.total ?? 0)} of ${sub.count[tier] ?? st.total} questions mastered right now; any you missed come back for practice.</p>`
        : `<p class="verdict${res.passed ? ' good' : ''}">${Math.min(st.mastered ?? 0, sub.count[tier] ?? st.total ?? 0)} of ${sub.count[tier] ?? st.total} questions mastered. Missed questions come back until you get them right.</p>`;
    }
    if (mode === 'paper') {
      html += `<p class="ptime">Time used: ${mmss(paperUsed)} of ${mins}:00${pclock.pauseUsed >= 1000 ? ` · paused for ${mmss(pclock.pauseUsed)}` : ''}</p>`;
      const per = new Map<string, [number, number]>();
      quiz.forEach((id) => { const t = byId.get(id)!.topic!; const v = per.get(t) ?? [0, 0]; v[1]++; per.set(t, v); });
      const wrongIds = new Set(wrongs.map((w) => w.q.id));
      quiz.forEach((id) => { if (!wrongIds.has(id)) per.get(byId.get(id)!.topic!)![0]++; });
      html += `<table class="per-topic"><tr><th>Topic</th><th>Score</th></tr>${[...per].map(([t, [c, n]]) =>
        `<tr><td>${esc(meta.topicNames[t] ?? t)}</td><td>${c} / ${n}</td></tr>`).join('')}</table>`;
      if (wrongs.length) {
        const blank = wrongs.some((w) => w.chose < 0);
        html += `<p><button id="rv-start" class="primary" type="button">Review my ${wrongs.length} ${blank ? 'wrong or blank' : 'wrong'} answer${wrongs.length === 1 ? '' : 's'}</button></p>`;
      }
    }
    const won = (r: NonNullable<QuizResult['reward']>, head: string) => {
      const c = meta.cards[r.slug];
      const got = r.dup ? `+1 star${r.crumbs ? ` and +${r.crumbs} Crumbs` : ''}` : 'New card!';
      const why = r.replaces ? `<small>You already had ${esc(meta.cards[r.replaces]?.name ?? r.replaces)}, so here is a new card.</small>` : '';
      return `<a class="won" href="/cookie/${encodeURIComponent(r.slug)}/" style="--rc: var(--r-${esc(c.rarity)})">
        <img src="${esc(c.image)}" alt="" width="96" height="96"><span>${head}<strong>${got}</strong>
        ${esc(c.name)} ${'★'.repeat(r.stars)}${why}</span></a>`;
    };
    for (const cl of res.newlyCleared) {
      if (!cl.reward) continue;
      const pool = !!meta.subs[cl.sub]?.pool;
      html += won(cl.reward, pool ? `<em>${MILESTONE_NAME[cl.tier]} ${stopWord(cl.reward)}: ${esc(meta.subs[cl.sub].name)}!</em>` : '');
    }
    for (const ac of res.achieved ?? []) {
      html += won(ac.reward, ac.kind === 'legendary' ? (ac.subject ? '<em>Subject mastered: every topic cleared at Competent!</em>' : '<em>Top paper result (AL1 or AL2)!</em>')
        : `<em>Topic mastered: every Competent tier cleared!</em>`);
    }
    if (res.goalJustMet) html += '<p class="verdict good">Daily goal met! Your streak grows.</p>';
    { const b = dayBlock(s, mode); if (b) html += `<p>${blockMessage(b, s)}</p>`; }
    $('verdict').innerHTML = html;
    const seenVis = new Set<string>(); // a visual card shows once per set, with the first missed question of that group
    // a typed cloze passage: ONE passage per set with every mistake highlighted (owner, 24 Nov 2026), not a card per blank
    const passages = new Set(wrongs.filter((w) => isWhole(w.q)).map((w) => w.q.group!));
    const passageDone = new Set<string>();
    const passageCard = (g: string) => {
      const fx = passageFix(g), q0 = wrongs.find((w) => w.q.group === g)!.q;
      return `<div class="rev rev-passage"><p class="rev-ph">${ppBadge(q0)}${fx.wrong} to fix in this passage: what you wrote is crossed out, the answer is in bold.</p>`
        + `<p class="stem">${fx.html}</p>${fx.lost}${fx.why}</div>`;
    };
    const cardDone = new Set<string>();
    const items = wrongs.map(({ q, chose, typed }) => {
      if (q.group && setCards.has(q.group)) { // a passage set answered whole: one card for all its mistakes
        if (cardDone.has(q.group)) return '';
        cardDone.add(q.group);
        return setCards.get(q.group)!;
      }
      if (q.group && passages.has(q.group)) { // every mistake of that passage in one card
        if (passageDone.has(q.group)) return '';
        passageDone.add(q.group);
        return passageCard(q.group);
      }
      const showVis = q.visual && !(q.group && seenVis.has(q.group));
      const setAgain = !!q.group && seenVis.has(q.group); // a set's pages in full with its first wrong question only
      if (q.group) seenVis.add(q.group);
      return `<div class="rev"><div class="rev-q">${stemHtml(q, true, false)}</div>${ppFigsHtml(q, setAgain && q.sub !== 'chi-dialogue-mcq')}
       ${showVis ? `<details class="rev-vis"><summary>Show the ${esc(q.visual!.kind)}: ${vfmt(q.visual!.title)}</summary>${visualCard(q.visual!)}</details>` : ''}
       <p>${chose >= 0 ? `You chose ${optionLabel(q, chose)} (${fmt(q.options[chose])}). ` : typed ? `You wrote: ${esc(typed)} ` : PAPER ? 'Left blank. ' : 'Not answered. '}${reasonSaysAnswer(q) ? '' : `Answer: ${answerText(q)}.`}</p>
       ${stepsHtml(q)}</div>`;
    }).join('');
    // a paper steps through these one by one (Review button); the list stays for scanning, folded away
    $('review').innerHTML = !wrongs.length ? '' : PAPER
      ? `<details class="rev-all"><summary>See them all as a list</summary>${items}</details>`
      : `<h3 class="rev-h">Questions to look at again</h3>${items}`;
    const back = mode === 'tier' ? `<a href="/train/${sub.school}/${sub.slug}/">Back to ${esc(sub.name)}</a>`
      : mode === 'paper' ? '<a href="/paper/">Build another paper</a>' : '<a href="/train/">Back to the Schools</a>';
    $('actions').innerHTML = `${back}<a href="/collection/">My cards</a>`;
    show('done');
  }

  $('options').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (b?.classList.contains('cz-submit')) czSubmit();
    else if (b?.classList.contains('set-submit')) setSubmit();
    else if (b?.dataset.sk != null) setPickOption(Number(b.dataset.sk), Number(b.dataset.k), b); // a list set: an option of that question
    else if (b?.classList.contains('typed-check')) chooseTyped();
    else if (b?.dataset.k != null) (PAPER ? choosePaper : choose)(Number(b.dataset.k)); // only an option button picks
  });
  const typedKey = (e: KeyboardEvent) => { // Enter in a typed box checks the answer
    if (e.key === 'Enter' && (e.target as HTMLElement).classList.contains('typed-box')) { e.preventDefault(); if (!e.repeat) chooseTyped(); }
  };
  $('options').addEventListener('keydown', typedKey);
  $('stem').addEventListener('keydown', (e) => { // Enter in a passage blank: tick it, on to the next blank
    const t = e.target as HTMLInputElement;
    if (e.key === 'Enter' && t.classList.contains('cz')) { e.preventDefault(); if (!e.repeat) czTick(t); }
  });
  $('stem').addEventListener('input', (e) => { // a changed answer is no longer ticked: its word comes back
    const t = e.target as HTMLInputElement;
    if (!t.classList.contains('cz')) return;
    delete t.dataset.ticked;
    czWarned = false;
    czStrikes();
  });

  // a held Enter: its repeats must not press Next (focused after Check) and skip the feedback unseen
  $('next').addEventListener('keydown', (e) => { if (e.key === 'Enter' && e.repeat) e.preventDefault(); });
  document.addEventListener('keydown', (e) => {
    // a passage set is answered whole and submitted once: a letter key must never answer one of its questions alone
    if ($('play').hidden || answered || setUi || e.altKey || e.ctrlKey || e.metaKey || (e.target as HTMLElement).closest('input, textarea')) return;
    const k = 'abcdefgh'.indexOf(e.key.toLowerCase()), n = '12345678'.indexOf(e.key);
    const pick = k >= 0 ? k : n;
    const btn = $('options').querySelectorAll<HTMLButtonElement>('button[data-k]')[pick]; // options only, never a typed Check
    if (PAPER) { if (pick >= 0 && btn && !$('qbody').hidden && !(e.target as HTMLElement).closest('dialog, #p-grid, #pbar, #p-paused')) choosePaper(pick); return; }
    if (pick >= 0 && btn && !btn.disabled) choose(pick); // keys past this question's options do nothing
  });
  // papers: move freely, change answers, pause once, submit when ready
  $('p-prev').addEventListener('click', () => goTo(i - 1));
  $('p-next').addEventListener('click', () => goTo(i + 1));
  $('p-sheet').addEventListener('click', () => toggleSheet($('p-grid').hidden));
  $('p-grid').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-j]');
    if (b) { toggleSheet(false); goTo(Number(b.dataset.j)); }
  });
  $('p-pause').addEventListener('click', () => {
    if (over || !canPause(pclock, Date.now())) return;
    pclock = startPause(pclock, Date.now());
    persist();
    if (over) return;
    showPaused(true);
    paperClock();
  });
  $('p-resume').addEventListener('click', () => {
    if (over) return;
    pclock = endPause(pclock, Date.now());
    persist();
    if (over) return;
    showPaused(false);
    paperClock();
  });
  $('p-submit').addEventListener('click', () => {
    if (over) return;
    const b = blanks(picks);
    $('submit-title').textContent = b ? `${b} question${b === 1 ? ' is' : 's are'} blank` : 'Submit your paper?';
    $('submit-msg').textContent = b ? 'Submit anyway? You cannot change your answers after submitting.' : 'You cannot change your answers after submitting.';
    ask('submit-dlg', 'submit-stay', 'submit-go').then((go) => { if (go) finish(); });
  });
  $('verdict').addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('#rv-start')) openReview(); });
  $('rv-prev').addEventListener('click', () => rvStep(-1));
  $('rv-next').addEventListener('click', () => rvStep(1));
  $('rv-done').addEventListener('click', () => { show('done'); $('quiz').scrollIntoView({ block: 'start' }); });
  $('next').addEventListener('click', () => (++i < quiz.length ? render() : finish()));
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.qz-report-send');
    if (b) sendReport(b.closest<HTMLElement>('.qz-report')!);
  });
  // tapping an open blank of the passage asks that blank now; the current question moves to just after it
  $('stem').addEventListener('click', (e) => {
    const t0 = e.target as HTMLElement;
    const chip = t0.closest<HTMLButtonElement>('.chip');
    if (chip) { setPickOption(Number(chip.dataset.seq), Number(chip.dataset.k), chip); return; } // a cloze chip
    const ph = t0.closest<HTMLButtonElement>('.phrase');
    if (ph) { dlgTapPhrase(Number(ph.dataset.p)); return; } // a dialogue phrase: tap it, then tap a blank
    const bl = t0.closest<HTMLButtonElement>('.dblank');
    if (bl) { dlgTapBlank(Number(bl.dataset.seq)); return; }
    const tk = (e.target as HTMLElement).closest('.cz-tick');
    if (tk) { czTick(tk.previousElementSibling as HTMLInputElement); return; } // a passage blank ticked
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.blank-jump');
    if (!b || answered || over) return;
    const j = quiz.indexOf(b.dataset.id ?? '', i + 1);
    if (j < 0) return;
    quiz.splice(i, 0, ...quiz.splice(j, 1));
    render();
  });
  // dialogue: drag a phrase onto a blank (the tap-then-tap path above does the same without dragging)
  $('stem').addEventListener('dragstart', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.phrase');
    if (!b || b.disabled || answered) return e.preventDefault();
    e.dataTransfer?.setData('text/plain', b.dataset.p ?? '');
    if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
  });
  $('stem').addEventListener('dragover', (e) => { if ((e.target as HTMLElement).closest('.dblank') && !answered) e.preventDefault(); });
  $('stem').addEventListener('drop', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.dblank');
    const p = Number(e.dataTransfer?.getData('text/plain'));
    if (!b || answered || !Number.isInteger(p) || !setUi || p < 0 || p >= setUi.phrases.length) return;
    e.preventDefault();
    dlgPlace(p, Number(b.dataset.seq));
  });
  $('start-btn').addEventListener('click', begin);

  // Leaving mid-quiz asks first: links (capture phase, before any other handler), the back button (the guard
  // history entry pushed in begin()) and reload/close (beforeunload, the browser's own wording). In progress =
  // started and not finished; nothing is asked before the first question or on the result screen.
  const inProgress = () => !$('play').hidden && !over;
  let leaving = false;
  function ask(id: string, stay: string, go: string): Promise<boolean> {
    const dlg = $(id) as HTMLDialogElement;
    if (dlg.open) return Promise.resolve(false);
    return new Promise((done) => {
      const end = (ok: boolean) => { dlg.close(); done(ok); };
      $(stay).onclick = () => end(false);
      $(go).onclick = () => end(true);
      dlg.onclose = () => done(false); // closed from outside (the paper ended): a no-op if end() already ran
      dlg.oncancel = (e) => { e.preventDefault(); end(false); }; // Esc means Stay
      dlg.showModal(); // modal: the page behind is inert, so focus stays in the dialog
      $(stay).focus();
    });
  }
  const confirmLeave = () => ask('leave-dlg', 'leave-stay', 'leave-go');
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
    if (!a || !inProgress() || a.target === '_blank' || e.ctrlKey || e.metaKey || e.shiftKey) return;
    e.preventDefault();
    e.stopPropagation();
    confirmLeave().then((go) => { if (go) { leaving = true; location.href = a.href; } });
  }, true);
  // Back pops the guard entry, so we are on the quiz's own entry: Stay pushes the guard again; Leave goes back one
  // more step, or to the Schools page when the quiz was the tab's first page (back() then has nowhere to go).
  window.addEventListener('popstate', () => {
    if (!inProgress()) return;
    confirmLeave().then((go) => {
      if (!go) { if (inProgress()) history.pushState({ quiz: 1 }, ''); return; }
      leaving = true;
      history.back();
      window.setTimeout(() => { location.href = PAPER ? '/paper/' : '/train/'; }, 400); // only runs if back() did not leave the page
    });
  });
  window.addEventListener('beforeunload', (e) => {
    if (inProgress() && !leaving) { e.preventDefault(); e.returnValue = ''; }
  });
  init();
</script>

<style is:global>
  .quiz .options.typed { display: block; }
  .quiz .typed-line { font-size: 1.15rem; line-height: 2.4; margin: 0.4rem 0 0.8rem; }
  .quiz .vc-u u { text-underline-offset: 3px; }
  .quiz .vc-u.ask { font-weight: 700; padding: 0 0.15em; border-radius: 0.3em; background: color-mix(in srgb, currentColor 14%, transparent); }
  .quiz .typed-box { font: inherit; line-height: 1.4; min-width: 9ch; width: min(100%, 26ch); padding: 0.25rem 0.5rem; border: 2px solid var(--cocoa-soft, #8a6a52);
    border-radius: 0.5rem; background: var(--paper, #fff); color: inherit; }
  .quiz .ask-inline { white-space: nowrap; }
  /* keep a focused answer control clear of the sticky word box / phrase bank / paper status bar above it */
  /* clear the pinned word box / phrase bank: --pin-h is their measured height (set when the screen is drawn), 9rem until then */
  .quiz .typed-box, .quiz input.cz, .quiz .chip, .quiz .dblank { scroll-margin-top: calc(var(--pin-h, 9rem) + 1rem); }
  .quiz .opt { scroll-margin-top: 4rem; }
  .quiz .wbox { position: sticky; top: 0; z-index: 2; display: grid; grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr));
    gap: 0.3rem; margin: 0 0 0.8rem; padding: 0.5rem; border: 2px solid var(--ink, #3b2a1f); border-radius: 0.6rem;
    background: var(--card, #fffaf2); font-size: 0.95rem; line-height: 1.3; }
  .quiz .wb-w { text-align: center; padding: 0.15rem 0.2rem; border: 1px solid var(--line, #e3d6c6); border-radius: 0.35rem; }
  .quiz .wb-w.used { text-decoration: line-through; opacity: 0.45; }
  .quiz .cz-tick { font: inherit; font-weight: 700; padding: 0.05rem 0.55rem; margin-left: 0.15rem; border: 0; border-radius: 0.4rem;
    background: var(--berry, #a52a45); color: #fff; cursor: pointer; vertical-align: baseline; }
  .quiz .cz-note { margin-left: 0.3rem; font-size: 0.85rem; white-space: normal; color: var(--berry, #a52a45); }
  .quiz .rev-passage { border: 1px solid var(--line, #e3d6c6); border-radius: 0.75rem; padding: 0.6rem 0.9rem; margin: 0.6rem 0; }
  .quiz .rev-ph { margin: 0 0 0.3rem; font-size: 0.95rem; }
  .quiz mark.cx-fix { background: color-mix(in srgb, var(--berry, #a52a45) 14%, transparent); color: inherit; padding: 0 0.15em; border-radius: 0.3em; }
  .quiz mark.cx-fix del { opacity: 0.75; }
  .quiz .cx-none { font-style: italic; opacity: 0.75; }
  /* passage sets answered whole (lib/passageset.ts): cloze chips, dialogue phrase bank, question list */
  .quiz .options.set { display: block; }
  .quiz .qfig-text { margin: 0.6rem 0; padding: 0.75rem 1rem; border: 1.5px solid var(--crust, #e3d6c6); border-radius: var(--radius-card, 12px); background: var(--cream, #fffaf2);
    font-size: 1.05rem; line-height: 1.55; overflow-wrap: anywhere; }
  .quiz .qfig-text p { margin: 0 0 0.7rem; }
  .quiz .qfig-text p:last-child { margin-bottom: 0; }
  .quiz .set-text { margin: 0.6rem 0; font-size: 1.1rem; line-height: 1.6; overflow-wrap: anywhere; }
  .quiz .stem .chips { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.3rem; max-width: 100%; margin: 0.2rem 0.15rem; vertical-align: middle; white-space: normal; }
  .quiz .chips > b { font-size: 0.85rem; color: var(--cocoa-soft, #8a6a52); }
  .quiz .chip, .quiz .phrase, .quiz .dblank { font: inherit; font-size: 1rem; line-height: 1.3; color: inherit; min-height: 44px; padding: 0.3rem 0.7rem; max-width: 100%;
    border: 2px solid var(--cocoa-soft, #8a6a52); border-radius: 0.6rem; background: var(--paper, #fff); cursor: pointer; overflow-wrap: anywhere; text-align: left; }
  .quiz .chip.sel, .quiz .phrase[aria-pressed="true"] { background: color-mix(in srgb, #2e9e5b 22%, var(--paper, #fff)); border-color: #2e9e5b; font-weight: 700; }
  .quiz .chip.off { opacity: 0.4; background: color-mix(in srgb, currentColor 8%, transparent); border-style: dashed; }
