---
import Base from '../../layouts/Base.astro';
import { paperTopics, PAPER_SCHOOLS } from '../../lib/train';
import { MIXES } from '../../lib/pick';
const SUBJECT = { math: 'Math', english: 'English', science: 'Science', chinese: 'Chinese' } as const;
const schools = PAPER_SCHOOLS.filter((sc) => paperTopics.some((t) => t.school === sc));
---
<Base title="Practice paper · PSLE training" description="Build a Math, English or Science practice test or exam paper from the topics you choose.">
  <section class="wrap paper">
    <p class="crumbs"><a href="/train/">Schools of Mastery</a> › Practice paper</p>
    <h1>Build a practice paper</h1>
    <p class="lede">School tests (Weighted Assessments) and exams (Semestral and Prelim papers) mix several topics. Choose a subject, pick the topics your class has covered, and the paper mixes them from easier to harder, against the clock. Answer every question, change any answer you like, then submit to see your score and go through the ones you missed. Papers count toward today's goal but not toward clearing tiers.</p>
    <div id="resume" class="resume" role="status" hidden>
      <p id="resume-msg"></p>
      <p class="resume-actions"><a id="resume-go" class="primary" href="/quiz/?mode=paper&amp;resume=1">Resume paper</a>
        <button id="resume-discard" type="button">Discard it</button></p>
    </div>
    <p id="resume-note" class="note" role="status" hidden></p>
    <form action="/quiz/" method="get" id="paper-form">
      <input type="hidden" name="mode" value="paper" />
      <input type="hidden" name="topics" id="topics" />
      <fieldset>
        <legend>Subject</legend>
        <div class="subjects">
          {schools.map((sc, i) => (
            <label class="subject"><input type="radio" name="subject" value={sc} checked={i === 0} /> {SUBJECT[sc]}</label>
          ))}
        </div>
      </fieldset>
      <fieldset>
        <legend>Topics</legend>
        <p><button type="button" id="all">Select all</button></p>
        <div class="topics">
          {paperTopics.map((t) => (
            <label class="topic" data-school={t.school}><input type="checkbox" value={t.id} /> {t.name} <span class="n">{t.count} questions</span></label>
          ))}
        </div>
      </fieldset>
      <fieldset>
        <legend>Paper</legend>
        <label>Questions
          <select name="n">
            <option value="10">10</option><option value="20" selected>20</option><option value="30">30</option><option value="40">40</option>
          </select>
        </label>
        {Object.entries(MIXES).map(([k, m], i) => (
          <label class="mix"><input type="radio" name="mix" value={k} checked={i === 0} /> {m.label}</label>
        ))}
      </fieldset>
      <p id="err" class="err" role="alert" hidden>Choose at least one topic.</p>
      <button class="primary" type="submit">Start paper</button>
    </form>
  </section>
</Base>

<script>
  import { load, save } from '../../lib/store';
  import { loadDraft, draftOwner, draftState, tickPaper, discardDraft, paperSubject, paperDate } from '../../lib/paper';
  const form = document.getElementById('paper-form') as HTMLFormElement;
  // one subject per paper: only the chosen subject's topics show, and only they are sent
  const subject = () => form.querySelector<HTMLInputElement>('input[name="subject"]:checked')?.value ?? 'math';
  const boxes = () => [...form.querySelectorAll<HTMLInputElement>('.topic input')]
    .filter((b) => b.closest<HTMLElement>('.topic')!.dataset.school === subject());
  const showSubject = () => form.querySelectorAll<HTMLElement>('.topic').forEach((l) => (l.hidden = l.dataset.school !== subject()));
  form.querySelectorAll('input[name="subject"]').forEach((r) => r.addEventListener('change', showSubject));
  showSubject();
  document.getElementById('all')!.addEventListener('click', () => boxes().forEach((b) => (b.checked = true)));
  // A paper already started (its draft) must be finished or discarded first: Start is held back until then, and the
  // quiz page never lets it replace the paper picked here. This page never discards a draft by itself (another tab
  // may be handing it in): one long past its time is only described, and is put away when it is opened or discarded.
  const $ = (id: string) => document.getElementById(id)!;
  const startBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const owner = draftOwner(load().createdAt);
  function showDraft() {
    const d = loadDraft(owner), now = Date.now();
    startBtn.disabled = false;
    $('resume').hidden = true;
    if (!d) return;
    const subj = paperSubject(d);
    const st = draftState(d.clock, now);
    $('resume-go').hidden = st === 'stale';
    if (st === 'stale') { // Start stays on: starting a new paper puts this one away (unscored) first
      $('resume-msg').textContent = `Your ${subj} paper from ${paperDate(d.ts)} ran out of time a while ago. It will be put away without a score, and nothing from it counts. You can start a new paper.`;
      $('resume').hidden = false;
      return;
    }
    const left = tickPaper(d.clock, now).left;
    $('resume-msg').textContent = st === 'due'
      ? `Your ${subj} paper's time is up. It will be handed in when you open it, and you will see your score.`
      : `You have a ${subj} paper in progress with ${Math.ceil(left / 60000)} minute${left > 60000 ? 's' : ''} left. Finish it, or discard it, before starting a new one.`;
    $('resume-go').textContent = st === 'due' ? 'Hand it in' : 'Resume paper';
    $('resume').hidden = false;
    startBtn.disabled = true;
  }
  showDraft();
  // re-check every 30 s (text and Start only, never a discard): a running paper becomes due, then stale, and Start comes back
  window.setInterval(showDraft, 30_000);
  $('resume-discard').addEventListener('click', () => {
    if (!confirm('Discard this paper? Its answers are thrown away.')) return;
    const d = loadDraft(owner);
    if (d) { const s = load(); discardDraft(s, d); save(s); }
    $('resume-note').textContent = 'The paper was discarded. You can start a new one.';
    $('resume-note').hidden = false;
    showDraft();
  });
  form.addEventListener('submit', (e) => {
    const picked = boxes().filter((b) => b.checked).map((b) => b.value);
    (document.getElementById('topics') as HTMLInputElement).value = picked.join(',');
    document.getElementById('err')!.hidden = picked.length > 0;
    if (!picked.length) e.preventDefault();
  });
</script>

<style>
  .resume { padding: 0.25rem 1rem 0.75rem; border: 2px solid var(--berry); border-radius: var(--radius-card); background: var(--paper); font-weight: 600; }
  .resume-actions { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin: 0; }
  .resume[hidden], .note[hidden] { display: none; }
  .note { color: var(--cocoa-soft); }
  button:disabled { opacity: 0.5; cursor: not-allowed; }
  .resume a[hidden] { display: none; }
  .resume a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 1rem; border-radius: var(--radius-control); text-decoration: none; font-family: var(--font-display); }
  .subjects { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; }
  .topic[hidden] { display: none; }
  .paper { padding-block: 1.5rem 2rem; max-width: 760px; }
  .crumbs { margin: 0; font-size: 0.95rem; color: var(--cocoa-soft); }
  .lede { color: var(--cocoa-soft); }
  fieldset { border: 1.5px solid var(--crust); border-radius: var(--radius-card); background: var(--paper); margin: 1rem 0; padding: 0.75rem 1rem 1rem; }
  legend { font: 600 1.1rem var(--font-display); padding: 0 0.4rem; }
  .topics { display: grid; gap: 0.25rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  label { display: flex; align-items: center; gap: 0.6rem; min-height: 44px; }
  input[type='checkbox'], input[type='radio'] { width: 24px; height: 24px; flex: none; accent-color: var(--berry); margin: 0; }
  .topic { padding: 0.15rem 0.25rem; border-radius: var(--radius-control); }
  .topic:hover { background: var(--plate); }
  .n { color: var(--cocoa-soft); font-size: 0.85rem; }
  select {
    font: inherit; min-height: 44px; padding: 0 2.2rem 0 0.75rem; color: var(--cocoa); background-color: var(--cream);
    border: 1.5px solid var(--crust); border-radius: var(--radius-control); appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--cocoa) 50%), linear-gradient(135deg, var(--cocoa) 50%, transparent 50%);
    background-position: calc(100% - 18px) 50%, calc(100% - 12px) 50%; background-size: 6px 6px; background-repeat: no-repeat;
  }
  button { font: 600 1rem var(--font-display); min-height: 44px; padding: 0.4rem 1rem; border-radius: var(--radius-control); border: 1.5px solid var(--crust); background: var(--cream); color: var(--cocoa); }
  .primary { background: var(--berry); color: var(--berry-ink); border: 0; }
  .err { color: var(--berry); font-weight: 600; }
</style>
