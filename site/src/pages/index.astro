---
// Home base: a map of the cookie kingdom with the Schools of Mastery, the Library (Codex),
// My House (collection) and the Ranking Tower. The map art has no text; every label is HTML.
import Base from '../layouts/Base.astro';
import TodayCard from '../components/TodayCard.astro';
import spots from '../data/home-hotspots.json';
import { cookies } from '../lib/data';

type Box = [number, number, number, number];
const layouts = (['wide', 'tall'] as const).map((k) => ({
  k,
  img: `/home/map-${k}.webp`,
  size: k === 'wide' ? [1920, 1072] : [1080, 1935],
  items: spots.buildings.map((b) => ({ ...b, box: (spots[k] as Record<string, unknown>)[b.id] as Box })),
  companions: spots[k].companions as [number, number][],
}));
// companions: owned cards (filled in by the client), falling back to the 7 commons
const commons = cookies.filter((c) => c.rarity === 'common').map((c) => ({ slug: c.slug, name: c.name, image: c.image }));
const cards = Object.fromEntries(cookies.map((c) => [c.slug, { name: c.name, image: c.image }]));
const data = JSON.stringify({ commons, cards }).replace(/</g, '\\u003c');
---
<Base title="Home · Cookie Codex" description="Your cookie kingdom home base: train in the Schools of Mastery, visit the Library of cards and see your collection.">
  <section class="home">
    {layouts.map((L) => (
      <div class={`scene scene-${L.k}`}>
        <img class="map" src={L.img} width={L.size[0]} height={L.size[1]}
          alt="A cartoon cookie kingdom with seven buildings: the Math, Science, English and Chinese schools, the Library, My House and the Ranking Tower." />
        <div class="banner">
          <p class="welcome">Welcome back<span class="player-sep"></span>!</p>
          <p class="hint">Tap a building to begin.</p>
        </div>
        {L.items.map((b) =>
          b.status === 'open' ? (
            <a class={`spot spot-${b.id} open`} href={b.href}
              style={`left:${b.box[0]}%;top:${b.box[1]}%;width:${b.box[2]}%;height:${b.box[3]}%`}>
              <span class="pill" lang={b.lang}>{b.label}{b.sub && <small>{b.sub}</small>}{b.id === 'math' && <em class="badge">Open</em>}</span>
            </a>
          ) : (
            <span class={`spot spot-${b.id} soon`} role="link" aria-disabled="true" tabindex="0"
              aria-label={`${b.sub ?? b.label}: coming soon`}
              style={`left:${b.box[0]}%;top:${b.box[1]}%;width:${b.box[2]}%;height:${b.box[3]}%`}>
              <span class="pill" lang={b.lang}>{b.label}{b.sub && <small>{b.sub}</small>}<em class="ribbon">Coming soon</em></span>
            </span>
          ))}
        {L.companions.map(([x, y], i) => (
          <a class="buddy" data-i={i} href="/codex/" style={`left:${x}%;top:${y}%;--d:${i * 0.45}s`} aria-label="A cookie friend">
            <img src="" alt="" width="96" height="96" loading="lazy" />
          </a>
        ))}
      </div>
    ))}
    <div class="wrap below"><TodayCard /></div>
  </section>
  <script type="application/json" id="home-data" set:html={data} />
</Base>

<script>
  import { load } from '../lib/store';
  const s = load();
  const { commons, cards } = JSON.parse(document.getElementById('home-data')!.textContent!);
  if (s.settings.playerName) document.querySelector('.player-sep')!.innerHTML = ', <span class="player"></span>';
  document.querySelectorAll('.player').forEach((el) => (el.textContent = s.settings.playerName));
  // cookie friends: the cards the player owns, most recently practised first, topped up with the commons
  const owned = Object.entries(s.cards)
    .sort(([, a], [, b]) => (b.last ?? 0) - (a.last ?? 0))
    .map(([slug]) => ({ slug, ...cards[slug] }))
    .filter((c) => c.image);
  const friends = [...owned, ...commons.filter((c: { slug: string }) => !s.cards[c.slug])];
  document.querySelectorAll<HTMLAnchorElement>('.buddy').forEach((a) => {
    const f = friends[Number(a.dataset.i) % friends.length];
    a.href = `/cookie/${f.slug}/`;
    a.setAttribute('aria-label', f.name);
    const img = a.querySelector('img')!;
    img.src = f.image;
    img.alt = '';
    img.title = f.name;
  });
  // coming-soon buildings: a gentle wiggle instead of navigation
  document.querySelectorAll<HTMLElement>('.spot.soon').forEach((el) => {
    const nudge = () => { el.classList.remove('nudge'); void el.offsetWidth; el.classList.add('nudge'); };
    el.addEventListener('click', nudge);
    el.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); nudge(); } });
  });
</script>

<style is:global>
  /* global: buildings and friends are positioned over the map art */
  .home .scene { position: relative; max-width: 1400px; margin: 0 auto; }
  .home .scene-tall { display: none; }
  @media (max-width: 699px) {
    .home .scene-wide { display: none; }
    .home .scene-tall { display: block; }
  }
  .home .map { display: block; width: 100%; height: auto; }
  .home .banner { position: absolute; left: 0; right: 0; top: 2%; text-align: center; pointer-events: none; }
  .home .welcome {
    margin: 0; font: 600 clamp(1.5rem, 4.2vw, 3.2rem) var(--font-display); color: var(--cocoa);
    text-shadow: 0 2px 0 var(--paper), 0 0 18px var(--paper);
  }
  .home .hint { margin: 0.2rem 0 0; font: 600 clamp(0.9rem, 1.6vw, 1.15rem) var(--font-display); color: var(--cocoa-soft); text-shadow: 0 0 10px var(--paper); }
  .home .spot { position: absolute; display: flex; align-items: flex-end; justify-content: center; border-radius: 18px; text-decoration: none; color: var(--cocoa); cursor: pointer; }
  .home .spot:focus-visible { outline: 3px solid var(--berry); outline-offset: 2px; }
  .home .pill {
    display: inline-flex; flex-direction: column; align-items: center; gap: 0.1rem; margin-bottom: -0.6rem;
    min-height: 44px; justify-content: center; padding: 0.3rem 0.85rem; border-radius: 999px;
    background: var(--paper); border: 2px solid var(--crust); box-shadow: var(--shadow-lift);
    font: 600 clamp(0.85rem, 1.3vw, 1.1rem) var(--font-display); line-height: 1.1; white-space: nowrap;
  }
  .home .pill small { font: 500 0.75em var(--font-body); color: var(--cocoa-soft); }
  .home .spot.open:hover .pill, .home .spot.open:focus-visible .pill { border-color: var(--berry); transform: translateY(-2px); }
  .home .spot-math .pill { border-color: var(--berry); }
  .home .badge, .home .ribbon { font-style: normal; font-size: 0.7em; padding: 0.05rem 0.5rem; border-radius: 999px; }
  .home .badge { background: var(--berry); color: var(--berry-ink); }
  .home .ribbon { background: var(--plate); color: var(--cocoa-soft); }
  .home .spot.soon .pill { opacity: 0.92; }
  .home .spot-math::before {
    content: ''; position: absolute; inset: 10% 15% 20%; border-radius: 50%; pointer-events: none;
    box-shadow: 0 0 40px 12px rgb(255 214 120 / 0.55); animation: glow 2.6s ease-in-out infinite;
  }
  .home .buddy { position: absolute; width: clamp(44px, 6vw, 84px); transform: translate(-50%, -85%); animation: bob 2.4s ease-in-out infinite; animation-delay: var(--d); }
  .home .buddy img { width: 100%; height: auto; filter: drop-shadow(0 4px 3px rgb(58 42 30 / 0.35)); }
  .home .scene-tall .buddy { width: clamp(44px, 13vw, 72px); }
  .home .nudge { animation: nudge 0.45s ease-in-out; }
  .home .below { padding-block: 1rem 0; }
  @keyframes bob { 50% { transform: translate(-50%, -95%); } }
  @keyframes glow { 50% { box-shadow: 0 0 56px 18px rgb(255 214 120 / 0.75); } }
  @keyframes nudge { 25% { transform: rotate(-2deg); } 75% { transform: rotate(2deg); } }
  @media (prefers-reduced-motion: reduce) {
    .home .buddy, .home .spot-math::before, .home .nudge { animation: none; }
  }
</style>
