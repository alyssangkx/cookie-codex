---
import Base from '../../layouts/Base.astro';
import { subs as allSubs, hasContent, cookieBySlug, SCHOOLS, banksHash, listGroup, subSlug } from '../../lib/train';

const data = {
  total: cookieBySlug.size,
  // every subject's sub-topics in the order the training pages show them, with how many questions each has (a past-paper
  // pool counts all its questions); the question lists look questions up in the bank files
  subs: allSubs.map((s) => ({ id: s.id, name: s.name, school: s.school, topic: listGroup(s).topicName, file: s.file,
    content: hasContent(s), avail: s.poolAll ?? s.pool ?? s.count.b + s.count.i + s.count.c, href: `/train/${s.school}/${subSlug(s.id)}/` })),
  schools: SCHOOLS.map((s) => ({ id: s.id, name: s.name })),
  cards: Object.fromEntries([...cookieBySlug].map(([slug, c]) => [slug, c.name])), // card names for the Crumbs ledger
  banks: banksHash, // the retest queue hides only states parked by these banks (store.ts inReview), as the child's gates do
};
---
<Base title="Parent view: Cookie Codex" description="Progress, mistakes, retests and settings for the PSLE training.">
  <section class="wrap parent-page" id="pp-root" data-tab="prog">
    <h1>Parent view</h1>
    <div class="pp-tabs" role="tablist" aria-label="Parent view">
      <button type="button" role="tab" id="tab-prog" aria-selected="true" aria-controls="content">Child progress</button>
      <button type="button" role="tab" id="tab-fam" aria-selected="false" aria-controls="family">Family and accounts</button>
      <a id="tab-admin" class="pp-tab-link" href="/admin/" hidden>Admin functions</a>
    </div>

    <p class="note" id="who-note">Signed in as the grown-up. This page shows the progress saved on this device (the mistakes list can show another child's).</p>

    <div id="fam-deleted" class="panel" hidden>
      <h2>This account is being deleted</h2>
      <p class="note" id="fam-deleted-note"></p>
      <button type="button" class="btn" id="fam-restore">Restore my account</button>
      <p class="err" id="fam-deleted-err" role="alert"></p>
    </div>

    <section id="family" class="panel" aria-labelledby="h-fam" hidden>
      <h2 id="h-fam">Your family</h2>
      <p class="note">Each child signs in at <b>Who's playing?</b> on any device with their username and PIN.</p>
      <h3>Children</h3>
      <div id="fam-kids"></div>
      <h3 id="h-add">Add a child</h3>
      <form id="fam-add" autocomplete="off" aria-labelledby="h-add">
        <label for="add-name">Username (letters and numbers, e.g. Emma or Emma2)</label>
        <input id="add-name" type="text" maxlength="20" autocomplete="off" />
        <label for="add-pin">4-digit PIN</label>
        <input id="add-pin" class="pin" type="password" inputmode="numeric" pattern="[0-9]*" maxlength="4" autocomplete="new-password" />
        <label for="add-pin2">Type the PIN again</label>
        <input id="add-pin2" class="pin" type="password" inputmode="numeric" pattern="[0-9]*" maxlength="4" autocomplete="new-password" />
        <button type="submit" class="btn">Add child</button>
      </form>
      <p class="saved" id="fam-msg" role="status" aria-live="polite"></p>
      <p class="err" id="fam-err" role="alert"></p>
      <details class="fam-more">
        <summary>Sign-in safety and your account</summary>
        <h3>Authenticator app (optional)</h3>
        <p class="note" id="mfa-note">Adds a 6-digit code from an app such as Google Authenticator when you sign in.</p>
        <button type="button" class="btn" id="mfa-start">Add an authenticator app</button>
        <div id="mfa-box" hidden>
          <img id="mfa-qr" alt="QR code to scan with the authenticator app" width="180" height="180" />
          <p class="note">Or type this key: <code id="mfa-secret"></code></p>
          <label for="mfa-code">Code from the app</label>
          <input id="mfa-code" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="one-time-code" />
          <button type="button" class="btn" id="mfa-verify">Turn it on</button>
        </div>
        <h3>Delete account and all data</h3>
        <p class="note">Removes you and every child. Your children can no longer sign in; everything is erased after 7 days. Sign in within 7 days to undo. <a href="/privacy/">Privacy notice</a></p>
        <label for="del-email">Type your email to confirm</label>
        <input id="del-email" type="email" autocomplete="off" />
        <button type="button" class="btn danger" id="del-account">Delete account and all data</button>
      </details>
    </section>

    <noscript><p class="note">This page needs JavaScript to read the saved progress.</p></noscript>

    <div id="content" hidden>
      <p class="fields" id="kid-pick" hidden><label for="kid-who">Showing</label>
        <select id="kid-who"></select></p>
      <section class="panel" aria-labelledby="h-mast"><h2 id="h-mast">Subjects</h2>
        <p class="note">Tap a subject for its topics and every question tried. Tap the wrong count to review those questions, put one back for a retest now, or send up to 10 as a revision test. A tier clears when every question in it is mastered (right first time, or right after its 1, 3 and 7 day retests).</p>
        <div id="mastery"></div></section>
      <section class="panel" aria-labelledby="h-sum"><h2 id="h-sum">Summary</h2><div id="summary" class="stats"></div></section>
      <section class="panel" aria-labelledby="h-days"><h2 id="h-days">Last 14 days</h2><div id="days" class="scroll"></div></section>
      <section class="panel" aria-labelledby="h-mis"><h2 id="h-mis">Most common mistakes</h2><div id="mistakes"></div></section>
      <section class="panel" aria-labelledby="h-wrong"><h2 id="h-wrong">Mistakes</h2>
        <p class="note">Every question answered wrong, past-paper ones included, by subject and sub-topic, with the right answer and the answer picked last time (recorded from 19 Nov 2026).</p>
        <p class="fields" id="wrong-pick" hidden><label for="wrong-who">Show for</label>
          <select id="wrong-who"><option value="">This device</option></select></p>
        <div id="wrong"></div></section>
      <section class="panel" aria-labelledby="h-ret"><h2 id="h-ret">Retest queue</h2><div id="retest"></div></section>
      <section class="panel" aria-labelledby="h-crumbs"><h2 id="h-crumbs">Crumbs and the shop</h2>
        <p class="note">Crumbs are earned by finishing quizzes (more for higher scores), passing retests, meeting the daily goal and streak weeks, and are spent on cards in the shop at fixed prices. Nothing is random and no real money is involved. This page only shows them: Crumbs can't be added or removed here. Crumbs from the unlimited test account are marked "test" and left out of the totals.</p>
        <div id="crumbs"></div></section>
      <section class="panel" aria-labelledby="h-set"><h2 id="h-set">Settings</h2>
        <div class="fields">
          <label for="cap">Daily training time: <output id="cap-out"></output></label>
          <input id="cap" type="range" min="45" max="180" step="15" />
          <p class="note" id="cap-note"></p>
          <label for="goal">Daily goal (quizzes)</label>
          <input id="goal" type="number" min="1" max="5" step="1" inputmode="numeric" />
          <label class="check" for="extra"><input id="extra" type="checkbox" /> Extra time (×1.5, for accessibility)</label>
          <label for="psle">PSLE date</label>
          <input id="psle" type="date" />
          <p class="note" id="weeks"></p>
        </div>
        <p class="saved" id="saved" role="status" aria-live="polite"></p>
      </section>
      <section class="panel" id="bak-panel" aria-labelledby="h-bak"><h2 id="h-bak">Backup</h2>
        <p class="note">A save code holds all progress. Keep a copy in case this browser is cleared.</p>
        <div class="row">
          <button type="button" class="btn" id="copy">Copy save code</button>
          <button type="button" class="btn" id="download">Download save code</button>
        </div>
        <p class="saved" id="bak-msg" role="status" aria-live="polite"></p>
        <label for="import">Import save code</label>
        <textarea id="import" rows="4" spellcheck="false" placeholder="CCX1:..."></textarea>
        <button type="button" class="btn" id="do-import">Import</button>
        <p class="err" id="imp-err" role="alert"></p>
      </section>
    </div>
  </section>
  <script type="application/json" id="pdata" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
</Base>

<style is:global>
  .parent-page { padding-block: 1.5rem 3rem; }
  .parent-page .panel { background: var(--paper); border: 1.5px solid var(--crust); border-radius: var(--radius-card); padding: 1rem; margin-top: 1rem; }
  .parent-page h2 { font-size: 1.3rem; margin-bottom: 0.6rem; }
  .parent-page h3 { font-size: 1.1rem; margin: 1.2rem 0 0.4rem; }
  .parent-page .note { color: var(--cocoa-soft); font-size: 0.95rem; margin: 0.3rem 0 0.8rem; }
  .parent-page label { display: block; font-family: var(--font-display); font-weight: 500; margin-top: 0.7rem; }
  .parent-page label.check { display: flex; align-items: center; gap: 0.6rem; min-height: 44px; }
  .parent-page input[type='checkbox'] { width: 24px; height: 24px; accent-color: var(--berry); }
  .parent-page input:not([type='checkbox']), .parent-page textarea {
    display: block; width: 100%; max-width: 22rem; min-height: 44px; padding: 0.4rem 0.7rem; margin-top: 0.25rem;
    font: inherit; color: var(--cocoa); background: #fff; border: 1.5px solid var(--crust); border-radius: var(--radius-control);
  }
  .parent-page textarea { max-width: 100%; font-family: monospace; font-size: 0.85rem; }
  .parent-page .btn {
    min-height: 44px; padding: 0 1.1rem; margin-top: 0.8rem; border: 0; border-radius: var(--radius-control);
    background: var(--cocoa); color: var(--cream); font: 500 1rem var(--font-display);
  }
  .parent-page .btn:active { background: var(--berry); }
  .parent-page .row { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .parent-page .err { color: var(--berry); min-height: 1.4em; margin: 0.5rem 0 0; }
  .parent-page .saved { color: #1f6b3a; min-height: 1.4em; margin: 0.5rem 0 0; font-weight: 600; }
  .parent-page .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.6rem; }
  .parent-page .stat { background: var(--cream); border-radius: var(--radius-control); padding: 0.6rem 0.8rem; }
  .parent-page .stat b { display: block; font: 600 1.4rem var(--font-display); }
  .parent-page .stat span { color: var(--cocoa-soft); font-size: 0.9rem; }
  .parent-page .scroll { overflow-x: auto; }
  .parent-page table { border-collapse: collapse; width: 100%; font-size: 0.95rem; }
  .parent-page .pc-n { text-align: right; font-variant-numeric: tabular-nums; }
  .parent-page .pc-test td { color: var(--cocoa-soft); }
  .parent-page .pc-buys { margin: 0.25rem 0 0; padding-left: 1.2rem; }
  .parent-page th, .parent-page td { text-align: left; padding: 0.45rem 0.6rem; border-bottom: 1px solid var(--crust); vertical-align: top; }
  .parent-page th { font-family: var(--font-display); font-weight: 500; }
  .parent-page .topic { margin-top: 1rem; }
  .parent-page .topic h3 { margin: 0 0 0.3rem; }
  .parent-page .sub { padding: 0.5rem 0; border-top: 1px solid var(--crust); }
  .parent-page .sub.off { opacity: 0.55; }
  .parent-page .sub .nm { font-weight: 600; }
  .parent-page ol.list { padding-left: 1.2rem; margin: 0; }
  .parent-page ol.list li { margin-bottom: 0.7rem; }
  .parent-page .meta { display: block; color: var(--cocoa-soft); font-size: 0.88rem; }
  .parent-page .due-late { color: var(--berry); font-weight: 600; }
  .parent-page .wq-subject { border-top: 1px solid var(--crust); padding: 0.4rem 0; }
  .parent-page .wq-subject > summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; gap: 0.3rem; }
  .parent-page .wq-sub { font-size: 1rem; margin: 0.8rem 0 0.4rem; }
  .parent-page .tq-n { color: var(--cocoa-soft); font-size: 0.9rem; }
  .parent-page { --ok: #1f6b3a; }
  .parent-page[data-tab='prog'] #family, .parent-page[data-tab='fam'] #content, .parent-page[data-tab='fam'] #fam-deleted { display: none; }
  .parent-page .pp-tabs { display: flex; gap: 0.4rem; border-bottom: 1.5px solid var(--crust); margin-top: 0.8rem; flex-wrap: wrap; }
  .parent-page .pp-tabs button, .parent-page .pp-tab-link { min-height: 44px; padding: 0 1rem; border: 1.5px solid var(--crust); border-bottom: 0;
    border-radius: 10px 10px 0 0; background: var(--cream); color: var(--cocoa); font: 600 1rem var(--font-display); display: inline-flex; align-items: center; text-decoration: none; }
  .parent-page .pp-tabs button[aria-selected='true'] { background: var(--paper); color: var(--berry); }
  .parent-page .dash { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0.7rem; }
  .parent-page .dcard { background: var(--cream); border: 1.5px solid var(--crust); border-radius: var(--radius-card); padding: 0.7rem 0.8rem; }
  .parent-page .dname { background: none; border: 0; padding: 0; min-height: 44px; font: 600 1.25rem var(--font-display); color: var(--berry); cursor: pointer; }
  .parent-page .drow { display: flex; align-items: center; gap: 0.9rem; }
  .parent-page .pie { flex: none; width: 76px; height: 76px; border-radius: 50%; }
  .parent-page .dcard dl { margin: 0; display: grid; gap: 0.1rem; }
  .parent-page .dcard dl div { display: flex; gap: 0.5rem; align-items: baseline; }
  .parent-page .dcard dt { color: var(--cocoa-soft); font-size: 0.9rem; min-width: 5.5rem; }
  .parent-page .dcard dd { margin: 0; font: 600 1.1rem var(--font-display); }
  .parent-page .dwrong { min-height: 36px; min-width: 44px; padding: 0 0.6rem; border: 1.5px solid var(--berry); border-radius: var(--radius-control);
    background: #fff; color: var(--berry); font: 600 1.05rem var(--font-display); cursor: pointer; }
  .parent-page .legend { font-size: 0.82rem; color: var(--cocoa-soft); margin: 0.4rem 0 0; }
  .parent-page .legend .k { display: inline-block; width: 0.75em; height: 0.75em; border-radius: 2px; margin: 0 0.15rem 0 0.4rem; vertical-align: -0.05em; }
  .parent-page .legend .k:first-child { margin-left: 0; }
  .parent-page .k.ok { background: var(--ok); } .parent-page .k.mid { background: var(--r-ancient); } .parent-page .k.bad { background: var(--berry); }
  .parent-page #dash-detail:not(:empty) { margin-top: 1rem; border-top: 1.5px solid var(--crust); padding-top: 0.6rem; }
  .parent-page .dhead { display: flex; justify-content: space-between; align-items: center; gap: 0.6rem; }
  .parent-page .dhead h3 { margin: 0; }
  .parent-page .btn.small { min-height: 36px; padding: 0 0.8rem; margin-top: 0.3rem; font-size: 0.92rem; }
  .parent-page .tq-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.4rem 0.6rem; }
  @media (min-width: 900px) { .parent-page .tq-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .parent-page .tq-card { display: flex; align-items: center; gap: 0.6rem; min-height: 52px; padding: 0.35rem 0.6rem; border: 1.5px solid var(--crust); border-radius: 10px; background: var(--cream); }
  .parent-page .tq-card.off { opacity: 0.55; }
  .parent-page .tq-main { flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.3; }
  .parent-page .tq-main .nm, .parent-page .tq-main .tq-n { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .parent-page .tq-main .nm { font-weight: 600; }
  .parent-page .tq-main .tq-n { font-size: 0.82rem; }
  .parent-page .tq-bars { flex: none; width: 110px; height: 10px; border-radius: 3px; overflow: hidden; }
  .parent-page .tq-bars .all, .parent-page .k.all { fill: #c9b393; background: #c9b393; }
  .parent-page .tq-bars .bad { fill: var(--berry); } .parent-page .tq-bars .mid { fill: var(--r-ancient); } .parent-page .tq-bars .ok { fill: var(--ok); }
  .parent-page .tq-card .btn.small { flex: none; margin-top: 0; }
  .parent-page .btn.ghost { background: #fff; color: var(--cocoa); border: 1.5px solid var(--crust); }
  .parent-page .btn.on { background: var(--berry); }
  .parent-page .btn.done { background: var(--ok); }
  .parent-page .wq-stem { white-space: pre-line; }
  .parent-page .wq-fig { margin: 0.4rem 0; max-width: 32rem; }
  .parent-page .wq-fig svg, .parent-page .wq-fig img { max-width: 100%; height: auto; }
  .parent-page .btn.danger { background: #fff; color: var(--berry); border: 1.5px solid var(--berry); }
  .parent-page .kid { border-top: 1px dashed var(--crust); padding: 0.7rem 0; }
  .parent-page .kid .row { align-items: center; margin-top: 0.3rem; }
  .parent-page .kid .row input, .parent-page .kid .row .btn { margin-top: 0; }
  .parent-page input.pin { max-width: 8rem; letter-spacing: 0.3em; }
  .parent-page .fam-more { margin-top: 1rem; }
  .parent-page .fam-more > summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; font-weight: 600; }

</style>

<script>
  import { load, save, migrate, SCHEMA, REVISION_MAX, ASSIGN_MAX, assignedPending, finishedOn, backupLocal, liveStreak, today, dayKey, quizzesToday, DAILY_QUIZ_CAP, QUIZ_CAP_ON, exportCode, importCode, LEFT_BLANK, inReview } from '../../lib/store';
  import type { SaveV1, Tier } from '../../lib/store';
  import { cleanSave } from '../../lib/cleansave';
  import { ppMode, isPpId } from '../../lib/pastpaper';
    import { grownup as supabase, supabase as player, callFunction, callParentApi, roleOf } from '../../lib/supabase';

  interface PSub { id: string; name: string; school: string; topic: string; file: string | null; content: boolean; avail: number; href: string }
  const P = JSON.parse(document.getElementById('pdata')!.textContent!) as
    { total: number; min: number; subs: PSub[]; schools: { id: string; name: string }[]; cards: Record<string, string>; banks: string };
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (t: unknown) => String(t).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const DAY = 86_400_000;

  // A save is written by the child's browser and synced, so this page renders only a cleanSave() copy (well-formed,
  // numbers finite and in range). NEVER save(s): s is the cleaned copy. Writes reload the raw save first (see commit()).
  // ponytail: cleaned on display pages only (parent, My House); validate in sync hydrate if more pages render saves.
  let s: SaveV1 = cleanSave(load());

  // ------------------------------------------------------------ helpers
  const TAG_LABELS: Record<string, string> = {
    miscounted_units: 'Counted the units wrongly',
    reversed_order: 'Wrote the ratio the wrong way round',
    gave_other_person: 'Answered for the wrong person',
    took_second_fraction_of_total: 'Took a fraction of the total instead of the remainder',
    ran_out_of_time: 'Ran out of time',
    blank: 'Left blank on a paper',
  };
  const humanise = (t: string) => TAG_LABELS[t] ?? (t.replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase()));
  const subName = new Map(P.subs.map((x) => [x.id, x.name]));
  const fmtDate = (t: number) => new Date(t).toLocaleDateString(undefined, { day: 'numeric', month: 'short' });

  // ------------------------------------------------------------ sections
  function renderSummary() {
    const t = today(s), st = s.streak;
    const items: [string, string][] = [
      [`${t.min} / ${s.settings.dailyCapMin} min`, 'Today vs time limit'],
      QUIZ_CAP_ON ? [`${quizzesToday(s)} / ${DAILY_QUIZ_CAP} quizzes`, 'Today vs quiz limit (Daily Review not counted)']
        : [`${quizzesToday(s)} quizzes`, 'Today (no quiz limit for now; Daily Review not counted)'],
      [`${t.quizzes} / ${s.settings.dailyGoalQuizzes} quizzes`, 'Today vs daily goal'],
      [`${liveStreak(s)} week${liveStreak(s) === 1 ? '' : 's'}`, 'Streak (weeks with 4+ goal days)'],
      [`${st.best} week${st.best === 1 ? '' : 's'}`, 'Best streak'],
      [`${st.studyDays}`, 'Total study days'],
      [`${Object.keys(s.cards).length} of ${P.total}`, 'Cards owned'],
    ];
    $('summary').innerHTML = items.map(([b, l]) => `<div class="stat"><b>${esc(b)}</b><span>${esc(l)}</span></div>`).join('');
  }

  const WHY: Record<string, string> = {
    quiz: 'Tier quiz finished', review: 'Daily Review finished', paper: 'WA/SA paper finished', retest: 'Retests passed',
    goal: 'Daily goal met', week: 'Streak week', bonus: 'Bonus (no new card left)', buy: 'Bought a card', star: 'Bought a star',
  };
  /** The Crumbs ledger (last 50 entries) and every purchase, read-only (owner's answer 7a). */
  function renderCrumbs() {
    const c = s.crumbs;
    if (!c) { $('crumbs').innerHTML = '<p class="note">No Crumbs earned yet.</p>'; return; }
    const card = (slug?: string) => (slug ? esc(P.cards[slug] ?? slug) : '');
    const realSpent = c.buys.filter((b) => !b.test).reduce((n, b) => n + b.price, 0);
    const stats: [string, string][] = [
      [`${c.bal}`, 'Balance now'],
      [`${Math.max(0, c.earned - c.test)}`, 'Earned in all (not counting test)'],
      [`${realSpent}`, 'Spent in the shop (not counting test)'],
      [`${c.buys.filter((b) => !b.test).length}`, 'Purchases'],
    ];
    if (c.test) stats.push([`${c.test}`, 'Earned on the test account']);
    const rows = [...c.log].reverse().map((e) => `<tr${e.test ? ' class="pc-test"' : ''}><td>${esc(new Date(e.ts).toLocaleString(undefined, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }))}</td>
      <td class="pc-n">${e.n > 0 ? '+' : ''}${esc(e.n)}</td><td>${esc(WHY[e.why] ?? e.why)}${e.slug ? `: ${card(e.slug)}` : ''}${e.test ? ' <small>(test)</small>' : ''}</td><td class="pc-n">${esc(e.bal)}</td></tr>`).join('');
    const buys = [...c.buys].reverse().map((b) => `<li>${esc(fmtDate(b.ts))}: ${b.kind === 'card' ? 'card' : `star ${esc(b.stars)} for`} ${card(b.slug)}, ${esc(b.price)} Crumbs${b.test ? ' <small>(test)</small>' : ''}</li>`).join('');
    $('crumbs').innerHTML = `<div class="stats">${stats.map(([b, l]) => `<div class="stat"><b>${esc(b)}</b><span>${esc(l)}</span></div>`).join('')}</div>
      <h3>Ledger (last ${c.log.length} entries)</h3>
      <div class="scroll"><table><thead><tr><th scope="col">When</th><th scope="col">Crumbs</th><th scope="col">What for</th><th scope="col">Balance</th></tr></thead><tbody>${rows}</tbody></table></div>
      <h3>Purchases</h3>${buys ? `<ul class="pc-buys">${buys}</ul>` : '<p class="note">Nothing bought yet.</p>'}`;
  }

  function renderDays() {
    let rows = '';
    const now = new Date();
    for (let i = 0; i < 14; i++) {
      const key = dayKey(new Date(now.getFullYear(), now.getMonth(), now.getDate() - i).getTime());
      const d = s.days[key];
      const acc = d && d.total ? Math.round((100 * d.correct) / d.total) + '%' : '–';
      rows += `<tr><td>${esc(key)}</td><td>${d?.quizzes ?? 0}</td><td>${d?.min ?? 0}</td><td>${acc}</td></tr>`;
    }
    $('days').innerHTML = `<table><thead><tr><th>Date</th><th>Quizzes</th><th>Minutes</th><th>Accuracy</th></tr></thead><tbody>${rows}</tbody></table>`;
  }

  function renderMistakes() {
    const counts = new Map<string, { n: number; subs: Map<string, number> }>();
    for (const a of s.attempts) for (const tag of a.tags ?? []) {
      const e = counts.get(tag) ?? { n: 0, subs: new Map() };
      e.n++;
      if (a.sub) e.subs.set(a.sub, (e.subs.get(a.sub) ?? 0) + 1);
      counts.set(tag, e);
    }
    const top = [...counts].sort((a, b) => b[1].n - a[1].n).slice(0, 8);
    if (!top.length) { $('mistakes').innerHTML = '<p class="note">No mistakes recorded yet.</p>'; return; }
    $('mistakes').innerHTML = '<ol class="list">' + top.map(([tag, e]) => {
      const from = [...e.subs].sort((a, b) => b[1] - a[1]).map(([id]) => subName.get(id) ?? id).join(', ');
      return `<li><b>${esc(humanise(tag))}</b> (${e.n} time${e.n > 1 ? 's' : ''})<span class="meta">${from ? 'From: ' + esc(from) : ''}</span></li>`;
    }).join('') + '</ol>';
  }

  type QState = SaveV1['questions'][string];
  type BQ = { id: string; sub: string; stem: string; options: string[]; answer: number; group?: string; seq?: number;
    figure?: string | { img: string; alt: string; labels?: { text: string }[] }; visual?: { kind: string; title: string };
    pp?: string[] }; // pp: a past-paper question's exam-page pictures (signed URLs)
  type PpRow = { id: string; subtopic: string; stem: string; options: string[]; answer: number; figures: { path: string }[] | null; grp: string | null; seq: number | null };
  let bankLoad: Promise<Map<string, BQ>> | null = null;
  let bankMissing = 0; // question files that failed to load: their questions cannot be shown
  let ppMissing = false; // the past-paper questions could not load
  const missingNote = () => (bankMissing ? `<p class="note">Some question files could not load (offline?), so their questions are not shown. Reload to try again.</p>` : '')
    + (ppMissing ? `<p class="note">The past-paper questions could not load, so they are not shown. Reload to try again.</p>` : '');
  function banks() {
    return (bankLoad ??= (async () => {
      const qs = new Map<string, BQ>();
      const files = [...new Set(P.subs.flatMap((x) => (x.file ? [x.file] : [])))];
      await Promise.all(files.map(async (f) => {
        try {
          const r = await fetch(`/data/quiz/${f}.json`);
          if (!r.ok) { bankMissing++; return; }
          for (const q of (await r.json()) as BQ[]) qs.set(q.id, q);
        } catch { bankMissing++; }
      }));
      return qs;
    })());
  }
  /** Every question this page can show for a child: the site's banks plus the past-paper questions the server gave that
   *  child (pp_seen, migration 012; it never trusts ids from the save) with their pictures. One load per child. */
  // ponytail: one load per child, again after 50 minutes (the picture URLs are signed for 60); a failed load is retried next time
  const looked = new Map<string, { at: number; p: Promise<Map<string, BQ>> }>();
  function lookup(childId: string | null) {
    const key = childId ?? '';
    if (Date.now() - (looked.get(key)?.at ?? 0) > 50 * 60_000) { const entry = { at: Date.now(), p: (async () => {
      const qs = new Map(await banks());
      if (!childId) return qs;
      try {
        const r = await supabase.rpc('pp_seen', { p_child: childId });
        if (r.error) throw r.error;
        const rows = (r.data ?? []) as PpRow[];
        const paths = [...new Set(rows.flatMap((x) => (x.figures ?? []).map((f) => f.path)))];
        const urls = new Map<string, string>();
        for (let i = 0; i < paths.length; i += 100) {
          const u = await supabase.storage.from('pp-figures').createSignedUrls(paths.slice(i, i + 100), 3600);
          for (const x of u.data ?? []) if (x.path && x.signedUrl) urls.set(x.path, x.signedUrl);
        }
        for (const x of rows) qs.set(x.id, { id: x.id, sub: x.subtopic, stem: x.stem, options: x.options, answer: x.answer,
          group: x.grp ?? undefined, seq: x.seq ?? undefined, pp: (x.figures ?? []).flatMap((f) => (urls.has(f.path) ? [urls.get(f.path)!] : [])) });
        ppMissing = false;
      } catch { ppMissing = true; if (looked.get(key) === entry) looked.delete(key); }
      return qs;
    })() }; looked.set(key, entry); }
    return looked.get(key)!.p;
  }
  /** The child whose questions are shown: the picked child (parent), or this device's player (admin). */
  let viewId: string | null = null;

  const bold = (t: string) => esc(t).replace(/\*\*([^*\n]+?)\*\*/g, '<strong>$1</strong>');
  // figures: Math SVG strings come from our own build scripts (as on the quiz page); Science line art is shown as the
  // image with its labels listed underneath; a past-paper question shows its exam-page pictures; a visual text is named
  const figHtml = (q: BQ) => {
    if (q.pp?.length) return `<div class="wq-fig">${q.pp.map((u) => `<img src="${esc(u)}" alt="Exam page for this question" loading="lazy">`).join('')}</div>`;
    const f = q.figure;
    if (typeof f === 'string') return `<div class="wq-fig">${f}</div>`;
    if (f && /^\/science\/[\w.-]+\.webp$/.test(f.img)) return `<div class="wq-fig"><img src="${esc(f.img)}" alt="${esc(f.alt)}" loading="lazy">`
      + `${f.labels?.length ? `<span class="meta">Labels: ${esc(f.labels.map((l) => l.text).join(', '))}</span>` : ''}</div>`;
    return q.visual ? `<span class="meta">With a ${esc(q.visual.kind)}: ${esc(q.visual.title)}</span>` : '';
  };
  /** One question as tried: stem, picture (or "same page" when the question above showed the same one), the right answer,
   *  the answer picked on the last wrong try, and where it stands now. */
  function qItem(bq: BQ, q: QState, now: number, samePage = false, extra = '') {
    const status = q.s > 0 ? (q.due <= now ? '<span class="due-late">retest due now</span>' : `retest due ${esc(fmtDate(q.due))}`)
      : q.w > 0 ? 'answered right since (mastered)' : 'right first time (mastered)';
    const right = `Right answer: <b>${bold(bq.options[bq.answer] ?? '')}</b>`;
    const theirs = q.w === 0 ? '' : q.a == null ? 'Their answer: not recorded (before 19 Nov 2026)'
      : q.a === '' ? 'Their answer: none (time ran out)' : q.a === LEFT_BLANK ? 'Their answer: left blank' : `Their answer: ${bold(q.a)}`;
    const fig = samePage ? '<span class="meta">Same exam page as the question above.</span>' : figHtml(bq);
    return `<li><div class="wq-stem">${bold(bq.stem)}</div>${fig}<span class="meta">${[right, theirs].filter(Boolean).join(' · ')}</span>`
      + `<span class="meta">${q.w ? `Wrong ${q.w} time${q.w === 1 ? '' : 's'} · ` : ''}${status}</span>${extra}</li>`;
  }
  /** A list of tried questions, sets kept together in passage order, with a repeated exam page shown once. */
  function qList(list: [BQ, QState][], now: number, act?: (bq: BQ, q: QState) => string) {
    const k = (b: BQ) => b.group ?? '~' + b.id;
    let last = '';
    return '<ol class="list">' + [...list].sort((a, b) => k(a[0]).localeCompare(k(b[0])) || (a[0].seq ?? 0) - (b[0].seq ?? 0)).map(([bq, q]) => {
      const page = bq.pp?.length ? bq.pp.map((u) => u.split('?')[0]).join('|') : '';
      const same = !!page && page === last; last = page;
      return qItem(bq, q, now, same, act?.(bq, q) ?? '');
    }).join('') + '</ol>';
  }

  const plural = (n: number, w: string) => `${n.toLocaleString()} ${w}${n === 1 ? '' : 's'}`;
  // ------------------------------------------------------------ the subject dashboard
  // One card per subject: questions on the site, how many were tried (a pie of how they stand), and the wrong count.
  // The card opens its topic breakdown; the wrong count opens those questions, where a parent can put one back for a
  // retest at once or send up to 10 as a revision test (the child's next Daily Review asks them first).
  let dash: { qs: Map<string, BQ>; tried: Map<string, [BQ, QState][]> } | null = null;
  let detail: { kind: 'topics' | 'wrong'; school: string } | null = null;
  // a question Daily Review can ask (that is where Retest now and the revision test land): every generated question in the
  // banks (Daily Review merges a pool sub-topic's generated items back in); a past-paper one only while its sub-topic's
  // past-paper switch is on (Daily Review fetches only switched sub-topics)
  const askable = (bq: BQ) => !isPpId(bq.id) || ppMode(bq.sub) !== null;
  const subjectTried = (school: string) => P.subs.filter((x) => x.school === school).flatMap((x) => dash?.tried.get(x.id) ?? []);
  async function renderTopics(my = viewSeq) {
    $('mastery').innerHTML = '<p class="note">Loading questions…</p>';
    const qs = await lookup(viewId);
    if (my !== viewSeq) return;
    const tried = new Map<string, [BQ, QState][]>();
    for (const [id, st] of Object.entries(s.questions)) {
      const bq = qs.get(id);
      if (bq) (tried.get(bq.sub) ?? tried.set(bq.sub, []).get(bq.sub)!).push([bq, st]);
    }
    dash = { qs, tried };
    let html = missingNote() + '<div class="dash">';
    for (const school of P.schools) {
      const list = P.subs.filter((x) => x.school === school.id);
      if (!list.length) continue;
      const all = subjectTried(school.id), avail = list.reduce((n, x) => n + (x.content ? x.avail : 0), 0);
      const first = all.filter(([, x]) => x.s === 0 && x.w === 0).length, later = all.filter(([, x]) => x.s === 0 && x.w > 0).length;
      const learning = all.length - first - later, wrong = all.filter(([, x]) => x.w > 0).length;
      const pc = (n: number) => (all.length ? (100 * n) / all.length : 0);
      const pie = all.length ? `conic-gradient(var(--ok) 0 ${pc(first)}%, var(--r-ancient) 0 ${pc(first + later)}%, var(--berry) 0 100%)` : 'var(--crust)';
      html += `<article class="dcard">
        <button type="button" class="dname" data-act="topics" data-school="${esc(school.id)}">${esc(school.name)} <span aria-hidden="true">›</span></button>
        <div class="drow"><div class="pie" style="background:${pie}" role="img" aria-label="${first} right first time, ${later} right after a retest, ${learning} still to retest"></div>
          <dl><div><dt>On the site</dt><dd>${avail.toLocaleString()}</dd></div>
            <div><dt>Tried</dt><dd>${all.length.toLocaleString()}${avail ? ` <small>(${((100 * all.length) / avail).toFixed(all.length && all.length < avail / 100 ? 1 : 0)}%)</small>` : ''}</dd></div>
            <div><dt>Wrong</dt><dd>${wrong ? `<button type="button" class="dwrong" data-act="wrong" data-school="${esc(school.id)}">${wrong}</button>` : '0'}</dd></div></dl></div>
        <p class="legend"><span class="k ok"></span>right first time ${first} <span class="k mid"></span>right after retest ${later} <span class="k bad"></span>to retest ${learning}</p>
      </article>`;
    }
    $('mastery').innerHTML = html + '</div><div id="dash-detail"></div>';
    renderDetail();
  }
  let dashMsg = ''; // the last Retest / revision status, kept across the re-render a save causes
  // assignments (owner, 23 Nov 2026): a parent assigns a sub-topic; the child sees it as a priority until a quiz on it is done
  function assignBtn(sub: PSub) {
    const a = (s.assigned ?? []).find((x) => x.sub === sub.id);
    if (!a) return `<button type="button" class="btn small ghost" data-act="assign" data-sub="${esc(sub.id)}" title="Ask the child to do one 10-question quiz on this first">Assign quiz</button>`;
    const done = !assignedPending(s).some((x) => x.sub === sub.id);
    return `<button type="button" class="btn small ${done ? 'done' : 'on'}" data-act="unassign" data-sub="${esc(sub.id)}" aria-pressed="true"`
      + ` title="${done ? 'Done since it was assigned. Tap to clear it.' : 'Assigned. Tap to take it back.'}">${done ? 'Done ✓' : 'Assigned'}</button>`;
  }
  async function setAssigned(id: string, on: boolean) {
    const sub = P.subs.find((x) => x.id === id);
    if (!sub) return;
    let full = false; // decided on the copy being written (a conflict retry re-runs this on the server's copy)
    const ok = await pushChild((x) => {
      x.assigned = (x.assigned ?? []).filter((a) => a.sub !== id);
      if (on && x.assigned.length >= ASSIGN_MAX) full = true;
      else if (on) x.assigned.push({ sub: id, name: sub.name, href: sub.href, ts: Date.now(), base: finishedOn(x, id) });
      if (!x.assigned.length) delete x.assigned;
    });
    dashMsg = !ok ? "Couldn't save that. Reload the page and try again."
      : full ? `At most ${ASSIGN_MAX} assignments at a time: clear a done one first.`
      : on ? `Assigned a 10-question quiz on ${sub.name}. It pops up the next time they open the game.` : `Cleared: ${sub.name}.`;
    const m = document.getElementById('dash-msg'); if (m) m.textContent = dashMsg;
  }
  function renderDetail(scroll = false) {
    const box = document.getElementById('dash-detail');
    if (!box || !dash || !detail) { if (box) box.innerHTML = ''; return; }
    const school = P.schools.find((x) => x.id === detail!.school)!, now = Date.now();
    const close = '<button type="button" class="btn small" data-act="close">Close</button>';
    if (detail.kind === 'topics') {
      // one compact card per sub-topic (two lines): name, counts, a bar chart and a Retest button that puts every wrong
      // question of it back for a retest at once (owner, 23 Nov 2026: no question list here; the wrong count lists them)
      const can = !!child?.writable;
      let html = `<div class="dhead"><h3>${esc(school.name)}: topics</h3>${close}</div>`
        + `<p class="legend"><span>Each bar is all of the sub-topic's questions:</span> <span class="k ok"></span>right first time <span class="k mid"></span>right after retest <span class="k bad"></span>still to retest <span class="k all"></span>not tried yet</p>`
        + (can ? '<p class="note">Assign asks the child to do one 10-question quiz on that sub-topic first: it pops up on their account and stays at the top of their Schools page until it is done.</p>' : '')
        + '<p class="saved" id="dash-msg" role="status" aria-live="polite"></p>';
      // each topic once, its sub-topics together (P.subs is in reward order, which splits a topic up)
      const byTopic = new Map<string, PSub[]>();
      for (const x of P.subs.filter((y) => y.school === school.id)) (byTopic.get(x.topic) ?? byTopic.set(x.topic, []).get(x.topic)!).push(x);
      let topic = '', open = false;
      for (const sub of [...byTopic.values()].flat()) {
        if (sub.topic !== topic) { if (open) html += '</div>'; topic = sub.topic; html += `<h3 class="wq-sub">${esc(topic)}</h3><div class="tq-grid">`; open = true; }
        const l = dash.tried.get(sub.id) ?? [], wrong = l.filter(([, q]) => q.w > 0), after = l.filter(([, q]) => q.s === 0 && q.w > 0).length;
        // still wrong (s > 0) and not already due; a question mastered since is not un-mastered by this button
        const queue = can ? wrong.filter(([bq, q]) => askable(bq) && q.s > 0 && q.due > now).map(([bq]) => bq.id) : [];
        const scale = Math.max(sub.avail, l.length, 1); // a pool sub-topic's generated retests can outnumber its pool
        // one bar in proportion (owner, 23 Nov 2026): the whole bar is every question; a non-zero part is at least 2 px wide
        const first = l.filter(([, q]) => q.s === 0 && q.w === 0).length, still = l.length - first - after;
        // widths in proportion, each non-zero part at least 2 units; any overflow comes off the widest part, so all fit in 110
        const parts = [[first, 'ok'], [after, 'mid'], [still, 'bad']] as [number, string][];
        const ws = parts.map(([v]) => (v ? Math.max(2, (110 * v) / scale) : 0));
        const over = ws.reduce((a, b) => a + b, 0) - 110;
        if (over > 0) ws[ws.indexOf(Math.max(...ws))] -= over;
        let x = 0;
        const bars = parts.map(([, cls], k) => { if (!ws[k]) return ''; const r = `<rect class="${cls}" x="${x.toFixed(1)}" y="0" height="10" width="${ws[k].toFixed(1)}"></rect>`; x += ws[k]; return r; }).join('');
        const nums = `${sub.avail.toLocaleString()} questions: ${first} right first time, ${after} right after retest, ${still} still to retest, ${Math.max(0, sub.avail - l.length)} not tried`;
        html += `<div class="tq-card${sub.content ? '' : ' off'}"><div class="tq-main"><span class="nm" title="${esc(sub.name)}">${esc(sub.name)}</span>`
          + `<span class="tq-n">${sub.content ? `${sub.avail.toLocaleString()} q · ${l.length} tried · ${still} to retest · ${after} right after retest` : 'Coming soon'}</span></div>`
          + (sub.content ? `<svg class="tq-bars" viewBox="0 0 110 10" preserveAspectRatio="none" role="img" aria-label="${esc(nums)}"><title>${esc(nums)}</title><rect class="all" x="0" y="0" width="110" height="10"></rect>${bars}</svg>` : '')
          + (can && sub.content ? assignBtn(sub) : '')
          + (queue.length ? `<button type="button" class="btn small" data-act="requeue" data-ids="${esc(queue.join(' '))}" aria-label="Retest the ${queue.length} still-wrong questions of ${esc(sub.name)} now" data-name="${esc(sub.name)}">Retest ${queue.length}</button>` : '')
          + '</div>';
      }
      box.innerHTML = html + (open ? '</div>' : '');
    } else {
      const wrong = subjectTried(school.id).filter(([, x]) => x.w > 0);
      // the revision test: still-wrong questions first, the most often wrong first, at most REVISION_MAX
      // (past-paper questions only while the child's quiz can load them)
      const pick = [...wrong].filter(([bq]) => askable(bq))
        .sort((a, b) => (b[1].s > 0 ? 1 : 0) - (a[1].s > 0 ? 1 : 0) || b[1].w - a[1].w).slice(0, REVISION_MAX).map(([bq]) => bq.id);
      const can = !!child?.writable; // a parent's own child, or the admin's Test Player (the database allows no other admin write)
      const sent = (s.revision?.ids ?? []).filter((id) => wrong.some(([bq]) => bq.id === id));
      box.innerHTML = `<div class="dhead"><h3>${esc(school.name)}: ${plural(wrong.length, 'question')} answered wrong</h3>${close}</div>`
        + (can && pick.length > 1 ? `<p><button type="button" class="btn" data-act="revise" data-ids="${esc(pick.join(' '))}">Send ${pick.length} as a revision test now</button></p>
          <p class="note">The questions go to the top of the child's next Daily Review, asked together as a revision test.${sent.length ? ` ${sent.length} from the last one sent are in this list.` : ''}</p>` : '')
        + '<p class="saved" id="dash-msg" role="status" aria-live="polite"></p>'
        + qList(wrong, now, (bq, q) => (can && !(q.s > 0 && q.due <= now) && askable(bq) ? `<button type="button" class="btn small" data-act="recycle" data-id="${esc(bq.id)}">Retest now</button>` : ''));
    }
    const m = document.getElementById('dash-msg');
    if (m) m.textContent = dashMsg;
    if (scroll) box.scrollIntoView({ block: 'start' });
  }
  /** Make questions due now in the child's save (a mastered one comes back as a retest); `revision` also marks them as the
   *  revision test. Written through pushChild (rev check; never the admin's view). */
  async function makeDue(ids: string[], revision: boolean) {
    const now = Date.now();
    const ok = await pushChild((x) => {
      // a mastered question comes back at the last retest step, so one right answer masters it again
      for (const id of ids) { const q = x.questions[id]; if (!q) continue; q.s = q.s > 0 ? q.s : 3; q.due = now; delete q.parked; }
      if (revision) x.revision = { ids: ids.filter((id) => x.questions[id]), ts: now };
    });
    dashMsg = !ok ? "Couldn't save that. Reload the page and try again."
      : revision ? `Sent. ${plural(ids.length, 'question')} wait at the top of the next Daily Review.`
      : `Done: ${ids.length === 1 ? 'it comes' : `${ids.length} questions come`} up in the next Daily Review.`;
    const msg = document.getElementById('dash-msg');
    if (msg) msg.textContent = dashMsg;
  }
  // the exam-page pictures are signed for an hour: redraw the dashboard (and this device's mistakes list) before they lapse
  setInterval(() => { viewSeq++; void renderTopics(); if (!$<HTMLSelectElement>('wrong-who').value) { wrongSeq++; void renderWrong(); } }, 50 * 60_000);
  $('mastery').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-act]');
    if (!b) return;
    const act = b.dataset.act!;
    if (act === 'topics' || act === 'wrong') { detail = { kind: act, school: b.dataset.school! }; dashMsg = ''; renderDetail(true); }
    else if (act === 'close') { detail = null; dashMsg = ''; renderDetail(); $('h-mast').scrollIntoView(); }
    else if (act === 'recycle') void makeDue([b.dataset.id!], false);
    else if (act === 'assign' || act === 'unassign') void setAssigned(b.dataset.sub!, act === 'assign');
    else if (act === 'requeue') {
      const ids = b.dataset.ids!.split(' ');
      if (confirm(`Put the ${ids.length} still-wrong question${ids.length === 1 ? '' : 's'} of ${b.dataset.name} into the next Daily Review now?`)) void makeDue(ids, false);
    }
    else if (act === 'revise') {
      const ids = b.dataset.ids!.split(' ');
      if (confirm(`Send these ${ids.length} questions as a revision test? They become due now and are asked first in the next Daily Review.`)) void makeDue(ids, true);
    }
  });

  // (the admin's child picker is initAdminKids: one picker for the whole page)
  let wrongSeq = 0; // the mistakes list (the admin's picker changes it)
  let viewSeq = 0; // the dashboard and the retest queue (a new child or save re-renders them)
  async function renderWrong(questions: SaveV1['questions'] = s.questions, my = wrongSeq, who: string | null = viewId) {
    const recorded = Object.entries(questions).filter(([, q]) => q.w > 0);
    if (!recorded.length) { $('wrong').innerHTML = '<p class="note">No wrong answers recorded yet.</p>'; return; }
    $('wrong').innerHTML = '<p class="note">Loading questions…</p>';
    const bank = await lookup(who);
    if (my !== wrongSeq) return; // the picker changed while the questions loaded
    // owner, 20 Nov 2026: questions no longer in any bank (the pilot banks were redesigned) are left out entirely
    const wrong = recorded.filter(([id]) => bank.has(id));
    if (!wrong.length) { $('wrong').innerHTML = (missingNote() || '<p class="note">No wrong answers on the current questions yet.</p>'); return; }
    const subOf = new Map(P.subs.map((x) => [x.id, x]));
    const schoolName = new Map(P.schools.map((x) => [x.id, x.name]));
    // subject -> sub-topic -> [question, state]
    const tree = new Map<string, Map<string, [BQ, QState][]>>();
    for (const [id, q] of wrong) {
      const bq = bank.get(id)!, sub = subOf.get(bq.sub);
      const subject = sub ? schoolName.get(sub.school) ?? sub.school : 'Other';
      const name = sub ? sub.name : bq.sub;
      const bySub = tree.get(subject) ?? tree.set(subject, new Map()).get(subject)!;
      (bySub.get(name) ?? bySub.set(name, []).get(name)!).push([bq, q]);
    }
    const now = Date.now();
    $('wrong').innerHTML = missingNote() + `<p class="note">${plural(wrong.length, 'question')} in all.</p>` + [...tree].map(([subject, bySub]) => {
      const n = [...bySub.values()].reduce((k, l) => k + l.length, 0);
      return `<details class="wq-subject"><summary><b>${esc(subject)}</b> (${n})</summary>` + [...bySub].sort((a, b) => a[0].localeCompare(b[0])).map(([name, list]) =>
        `<h3 class="wq-sub">${esc(name)} (${list.length})</h3>${qList(list, now)}`).join('') + '</details>';
    }).join('');
  }

  async function renderRetest(my = viewSeq) {
    const now = Date.now();
    // the child's rule (inReview): states parked by these banks are left out (and out of the count); one parked by an
    // older tab may be live, so it stays until a Daily Review re-checks it
    const waiting = Object.entries(s.questions).filter(([, q]) => inReview(q, P.banks)).sort((a, b) => a[1].due - b[1].due);
    if (!waiting.length) { $('retest').innerHTML = '<p class="note">Nothing waiting for a retest.</p>'; return; }
    $('retest').innerHTML = '<p class="note">Loading questions…</p>';
    const stems = await lookup(viewId);
    if (my !== viewSeq) return;
    const due = waiting.filter(([id]) => stems.has(id)); // questions no longer in any bank are never asked again
    if (!due.length) { $('retest').innerHTML = missingNote() || '<p class="note">Nothing waiting for a retest.</p>'; return; }
    const step = [0, '1-day', '3-day', '7-day'];
    $('retest').innerHTML = missingNote() + `<p class="note">${due.length} question${due.length > 1 ? 's' : ''} waiting.</p><ol class="list">` + due.map(([id, q]) => {
      const late = q.due <= now;
      const dueTxt = late
        ? (dayKey(q.due) === dayKey(now) ? 'due today' : '<span class="due-late">overdue</span>')
        : `due ${esc(fmtDate(q.due))}`;
      return `<li>${bold(stems.get(id)!.stem)}<span class="meta">${step[q.s]} step · ${dueTxt} · wrong ${q.w} time${q.w === 1 ? '' : 's'}</span></li>`;
    }).join('') + '</ol>';
  }

  // settings
  let savedTimer: number | undefined;
  function flashSaved(msg = 'Saved') {
    const el = $('saved'); el.textContent = msg;
    clearTimeout(savedTimer); savedTimer = window.setTimeout(() => (el.textContent = ''), 2500);
  }
  function weeksText() {
    const d = new Date(s.settings.psleDate + 'T00:00:00').getTime();
    if (isNaN(d)) { $('weeks').textContent = ''; return; }
    const w = Math.ceil((d - Date.now()) / (7 * DAY));
    $('weeks').textContent = w > 0 ? `About ${w} week${w === 1 ? '' : 's'} left.` : 'That date has passed.';
  }
  function initSettings() {
            const cap = $<HTMLInputElement>('cap'), goal = $<HTMLInputElement>('goal'), extra = $<HTMLInputElement>('extra'), psle = $<HTMLInputElement>('psle');
    const showCap = () => {
      $('cap-out').textContent = `${cap.value} minutes`;
      $('cap-note').textContent = QUIZ_CAP_ON
        ? `The day ends when ${cap.value} minutes of training or ${DAILY_QUIZ_CAP} quizzes are reached, whichever comes first. Tier quizzes and practice papers count; Daily Review does not count as a quiz, but stops at the time limit.`
        : `The day ends after ${cap.value} minutes of training. There is no limit on the number of quizzes for now; Daily Review also stops at the time limit.`;
    };
    cap.value = String(s.settings.dailyCapMin); goal.value = String(s.settings.dailyGoalQuizzes); showCap();
    cap.addEventListener('input', showCap);
    extra.checked = s.settings.extraTime; psle.value = s.settings.psleDate; weeksText();
    const clamp = (v: string, lo: number, hi: number, step: number, fb: number) => {
      const n = Math.round(Number(v) / step) * step;
      return isFinite(n) && v !== '' ? Math.min(hi, Math.max(lo, n)) : fb;
    };
    const apply = (x: SaveV1) => {
      x.settings.dailyCapMin = clamp(cap.value, 45, 180, 15, x.settings.dailyCapMin);
      x.settings.dailyGoalQuizzes = clamp(goal.value, 1, 5, 1, x.settings.dailyGoalQuizzes);
      x.settings.extraTime = extra.checked;
      if (psle.value) x.settings.psleDate = psle.value;
    };
    const commit = async () => {
      if (isParentView || child) { // the picked child's synced save (their device picks it up on its next page load)
        if (!child?.writable) { flashSaved(child ? "This child's settings can only be changed by their parent." : "Couldn't save. Reload the page."); return; }
        if (!(await pushChild(apply).catch(() => false))) { flashSaved("Couldn't save. Try again."); return; }
        return void flashSaved();
      } else { s = load(); apply(s); save(s); s = cleanSave(s); }
      weeksText(); renderSummary(); flashSaved();
    };
    fillSettings = () => { cap.value = String(s.settings.dailyCapMin); goal.value = String(s.settings.dailyGoalQuizzes); extra.checked = s.settings.extraTime; psle.value = s.settings.psleDate; showCap(); weeksText(); };
    for (const el of [cap, goal, extra, psle]) el.addEventListener('change', async () => { await commit(); fillSettings(); });
  }

  // backup
  function initBackup() {
    const msg = $('bak-msg');
    $('copy').addEventListener('click', async () => {
      const code = await exportCode(load());
      try { await navigator.clipboard.writeText(code); msg.textContent = 'Copied.'; }
      catch { msg.textContent = 'Copy was blocked. Use Download instead.'; }
    });
    $('download').addEventListener('click', async () => {
      const code = await exportCode(load());
      const url = URL.createObjectURL(new Blob([code], { type: 'text/plain' }));
      const a = document.createElement('a');
      a.href = url; a.download = `cookie-codex-save-${dayKey()}.txt`;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      msg.textContent = 'Downloaded.';
    });
    $('do-import').addEventListener('click', async () => {
      const err = $('imp-err'); err.textContent = '';
      const code = $<HTMLTextAreaElement>('import').value;
      if (!code.trim()) { err.textContent = 'Paste a save code first.'; return; }
      let next: SaveV1;
      try { next = await importCode(code); }
      catch (e) { err.textContent = e instanceof Error ? e.message : 'That save code could not be read.'; return; }
      if (!confirm('This replaces all current progress on this browser with the save code. Continue?')) return;
      backupLocal();
      save(next);
      location.reload();
    });
  }


  // ------------------------------------------------------------ family (parent accounts; parent-api, docs 12.4)
  type FKid = { id: string; name: string; pin_set_at: string | null; created_at: string; deleted_at: string | null };
  type Me = { deleted_at: string | null; children: FKid[] };
  const ERR: Record<string, string> = {
    weak_pin: 'That PIN is too easy to guess (like 1234 or 1111). Pick another.',
    name_taken: 'That username is taken. Try adding a number or an initial, e.g. Emma2 or EmmaT.',
    name_deleted: 'A child with that name was deleted in the last 7 days. Restore them instead.',
    name_reserved: 'That name is reserved. Pick another.',
    child_limit: 'You can have up to 6 children.',
    confirm_required: 'The confirmation did not match.',
    slow_down: 'Too many changes in an hour. Try again later.',
    mfa_required: 'Enter your authenticator code first.',
    bad_request: 'Check the username (starts with a letter; letters, numbers, spaces or hyphens, up to 20) and the 4-digit PIN.',
    not_found: 'That child was not found.', deleted: 'This account is being deleted.',
  };
  const famSay = (ok: string, err = '') => { $('fam-msg').textContent = ok; $('fam-err').textContent = err; };
  const famFail = (e: unknown) => {
    const code = e instanceof Error ? e.message : '';
    if (code === 'mfa_required' || code === 'unauthorized') { location.href = '/grownups/'; return; }
    famSay('', ERR[code] ?? "Can't reach the server, try again.");
  };
  const purgeDay = (iso: string) => fmtDate(new Date(iso).getTime() + 7 * DAY);
  const goodPin = (a: string, b: string) => (!/^\d{4}$/.test(a) ? 'The PIN has 4 digits.' : a !== b ? 'The two PINs are different.' : '');

  function kidHtml(k: FKid) {
    const id = esc(k.id), nm = esc(k.name);
    if (k.deleted_at) {
      return `<div class="kid"><b>${nm}</b> <span class="meta">deleted; erased on ${esc(purgeDay(k.deleted_at))}</span>
        <div class="row"><button type="button" class="btn" data-act="restore" data-id="${id}">Restore ${nm}</button></div></div>`;
    }
    return `<div class="kid"><b>${nm}</b> <span class="meta">${k.pin_set_at ? `PIN set ${esc(fmtDate(Date.parse(k.pin_set_at)))}` : 'no PIN yet'}</span>
      <div class="row"><input class="pin" id="pin-${id}" type="password" inputmode="numeric" pattern="[0-9]*" maxlength="4" autocomplete="new-password" placeholder="New PIN" aria-label="New PIN for ${nm}" />
        <button type="button" class="btn" data-act="pin" data-id="${id}">Set PIN</button>
        <button type="button" class="btn" data-act="unlock" data-id="${id}">Clear lock</button></div>
      <div class="row"><input id="nm-${id}" type="text" maxlength="20" placeholder="New username" aria-label="New username for ${nm}" />
        <button type="button" class="btn" data-act="rename" data-id="${id}">Rename</button>
        <button type="button" class="btn danger" data-act="delete" data-id="${id}" data-name="${nm}">Delete</button></div></div>`;
  }

  let me: Me | null = null;
  async function refreshFamily() {
    me = await callParentApi<Me>({ action: 'me' });
    if (me.deleted_at) {
      $('family').hidden = true; $('content').hidden = true; $('fam-deleted').hidden = false;
      $('fam-deleted-note').textContent = `Your children cannot sign in. Everything will be erased on ${purgeDay(me.deleted_at)} unless you restore it.`;
      return;
    }
    $('fam-deleted').hidden = true; $('family').hidden = false;
    $('fam-kids').innerHTML = me.children.length ? me.children.map(kidHtml).join('') : '<p class="note">No children yet. Add your first child below.</p>';
    if (pickerReady) await buildKidPicker(me.children).catch(() => { $('content').hidden = true; });
  }

  async function initFamily() {
    $('fam-add').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = $<HTMLInputElement>('add-name').value.trim(), a = $<HTMLInputElement>('add-pin').value, b = $<HTMLInputElement>('add-pin2').value;
      const bad = !name ? 'Type a name.' : goodPin(a, b);
      if (bad) { famSay('', bad); return; }
      try {
        await callParentApi({ action: 'create_child', name, pin: a });
        for (const id of ['add-name', 'add-pin', 'add-pin2']) $<HTMLInputElement>(id).value = '';
        await refreshFamily(); famSay(`${name} added. They sign in on any device with the username ${name} and the PIN.`);
      } catch (err) { famFail(err); }
    });
    $('fam-kids').addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-act]');
      if (!btn) return;
      const id = btn.dataset.id!, act = btn.dataset.act!;
      try {
        if (act === 'pin') {
          const pin = $<HTMLInputElement>(`pin-${id}`).value;
          if (!/^\d{4}$/.test(pin)) { famSay('', 'The PIN has 4 digits.'); return; }
          await callParentApi({ action: 'set_pin', child_id: id, pin }); famSay('PIN changed. Their other devices need the new PIN.');
        } else if (act === 'unlock') {
          await callParentApi({ action: 'clear_name_lock', child_id: id }); famSay('Lock cleared.');
        } else if (act === 'rename') {
          const name = $<HTMLInputElement>(`nm-${id}`).value.trim();
          if (!name) { famSay('', 'Type the new name.'); return; }
          await callParentApi({ action: 'rename_child', child_id: id, name }); famSay('Renamed.');
        } else if (act === 'delete') {
          const typed = prompt(`Type ${btn.dataset.name} to delete this child. They cannot sign in from now on; their progress is erased after 7 days unless you restore them.`);
          if (typed === null) return;
          if (!confirm(`Delete ${btn.dataset.name} and all their progress? You can restore them for 7 days; after that it is gone for good.`)) return;
          await callParentApi({ action: 'delete_child', child_id: id, confirm: typed }); famSay('Deleted. You can restore them for 7 days.');
        } else if (act === 'restore') {
          await callParentApi({ action: 'restore_child', child_id: id }); famSay('Restored.');
        }
        await refreshFamily();
      } catch (err) { famFail(err); }
    });
    $('del-account').addEventListener('click', async () => {
      const email = $<HTMLInputElement>('del-email').value;
      if (!confirm('Delete your account and all your children\'s data? You have 7 days to undo.')) return;
      try { await callParentApi({ action: 'delete_account', confirm: email }); await refreshFamily(); } catch (e) { famFail(e); }
    });
    $('fam-restore').addEventListener('click', async () => {
      try { await callParentApi({ action: 'restore_account' }); location.reload(); }
      catch (e) { $('fam-deleted-err').textContent = ERR[e instanceof Error ? e.message : ''] ?? "Can't reach the server, try again."; }
    });
    initMfa();
    await refreshFamily();
  }

  // optional authenticator for a parent: once a factor is verified, parent-api and the page gate ask for aal2
  let mfaFactor = '';
  async function initMfa() {
    const fl = await supabase.auth.mfa.listFactors();
    if (fl.data?.totp?.length) { $('mfa-note').textContent = 'An authenticator app is on for this account.'; $('mfa-start').hidden = true; return; }
    $('mfa-start').addEventListener('click', async () => {
      for (const f of fl.data?.all ?? []) if (f.factor_type === 'totp' && f.status !== 'verified') await supabase.auth.mfa.unenroll({ factorId: f.id });
      const en = await supabase.auth.mfa.enroll({ factorType: 'totp', friendlyName: 'Authenticator' });
      if (en.error || !en.data) { famSay('', "Couldn't start the setup. Try again."); return; }
      mfaFactor = en.data.id;
      $<HTMLImageElement>('mfa-qr').src = en.data.totp.qr_code;
      $('mfa-secret').textContent = en.data.totp.secret;
      $('mfa-box').hidden = false; $('mfa-start').hidden = true; $('mfa-code').focus();
    });
    $('mfa-verify').addEventListener('click', async () => {
      const input = $<HTMLInputElement>('mfa-code'), code = input.value.trim(); input.value = '';
      const { error } = await supabase.auth.mfa.challengeAndVerify({ factorId: mfaFactor, code });
      if (error) { famSay('', 'That code did not work. Wait for the next code and try again.'); return; }
      $('mfa-box').hidden = true; $('mfa-note').textContent = 'An authenticator app is on for this account.'; famSay('Authenticator app turned on.');
    });
  }

  // ------------------------------------------------------------ a parent's view of one child (their synced save)
  // RLS lets a parent read and push_save their own children's saves (owns_child). Every section renders `s`, so a
  // picked child's cleaned save replaces the device's save; settings are written back with the rev check.
  // `child.raw` is the migrated server save as stored (pushed back with only the settings changed); `s` is its cleaned
  // copy for display. `pick` guards against out-of-order replies: a reply for an older pick is dropped.
  // writable: this page may change that child's save (a parent's own child; for the admin only the Test Player)
  let child: { id: string; rev: number | null; raw: SaveV1; writable: boolean } | null = null;
  let pick = 0, isParentView = false, pickerReady = false;
  let fillSettings = () => {};
  const renderAll = () => { wrongSeq++; viewSeq++; renderSummary(); renderCrumbs(); renderTopics(); renderDays(); renderMistakes(); renderWrong(); renderRetest(); fillSettings(); };
  const asSave = (d: unknown) => (d ? (migrate(d) as SaveV1) : (cleanSave(null) as SaveV1));
  async function showChild(id: string, writable = isParentView) {
    const my = ++pick;
    const r = await supabase.from('saves').select('rev, data').eq('child_id', id).maybeSingle();
    if (my !== pick) return;
    if (r.error) throw r.error;
    child = { id, rev: r.data ? Number(r.data.rev) : null, raw: asSave(r.data?.data), writable };
    s = cleanSave(child.raw); viewId = id;
    renderAll();
  }
  /** Change the child's server save with the rev check; on a conflict (the child played meanwhile) apply the change to
   *  the server copy push_save returned and try once more. */
  async function pushChild(change: (x: SaveV1) => void): Promise<boolean> {
    const target = child, my = pick;
    if (!target?.writable) return false;
    let base = target.rev, data = target.raw;
    for (let i = 0; i < 2; i++) {
      const next = JSON.parse(JSON.stringify(data)) as SaveV1;
      change(next);
      const r = await supabase.rpc('push_save', { p_child: target.id, p_data: next, p_version: SCHEMA, p_base_rev: base });
      const st = (r.data as { status: string; rev: number; data: unknown }[] | null)?.[0];
      if (!r.error && st?.status === 'ok') {
        if (my === pick && child === target) { target.rev = st.rev; target.raw = next; s = cleanSave(next); renderAll(); }
        return true;
      }
      if (r.error || st?.status !== 'conflict') return false;
      base = st.rev; data = asSave(st.data);
    }
    return false;
  }
  /** (Re)build the "Showing" list from the family; keeps the current pick when that child is still there. */
  async function buildKidPicker(kids: FKid[]) {
    const live = kids.filter((k) => !k.deleted_at);
    $('bak-panel').hidden = true; // the save code is the child's device's own backup
    $('content').hidden = !live.length;
    if (!live.length) { child = null; $('who-note').textContent = 'Signed in as the parent. Add a child under Family and accounts to see their progress here.'; return; }
    const sel = $<HTMLSelectElement>('kid-who'), keep = live.some((k) => k.id === child?.id) ? child!.id : live[0].id;
    sel.innerHTML = live.map((k) => `<option value="${esc(k.id)}"${k.id === keep ? ' selected' : ''}>${esc(k.name)}</option>`).join('');
    $('kid-pick').hidden = false;
    $('who-note').textContent = 'Signed in as the parent. This page shows the progress of the child picked below, as saved on the server.';
    if (keep !== child?.id) await showChild(keep);
  }

  // ------------------------------------------------------------ tabs: child progress | family and accounts (a parent) or a
  // link to the admin console (the admin). CSS hides the other panel by data-tab, so the panels' own hidden flags stay theirs.
  const tab = (t: 'prog' | 'fam') => {
    $('pp-root').dataset.tab = t;
    $('tab-prog').setAttribute('aria-selected', String(t === 'prog')); $('tab-fam').setAttribute('aria-selected', String(t === 'fam'));
  };
  $('tab-prog').addEventListener('click', () => tab('prog'));
  $('tab-fam').addEventListener('click', () => tab('fam'));

  // ------------------------------------------------------------ start
  let started = false;
  async function start() {
    if (started) return;
    started = true;
    // the page is gated (Base.astro): an admin at aal2, or a parent (aal2 once they enrolled an authenticator)
    const { data } = await supabase.auth.getSession();
    const isParent = roleOf(data.session) === 'parent';
    isParentView = isParent;
    if (!isParent) { $('tab-fam').hidden = true; $('tab-admin').hidden = false; }
    else $('who-note').textContent = 'Signed in as the parent. This page shows your children\'s progress as saved on the server.';
    if (isParent) {
      try { await initFamily(); } catch (e) { famFail(e); $('family').hidden = false; }
      if (me?.deleted_at) return;
    }
    $('content').hidden = false;
    s = cleanSave(load());
    initSettings(); initBackup();
    if (isParent) { // everything shows the picked child's synced save, never this device's
      $('kid-who').addEventListener('change', () => {
        void showChild($<HTMLSelectElement>('kid-who').value).catch(() => { $('content').hidden = true; famSay('', "Couldn't load that child's progress. Reload the page."); });
      });
      pickerReady = true;
      try { await buildKidPicker(me?.children ?? []); }
      catch { child = null; $('content').hidden = true; famSay('', "Couldn't load your child's progress. Reload the page."); }
      return;
    }
    // the admin sees this device's save: its past-paper questions are the device player's (the player session)
    try { viewId = (await player.auth.getSession()).data.session?.user.id ?? null; } catch { viewId = null; }
    renderSummary(); renderCrumbs(); renderTopics(); renderDays(); renderMistakes(); renderWrong(); renderRetest();
    void initAdminKids(viewId);
  }

  // Admin (owner, 23 Nov 2026, for testing): the same "Showing" picker a parent has, over the admin's own children (the Test
  // Player). Reading any save is allowed to the admin; writing (Retest, Assign, revision test, settings) only the Test
  // Player's, which the database enforces, so the actions show only for it.
  // owner, 23 Nov 2026: children the admin may also watch, read only, by profile id (a username can be renamed or reused).
  // RLS lets the admin read any profile and save; the database refuses an admin write to anyone but the Test Player.
  // ponytail: a fixed list in the page; a profiles flag returned by the admin function if the list ever grows
  const ADMIN_WATCH = ['5ed5c924-d96d-40f3-ae38-b5d67484faa7'];
  async function initAdminKids(deviceId: string | null) {
    try {
      const { data } = await supabase.auth.getSession();
      if (!data.session) return;
      const r = await callFunction('admin', { action: 'list_children' }, data.session.access_token);
      const own = ((r.status === 200 ? r.body?.children : null) ?? []) as { id: string; name: string; role: string }[];
      const watch = await supabase.from('profiles').select('id, name, role').in('id', ADMIN_WATCH).eq('role', 'child').is('deleted_at', null);
      if (watch.error) console.warn('watched children not loaded:', watch.error.message);
      const kids = [...own, ...(watch.data ?? []).filter((w) => !own.some((k) => k.id === w.id))];
      if (!kids.length) return;
      const sel = $<HTMLSelectElement>('kid-who');
      sel.innerHTML = '<option value="">This device</option>' + kids.map((k) => `<option value="${esc(k.id)}" data-test="${k.role === 'test'}" data-name="${esc(k.name)}">${esc(k.name)}${k.role === 'test' ? ' (Test Player)' : ' (read only)'}</option>`).join('');
      $('kid-pick').hidden = false;
      const note = $('who-note').textContent ?? '';
      sel.addEventListener('change', async () => {
        const opt = sel.selectedOptions[0];
        const device = () => { pick++; child = null; s = cleanSave(load()); viewId = deviceId; $('bak-panel').hidden = false; renderAll(); }; // pick++: a pick still loading is dropped
        if (!sel.value) { $('who-note').textContent = note; return device(); }
        const test = opt?.dataset.test === 'true';
        $('who-note').textContent = `Signed in as the admin. Showing ${opt?.dataset.name ?? ''}'s save from the server${test ? ' (the Test Player)' : ', read only'}.`;
        $('bak-panel').hidden = true; // the save code is this browser's own save, not the picked child's
        const loading = showChild(sel.value, test), my = pick; // showChild takes its pick number before its first await
        await loading.catch(() => { // never leave the picker naming a child the page doesn't show
          if (my !== pick) return; // an older pick failed after a newer one started: leave the newer one alone
          sel.value = ''; device(); $('who-note').textContent = "Couldn't load that child's save: showing this device.";
        });
      });
      // open on the Test Player's server save, like a parent's child, not on this browser's own (usually empty) save
      const test = kids.find((k) => k.role === 'test');
      if (test && sel.value === '') { sel.value = test.id; sel.dispatchEvent(new Event('change')); }
    } catch { /* no picker: this device only */ }
  }

  void start();
</script>
