---
import Base from '../../../layouts/Base.astro';
import { SCHOOLS, subsOf, subSlug, listGroup, unitName, banksHash, wholeSubs } from '../../../lib/train';
import { groupByTopic, type SubInfo } from '../../../lib/suggest';
import { TIERS, type School } from '../../../lib/store';

export function getStaticPaths() {
  return SCHOOLS.map((s) => ({ params: { school: s.id }, props: { school: s } }));
}
const { school } = Astro.props as { school: (typeof SCHOOLS)[number] };
const list = subsOf(school.id as School);
const infos: (SubInfo & { file: string | null; home: number; cloze?: true })[] = list.map((s) => ({
  id: s.id, ...listGroup(s), name: s.name, slug: subSlug(s.id),
  playable: s.playable, count: s.count, hash: s.hash, file: s.file, home: s.home, ...(s.pool ? { pool: s.pool } : {}),
  ...(wholeSubs.includes(s.id) ? { cloze: true } : {}),
}));
const groups = groupByTopic(infos) as { topic: string; name: string; subs: typeof infos }[];
const clientData = JSON.stringify(infos).replace(/</g, '\\u003c');
const playableCount = (g: (typeof groups)[number]) => g.subs.reduce((n, s) => n + TIERS.filter((t) => s.playable[t]).length, 0);
---
{school.ready ? (
<Base title={`Train ${school.name} · Cookie Codex`} description={`Pick what to train today in ${school.name}: suggestions, your power and every ${unitName(school.id as School, 1)}.`}>
  <div class="wrap train-home" data-school={school.id} data-banks={banksHash}>
    <p class="th-crumbs"><a href="/">Home</a></p>
    <h1 class="th-title">What do you want to train in {school.name} today<span class="player-sep"></span>?</h1>

    <div class="th-power" id="th-power">
      <span class="th-power-label">School power: <strong id="th-power-n">0</strong></span>
      <div class="th-bar" role="progressbar" aria-label="School power" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="th-power-fill" style="width:0%"></span></div>
    </div>

    <section class="th-sugg" aria-labelledby="th-sugg-h">
      <h2 id="th-sugg-h">Suggested for you</h2>
      <div id="th-cards" class="th-cards" aria-live="polite">
        <p class="th-muted">Pick a {unitName(school.id as School, 1)} below to start a quiz.</p>
      </div>
    </section>

    <section class="th-syl" aria-labelledby="th-syl-h">
      <h2 id="th-syl-h">All {unitName(school.id as School)}</h2>
      <div class="th-topics">
      {groups.map((g) => (
        <details class="th-topic" data-topic={g.topic}>
          <summary>
            <span class="th-topic-name">{g.name}</span>
            <span class="th-topic-meta">
              <span class="th-mini" aria-hidden="true"><span class="th-topic-fill" style="width:0%"></span></span>
              {playableCount(g) > 0
                ? <span class="th-topic-count"><span class="th-cleared">0</span> of {playableCount(g)} stops reached</span>
                : <span class="th-topic-count">Coming soon</span>}
            </span>
          </summary>
          <ul class="th-subs">
            {g.subs.map((s) => (
              <li class={`th-sub${TIERS.some((t) => s.playable[t]) ? '' : ' th-sub-soon'}`}>
                <a class="th-sub-name" href={`/train/${school.id}/${s.slug}/`}>{s.name}</a>
                <span class="th-home">Primary {s.home}</span>
                {!TIERS.some((t) => s.playable[t]) && <span class="th-chips"><span class="th-soon-tag">Coming soon: no questions yet</span></span>}
                {TIERS.some((t) => s.playable[t]) && <span class="th-chips">
                  <a class="th-chip one" href={`/train/${school.id}/${s.slug}/`} data-sub={s.id}>
                    <span class="dots" aria-hidden="true">{TIERS.filter((t) => s.playable[t]).map(() => <i></i>)}</span><span class="th-chip-txt">{s.name}</span>
                  </a>
                  <a class="th-retest" hidden href={`/train/${school.id}/${s.slug}/`} data-sub={s.id}></a>
                </span>}
              </li>
            ))}
          </ul>
        </details>
      ))}
      </div>
    </section>

    <p class="th-paper"><a class="th-paper-link" href="/paper/">Practice test paper</a></p>
    <script type="application/json" id="th-subs" set:html={clientData} />
  </div>
</Base>
) : (
<Base title={`${school.name} School · opens soon`} description={`${school.name} questions are coming soon.`}>
  <div class="wrap train-home train-soon">
    <p class="th-crumbs"><a href="/">Home</a></p>
    <h1 class="th-title">{school.name} School opens soon</h1>
    <p class="th-muted">We are still writing the {school.name} questions. Here is what you will be able to train when it opens.</p>
    {groups.map((g) => (
      <section class="th-soon-topic">
        <h2>{g.name}</h2>
        <ul class="th-soon-list">
          {g.subs.map((s) => <li>{s.name} <span class="th-home">Primary {s.home}</span></li>)}
        </ul>
      </section>
    ))}
    <p><a class="th-paper-link" href="/train/math/">Train Math meanwhile</a></p>
  </div>
</Base>
)}

<script>
  import { load, tierState, poolProgress, syncParkedStored, reviewDueCount, isDue, TIERS, TIER_NAME } from '../../../lib/store';
  import { nextTier, dueFromStored, stopCount, goalFlags, stopsText, poolRightText, tierFlags } from '../../../lib/section';
  import { esc } from '../../../lib/boldans';
  import { topicPower, schoolPower, suggestions, dueCount, groupByTopic, unitName, type SubInfo, type Suggestion } from '../../../lib/suggest';

  const root = document.querySelector<HTMLElement>('.train-home[data-school]');
  const dataEl = document.getElementById('th-subs');
  if (root && dataEl) {
    type Info = SubInfo & { file: string | null; home: number; cloze?: true };
    const subs: Info[] = JSON.parse(dataEl.textContent || '[]');
    const s = load();
    const now = Date.now();


    // one chip per section: a dot per stop (filled when reached) and a line of text. A stop is counted as the section page
    // counts it (stopCount): for a pool the 1st and 2nd by the slot, Exam-ready only by the pool's own milestone
    const stops = (y: Info) => stopCount(s, y.id, !!y.pool, y.playable);
    const dotsOn = (y: Info) => {
      const flags = y.pool ? goalFlags(s, y.id) : TIERS.map((t) => tierState(s, y.id, t).cleared);
      return TIERS.filter((t) => y.playable[t]).map((t) => flags[TIERS.indexOf(t)]);
    };
    const chipView = (y: Info) => {
      const { reached: e, of } = stops(y);
      const tried = s.attempts.some((a) => a.sub === y.id);
      if (y.pool) {
        const pp = poolProgress(s, y.id), total = pp.total || y.pool;
        if (!pp.counted && !e && !tried) return { state: 'new', html: '<b>Not started</b>', label: 'not started' };
        const right = poolRightText(pp.counted, total, !!y.cloze);
        return { state: e === of ? 'done' : 'some', html: `<b>${stopsText(e, of)}</b><span class="soft">${right}</span>`, label: `${stopsText(e, of)}, ${right}` };
      }
      if (!e && !tried) return { state: 'new', html: '<b>Not started</b>', label: 'not started' };
      if (e === of) return { state: 'done', html: `<b>${stopsText(e, of)}</b><span class="soft">All tiers cleared</span>`, label: `${stopsText(e, of)}, all tiers cleared` };
      const { cleared, open } = tierFlags(s, y.id, y.playable);
      const nt = nextTier(cleared, y.playable, open);
      const last = [...TIERS].reverse().find((t) => y.playable[t] && cleared[t]);
      const head = last ? `${TIER_NAME[last]} cleared` : stopsText(e, of);
      const tail = nt ? `${TIER_NAME[nt]} next` : '';
      return { state: 'some', html: `<b>${head}</b>${tail ? `<span class="soft">${tail}</span>` : ''}`, label: `${stopsText(e, of)}${tail ? `, ${tail}` : ''}` };
    };
    const byId = new Map(subs.map((y) => [y.id, y]));
    root.querySelectorAll<HTMLElement>('.th-chip.one').forEach((el) => {
      const y = byId.get(el.dataset.sub!);
      if (!y) return;
      const v = chipView(y), on = dotsOn(y);
      el.dataset.state = v.state;
      el.querySelectorAll('.dots i').forEach((d, i) => d.classList.toggle('on', !!on[i]));
      el.querySelector('.th-chip-txt')!.innerHTML = v.html;
      el.setAttribute('aria-label', `${y.name}: ${v.label}`);
    });
    /** "N to retest" pills of the pool sections, from what the section's last quiz stored (no fetch); the live states decide
     *  what is still due. A section not played since those fields were added shows none. Generated sections' pills come from
     *  their banks (`extra`, below). */
    const showRetests = (extra: Record<string, number> = {}) => {
      const due = { ...dueFromStored(load(), subs.filter((y) => y.pool).map((y) => y.id), Date.now()), ...extra };
      root.querySelectorAll<HTMLElement>('.th-retest').forEach((el) => {
        const n = due[el.dataset.sub!] ?? 0;
        el.hidden = !n;
        el.textContent = `${n} to retest`;
      });
    };
    showRetests();

    // power
    const setBar = (n: number) => {
      document.getElementById('th-power-n')!.textContent = String(n);
      document.getElementById('th-power-fill')!.style.width = `${n}%`;
      document.querySelector('#th-power .th-bar')!.setAttribute('aria-valuenow', String(n));
    };
    setBar(schoolPower(s, subs));
    const groups = groupByTopic(subs);
    root.querySelectorAll<HTMLDetailsElement>('.th-topic').forEach((d) => {
      const g = groups.find((x) => x.topic === d.dataset.topic);
      if (!g) return;
      const p = topicPower(s, g.subs);
      d.querySelector<HTMLElement>('.th-topic-fill')!.style.width = `${p}%`;
      const n = g.subs.reduce((k, y) => k + stops(y as Info).reached, 0);
      const c = d.querySelector('.th-cleared'); if (c) c.textContent = String(n);
    });

    // suggestions
    const cards = document.getElementById('th-cards')!;
    const kindLabel: Record<Suggestion['kind'], string> = { review: 'Review', 'one-more': 'One more pass', weak: 'Weak spot', next: 'Next up', done: 'All done' };
    const render = (list: Suggestion[]) => {
      if (!list.length) { cards.innerHTML = `<p class="th-muted">Pick a ${unitName(root?.dataset.school ?? '', 1)} below to start a quiz.</p>`; return; }
      cards.innerHTML = list.map((x) => `
        <article class="th-card" data-kind="${x.kind}">
          <span class="th-card-kind">${kindLabel[x.kind]}</span>
          <h3>${esc(x.title)}</h3>
          <p>${esc(x.reason)}</p>
          <a class="th-start" href="${esc(x.href)}">${x.kind === 'done' ? 'See my collection' : 'Start'}<span class="th-sr"> ${esc(x.title)}</span></a>
        </article>`).join('');
      for (const x of list) {
        if (!x.sub) continue;
        const sub = subs.find((y) => y.id === x.sub);
        if (sub) root.querySelector<HTMLDetailsElement>(`.th-topic[data-topic="${sub.topic}"]`)!.open = true;
      }
    };
    const run = (due: number, qs?: Record<string, string>, sv = s) => render(suggestions(sv, subs, { now, dueCount: due, questionSub: qs }));

    // includes states an older tab or build parked (reviewDueCount), so the banks below get the chance to unpark them
    const anyDue = reviewDueCount(s, now, root.dataset.banks) > 0;
    if (!anyDue) run(0);
    else {
      // map question ids to sub-topics using this school's banks, so the review count matches this school
      const files = [...new Set(subs.map((x) => x.file).filter(Boolean))] as string[];
      Promise.all(files.map((f) => fetch(`/data/quiz/${f}.json`).then((r) => (r.ok ? r.json() : [])).catch(() => [])))
        .then((banks) => {
          const qs: Record<string, string> = {};
          for (const b of banks as { id: string; sub: string }[][]) for (const q of b) qs[q.id] = q.sub;
          // unpark only (never park: this page loads one school's banks); nothing is deleted (ADR 0002). Against the save as
          // stored now, never `s` from before the fetch: another tab may have bought or earned meanwhile
          const cur = syncParkedStored(Object.keys(qs), false);
          run(dueCount(cur, now, qs), qs, cur);
          return qs;
        })
        .then((qs) => {
          // generated sections' pills: due retests by the bank that owns the id (a pool section's pill comes from its stored
          // `rq`, see showRetests; its generated ids never count, its quiz asks only past-paper questions)
          const pools = new Set(subs.filter((y) => y.pool).map((y) => y.id));
          const due: Record<string, number> = {};
          const cur = load();
          for (const [id, sub] of Object.entries(qs)) if (!pools.has(sub) && isDue(cur, id, Date.now(), true)) due[sub] = (due[sub] ?? 0) + 1;
          showRetests(due);
        })
        .catch(() => run(dueCount(s, now)));
    }
  }
</script>

<style is:global>
  .train-home { padding-block: 1.25rem 2.5rem; }
  .train-home a:focus-visible, .train-home summary:focus-visible { outline: 3px solid var(--berry); outline-offset: 2px; }
  .train-home .th-crumbs { margin: 0; font-size: 0.95rem; }
  .train-home .th-crumbs a { display: inline-flex; align-items: center; min-height: 44px; color: var(--cocoa-soft); }
  .train-home .th-title { margin: 0 0 0.75rem; font-size: clamp(1.5rem, 5vw, 2.25rem); line-height: 1.2; }
  .train-home h2 { font-size: 1.25rem; margin: 1.75rem 0 0.6rem; }
  .train-home .th-muted { color: var(--cocoa-soft); margin: 0; }

  .train-home .th-power { display: grid; gap: 0.35rem; max-width: 32rem; }
  .train-home .th-power-label { font-family: var(--font-display); font-weight: 600; }
  .train-home .th-power-label strong { font-size: 1.4em; color: var(--berry); }
  .train-home .th-bar { height: 14px; background: var(--plate); border: 1.5px solid var(--crust); border-radius: 999px; overflow: hidden; }
  .train-home .th-bar > span { display: block; height: 100%; background: var(--berry); border-radius: 999px; transition: width 0.4s; }

  .train-home .th-cards { display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .train-home .th-card {
    background: var(--paper); border: 1.5px solid var(--crust); border-radius: var(--radius-card);
    padding: 1rem 1.1rem; display: grid; gap: 0.4rem; align-content: start; box-shadow: var(--shadow-lift);
  }
  .train-home .th-card h3 { margin: 0; font-size: 1.15rem; line-height: 1.25; }
  .train-home .th-card p { margin: 0; color: var(--cocoa-soft); }
  .train-home .th-card-kind { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--berry); }
  .train-home .th-start, .train-home .th-paper-link {
    justify-self: start; margin-top: 0.3rem; font: 600 1rem var(--font-display); background: var(--berry); color: var(--berry-ink);
    border-radius: var(--radius-control); padding: 0.5rem 1.25rem; min-height: 44px; display: inline-flex; align-items: center; text-decoration: none;
  }
  .train-home .th-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* two columns of topics from 720px so the whole list fits without scrolling; topics keep their order, row by row */
  .train-home .th-topics { display: grid; gap: 0.6rem; align-items: start; }
  @media (min-width: 720px) { .train-home .th-topics { grid-template-columns: 1fr 1fr; } }
  .train-home .th-topic { background: var(--paper); border: 1.5px solid var(--crust); border-radius: var(--radius-card); }
  .train-home .th-topic summary {
    cursor: pointer; list-style: none; display: grid; gap: 0.3rem; padding: 0.6rem 1rem; min-height: 44px; align-content: center;
  }
  .train-home .th-topic summary::-webkit-details-marker { display: none; }
  .train-home .th-topic-name { font: 600 1.05rem var(--font-display); }
  .train-home .th-topic-name::before { content: '▸ '; color: var(--cocoa-soft); }
  .train-home .th-topic[open] .th-topic-name::before { content: '▾ '; }
  .train-home .th-topic-meta { display: flex; align-items: center; gap: 0.6rem; font-size: 0.9rem; color: var(--cocoa-soft); }
  .train-home .th-mini { flex: 0 0 6rem; height: 8px; background: var(--plate); border-radius: 999px; overflow: hidden; }
  .train-home .th-topic-fill { display: block; height: 100%; background: var(--berry); }

  .train-home .th-subs { list-style: none; margin: 0; padding: 0 0.75rem 0.75rem; display: grid; gap: 0.5rem; }
  .train-home .th-sub {
    display: grid; grid-template-columns: 1fr auto; gap: 0.1rem 0.75rem; align-items: center;
    background: var(--cream); border: 1px solid var(--crust); border-radius: var(--radius-control); padding: 0.4rem 0.75rem 0.6rem;
  }
  .train-home .th-sub-name { font: 600 1rem var(--font-display); min-height: 44px; display: inline-flex; align-items: center; color: var(--cocoa); }
  .train-home .th-home { color: var(--cocoa-soft); font-size: 0.85rem; }
  .train-home .th-chips { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .train-home .th-chip {
    font-size: 0.85rem; min-height: 44px; display: inline-flex; align-items: center; padding: 0 0.8rem; border-radius: 999px;
    border: 1.5px solid var(--crust); color: var(--cocoa-soft); text-decoration: none; background: var(--paper);
  }
  /* one chip per section: three dots (cards earned) and a line of text; a separate pill when retests wait */
  .train-home .th-chip.one { gap: 0.55rem; color: var(--cocoa); border-color: var(--cocoa-soft); padding: 0 0.9rem 0 0.7rem; }
  .train-home .th-chip.one .th-chip-txt { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.55rem; }
  .train-home .th-chip.one .dots { display: inline-flex; gap: 3px; flex: none; }
  .train-home .th-chip.one .dots i { width: 10px; height: 10px; border-radius: 50%; border: 1.5px solid var(--cocoa-soft); }
  .train-home .th-chip.one .dots i.on { background: #2e7d4f; border-color: #2e7d4f; }
  .train-home .th-chip.one b { font-family: var(--font-display); font-weight: 600; }
  .train-home .th-chip.one .soft { color: var(--cocoa-soft); }
  .train-home .th-chip.one[data-state='done'] { background: #e6f4ea; border-color: #2e7d4f; color: #1f6b3a; }
  .train-home .th-chip.one[data-state='new'] { border-style: dashed; color: var(--cocoa-soft); }
  .train-home .th-retest { font-size: 0.85rem; min-height: 44px; display: inline-flex; align-items: center; padding: 0 0.8rem; border-radius: 999px;
    background: #fdf1f3; color: var(--berry); font-weight: 600; text-decoration: none; border: 1.5px solid var(--berry); }
  .train-home .th-retest[hidden] { display: none; }
  .train-home .th-paper { margin-top: 1.75rem; }
  .train-home .th-sub-soon { background: var(--plate); border-style: dashed; }
  .train-home .th-sub-soon .th-sub-name { color: var(--cocoa-soft); }
  .train-home .th-soon-tag { font-size: 0.85rem; font-style: italic; color: var(--cocoa-soft); }

  .train-home .th-soon-list { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.2rem; }
  .train-home .th-soon-topic h2 { margin-top: 1.25rem; }
</style>
