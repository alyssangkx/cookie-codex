---
import Base from '../../../layouts/Base.astro';
import { SCHOOLS, subs, subSlug, slots, cookieBySlug, MIN_POOL, listGroup, wholeSubs } from '../../../lib/train';
import { TIER_NAME, MILESTONE_NAME, triesPerDay, milestoneAt } from '../../../lib/store';
import { rarityLabel, TICK_SVG } from '../../../lib/section';

export function getStaticPaths() {
  return subs.map((s) => ({ params: { school: s.school, sub: subSlug(s.id) }, props: { sub: s } }));
}
const { sub } = Astro.props as { sub: (typeof subs)[number] };
const tries = triesPerDay(sub.id);
const school = SCHOOLS.find((x) => x.id === sub.school)!;
// a one-pool sub-topic (ADR 0011): one pool of past-paper questions, the three card slots are milestones ("stops")
const pool = sub.pool ?? 0;
const at = milestoneAt(pool);
const cloze = wholeSubs.includes(sub.id);
const units = cloze ? 'blanks' : 'questions';
const tiers = (['b', 'i', 'c'] as const).map((k, n) => {
  const slot = slots[`${sub.id}|${k}`];
  const cookie = cookieBySlug.get(slot.slug)!;
  return { k, name: pool ? MILESTONE_NAME[k] : TIER_NAME[k], slot, cookie, rarity: rarityLabel(cookie.rarity), at: at[n],
    count: pool || sub.count[k], hash: pool ? undefined : sub.hash[k], playable: pool ? true : sub.playable[k] };
});
---
<Base title={`${sub.name} · ${school.name} training`} description={`PSLE ${school.name} practice on ${sub.name}.`}>
  <section class="wrap sub-page" data-sub={sub.id} data-tries={tries} data-pool={String(pool)} data-pool-all={sub.poolAll ? String(sub.poolAll) : undefined}
    data-file={sub.file ?? undefined} data-units={units} data-cloze={cloze ? '1' : undefined} data-at={at.join(',')}>
    <p class="crumbs"><a href="/train/">Schools</a> › <a href={`/train/${school.id}/`}>{school.name}</a> › {listGroup(sub).topicName}</p>
    <h1>{sub.name}</h1>

    {pool > 0 ? (
      <>
        <div class="panel hero">
          <div>
            <p class="big"><span class="big-n" id="pool-n">0</span><span class="big-of">of <span id="pool-total">{pool}</span> {units} right</span></p>
            <p class="next" id="next-line"></p>
            <a class="go" id="go" href={`/quiz/?sub=${encodeURIComponent(sub.id)}`}>{cloze ? 'Fill a passage' : 'Start training'}</a>
            <p class="go-note" id="go-note"></p>
            <p class="cap" id="cap" role="status" hidden></p>
          </div>
          <dl class="stats" id="stats" hidden>
            <div class="stat"><dt>{units} tried</dt><dd id="st-tried"></dd></div>
            <div class="stat" id="st-due-box"><dt>to retest today</dt><dd id="st-due"></dd></div>
            <div class="stat" id="st-pass-box" hidden><dt>passages done</dt><dd><span id="st-pass"></span> <small id="st-pass-of"></small></dd></div>
          </dl>
          <a class="hero-reward rw" id="first-card" hidden data-tier="b" data-slug={tiers[0].cookie.slug} data-rarity={tiers[0].cookie.rarity} href={`/cookie/${tiers[0].cookie.slug}/`} style={`--rc: var(--r-${tiers[0].cookie.rarity})`}>
            <img class="rw-img" src={tiers[0].cookie.image} alt="" width="84" height="84" />
            <span><small class="rw-label">Your first card, at {at[0]} right</small><b class="rw-name">{tiers[0].cookie.name}</b><small class="rw-rarity">{tiers[0].rarity}</small></span>
          </a>
        </div>

        <section class="panel track" aria-labelledby="tr-h">
          <h2 id="tr-h">Your cards</h2>
          <p class="track-sub">Real past-paper {units}, easier ones first. Each one you get right moves you along.</p>
          <ol class="trail" id="trail">
            {tiers.map((t) => (
              <>
                <li class="seg" aria-hidden="true"><span style="width:0%"></span></li>
                <li class="stop rw" data-tier={t.k} data-name={t.name} data-slug={t.cookie.slug} data-rarity={t.cookie.rarity} style={`--rc: var(--r-${t.cookie.rarity})`}>
                  <a class="stop-pic" href={`/cookie/${t.cookie.slug}/`} aria-label={`${t.name}: ${t.cookie.name}`}><img class="rw-img" src={t.cookie.image} alt="" width="84" height="84" loading="lazy" /></a>
                  <span class="badge" hidden set:html={TICK_SVG} />
                  <span class="stop-label">
                    <span class="stop-name">{t.name}</span>
                    <span class="stop-state">at {t.at} right</span>
                    <span class="stop-card"><span class="rw-name">{t.cookie.name}</span> <i class="rw-rarity">{t.rarity}</i></span>
                  </span>
                </li>
              </>
            ))}
          </ol>
          <p class="after" id="after" hidden><b>All three cards earned.</b> Every {cloze ? 'blank' : 'question'} you get right still counts.</p>
        </section>

        <details class="how"><summary>How a {cloze ? 'blank' : 'question'} counts</summary>
          <p>A {cloze ? 'blank' : 'question'} counts when you answer it right, the first time or when it comes back the next day. A wrong answer comes back the next day. {sub.poolAll ? `The first ${pool} of the ${sub.poolAll.toLocaleString('en')} past-paper ${units} count toward your cards.` : ''} You can train up to {tries} times a day.</p>
        </details>
      </>
    ) : (
      <>
        <div class="panel hero" id="c-hero">
          <div>
            <p class="next-tag" id="c-tag">Next to train</p>
            <p class="next-tier" id="c-name">Basic</p>
            <div class="mastery" id="c-mastery">
              <div class="mbar" role="img" id="c-bar"><span style="width:0%"></span></div>
              <p id="c-mtext"></p>
            </div>
            <a class="go" id="go">Start quiz</a>
            <p class="go-note" id="go-note"></p>
            <p class="cap" id="cap" role="status" hidden></p>
          </div>
          <a class="hero-reward rw" id="c-reward" data-tier="b" data-slug={tiers[0].cookie.slug} data-rarity={tiers[0].cookie.rarity} href={`/cookie/${tiers[0].cookie.slug}/`} style={`--rc: var(--r-${tiers[0].cookie.rarity})`}>
            <img class="rw-img" src={tiers[0].cookie.image} alt="" width="84" height="84" />
            <span><small class="rw-label">Clear Basic for</small><b class="rw-name">{tiers[0].cookie.name}</b><small class="rw-rarity">{tiers[0].rarity}</small></span>
          </a>
        </div>

        <h2 class="tiers-h">All three tiers</h2>
        <div class="tiers">
          {tiers.map((t) => (
            <article class="tier rw" data-tier={t.k} data-slug={t.cookie.slug} data-count={String(t.count)} data-hash={t.hash} data-playable={String(t.playable)}
              data-name={t.name} data-rarity={t.cookie.rarity} style={`--rc: var(--r-${t.cookie.rarity})`}>
              <a class="t-pic" href={`/cookie/${t.cookie.slug}/`} aria-label={t.cookie.name}><img class="rw-img" src={t.cookie.image} alt="" width="56" height="56" loading="lazy" /></a>
              <h3>{t.name}</h3>
              <p class="t-card"><span class="rw-label">Reward card:</span> <span class="rw-name">{t.cookie.name}</span> <i class="rw-rarity">{t.rarity}</i></p>
              <p class="t-state">{t.playable ? '' : `Questions coming soon (needs at least ${MIN_POOL}).`}</p>
              {t.playable && <a class="t-act" hidden href={`/quiz/?sub=${encodeURIComponent(sub.id)}&tier=${t.k}`}>Practise again</a>}
            </article>
          ))}
        </div>

        <details class="how"><summary>How a tier clears</summary>
          <p>Each quiz has up to 10 questions. A question is mastered when you answer it right the first time, or right again after its retests (1, 3 and 7 days after a wrong answer). Master every question in a tier to clear it and earn its card. Clear a tier to open the next one. You can try each tier up to {tries} times a day.</p>
        </details>
      </>
    )}
  </section>
</Base>

<script>
  import { load, tierState, triesUsedUp, attemptsLeft, dayBlock, blockMessage, minutesFor, actualReward, liveMastered, poolProgress,
    slotCard, isDue, milestoneAt, MIN_POOL, TIERS, TIER_NAME, MILESTONE_NAME, type Tier } from '../../../lib/store';
  import { sectionBoxes, sectionStarted, finishLine, previewSlots, nextGoal, goalFlags, tierFlags, trailFill, nextTier, retestNote, triesNote, tierBelow, rarityLabel, TICK_SVG } from '../../../lib/section';
  import { esc } from '../../../lib/boldans';
  import { toEconomy, type EconomyData } from '../../../lib/crumbs';

  const s = load();
  const root = document.querySelector<HTMLElement>('.sub-page')!;
  const sub = root.dataset.sub!;
  const tries = Number(root.dataset.tries);
  const pool = Number(root.dataset.pool) || 0;
  const units = root.dataset.units!;
  const cloze = !!root.dataset.cloze;
  let at: number[] = (root.dataset.at ?? '').split(',').map(Number); // the stop thresholds, parsed once (the pool branch re-sets them from the stored total)
  const reason = dayBlock(s, 'tier');
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const go = $<HTMLAnchorElement>('go');
  const disable = (msg: string) => {
    go.setAttribute('aria-disabled', 'true'); go.removeAttribute('href');
    $('go-note').hidden = true;
    const cap = $('cap'); cap.textContent = msg; cap.hidden = false;
  };
  /** Note under Start: retests (once known) and tries left. */
  let triesText = '', retestText = '';
  const setNote = () => {
    const html = [retestText.replace(/(\d+ retests?)/, '<b>$1</b>'), esc(triesText)].filter(Boolean).join(' ');
    $('go-note').innerHTML = html;
  };

  // ---------------------------------------------------------------- rewards (cards shown on stops, tiers and the hero)
  // A cleared slot never pays again: it shows the card it gave. Otherwise the reward now: a new card or +1 star and Crumbs.
  // `rarity` is the CSS token (data-rarity on the markup, "super-epic"); the label is made from it when painting.
  // noCard: a cleared slot whose card this save cannot name (the clear paid a star, or the card is not known yet): shown as
  // "Cleared ✓" with no card, never the slot card it did not give
  type Shown = { slug: string; name: string; image: string; rarity: string; kind: 'earned' | 'card' | 'star'; replaces?: string; crumbs?: number; noCard?: boolean };
  const rw = new Map<Tier, Shown>();
  for (const el of root.querySelectorAll<HTMLElement>('.rw')) {
    const t = el.dataset.tier as Tier;
    if (rw.has(t)) continue;
    const slug = el.dataset.slug!;
    const cleared = tierState(s, sub, t).cleared;
    rw.set(t, { slug, name: el.querySelector('.rw-name')!.textContent!, image: el.querySelector<HTMLImageElement>('.rw-img')!.getAttribute('src')!,
      rarity: el.dataset.rarity!, kind: cleared ? 'earned' : actualReward(s, slug) === 'star' ? 'star' : 'card',
      ...(cleared && slotCard(s, sub, t) !== slug ? { noCard: true } : {}) });
  }
  /** Called once the economy data has arrived (the pool page re-words its "next" line then). */
  let onEco: (() => void) | null = null;
  const reward = (r: Shown) => (r.kind === 'star' ? `+1 star${r.crumbs ? ` and +${r.crumbs} Crumbs` : ''}` : '');
  /** The small label above a card name: it depends on the element (tier row, hero) and on what a clear gives now. */
  const labelFor = (el: HTMLElement, r: Shown, t: Tier) => {
    if (el.classList.contains('tier')) {
      return r.kind === 'earned' ? (r.noCard ? 'Cleared ✓' : 'Earned:') : r.kind === 'star' ? `Reward: ${reward(r)} for`
        : r.replaces ? `Reward card (you already have ${r.replaces}):` : 'Reward card:';
    }
    if (el.id === 'first-card') {
      const need = at[TIERS.indexOf(t)];
      return r.kind === 'star' ? `Your first reward, ${reward(r)}, at ${need} right`
        : r.replaces ? `Your first card, at ${need} right (you already have ${r.replaces})` : `Your first card, at ${need} right`;
    }
    const name = TIER_NAME[t]; // the classic hero
    return r.kind === 'star' ? `Clear ${name} for ${reward(r)} on` : r.replaces ? `Clear ${name} for (you already have ${r.replaces})` : `Clear ${name} for`;
  };
  const paintCards = () => {
    for (const el of root.querySelectorAll<HTMLElement>('.rw')) {
      const t = el.dataset.tier as Tier;
      const r = rw.get(t)!;
      el.dataset.rarity = r.rarity;
      el.style.setProperty('--rc', `var(--r-${r.rarity})`);
      const img = el.querySelector<HTMLImageElement>('.rw-img')!;
      if (img.getAttribute('src') !== r.image) img.src = r.image;
      el.querySelectorAll<HTMLAnchorElement>('a[href^="/cookie/"]').forEach((a) => { a.href = `/cookie/${encodeURIComponent(r.slug)}/`; });
      if (el instanceof HTMLAnchorElement) el.href = `/cookie/${encodeURIComponent(r.slug)}/`;
      // the picture links carry their own label, fixed at build time for the slot card: keep it in step with the card shown
      el.querySelector('.stop-pic, .t-pic')?.setAttribute('aria-label', el.classList.contains('stop') ? `${el.dataset.name}: ${r.name}` : r.name);
      const none = r.kind === 'earned' && !!r.noCard;
      el.querySelector('.rw-name')!.textContent = none ? '' : r.name;
      el.querySelector('.rw-rarity')!.textContent = none ? '' : el.classList.contains('hero-reward') ? `${rarityLabel(r.rarity)} card` : rarityLabel(r.rarity);
      img.style.visibility = none ? 'hidden' : '';
      if (el.classList.contains('stop')) {
        const i = TIERS.indexOf(t);
        el.querySelector('.stop-state')!.textContent = el.hasAttribute('data-reached') ? (none ? 'Cleared ✓' : 'Earned') : `at ${at[i]} right`;
      }
      const label = el.querySelector('.rw-label');
      if (label) label.textContent = labelFor(el, r, t);
    }
  };

  if (pool) {
    // ---------------------------------------------------------------- one pool (ADR 0011): the count, the stops, one Start
    const pp = poolProgress(s, sub), total = pp.total || pool, n = pp.counted;
    // thresholds from the same total as the count (the stored pool size), not the build's
    at = milestoneAt(total);
    root.dataset.at = at.join(',');
    const poolAll = Number(root.dataset.poolAll) || 0;
    $('pool-n').textContent = String(n);
    $('pool-total').textContent = String(total);
    root.querySelector('.big')!.setAttribute('aria-label', `${n} of ${total} ${units} right`);
    // the stops reached: the 1st and 2nd count an old generated-tier clear, Exam-ready only the pool's own milestone
    const reached = goalFlags(s, sub);
    const goal = nextGoal(n, at, reached);
    const nextLine = () => {
      const el = $('next-line');
      if (!goal) {
        const left = Math.max(0, total - n);
        el.innerHTML = `<b>Exam-ready.</b> You can keep practising: ${left} ${units} left to get right${poolAll > total ? `, and ${(poolAll - total).toLocaleString('en')} more past-paper ${units} after that.` : '.'}`;
        return;
      }
      const t = TIERS[goal.i], r = rw.get(t)!, more = `<strong>${goal.need} more right</strong>`;
      if (goal.need === 0) el.innerHTML = finishLine(t);
      else if (n === 0 && goal.i === 0 && r.kind === 'card') el.innerHTML = `Get <strong>${at[0]} right</strong> for your first card. Easier ${units} come first.`;
      else if (r.kind === 'card') el.innerHTML = `${more} for your ${goal.i < 2 ? MILESTONE_NAME[t] : 'Exam-ready card'}, ${esc(r.name)}.`;
      else if (r.kind === 'star') el.innerHTML = `${more} for +1 star on ${esc(r.name)}.`;
      else el.innerHTML = `${more} to reach ${MILESTONE_NAME[t]}.`; // the slot was cleared before: no card to name
    };
    onEco = nextLine;
    // the trail: one bar from 0 to the Exam-ready stop
    const fills = trailFill(n, at);
    root.querySelectorAll<HTMLElement>('.trail .seg > span').forEach((el, i) => { el.style.width = `${fills[i]}%`; });
    root.querySelectorAll<HTMLElement>('.trail .stop').forEach((el, i) => {
      if (!reached[i]) return;
      el.dataset.reached = ''; // paintCards words the state (Earned / Cleared) and keeps it in step with the card shown
      el.querySelector<HTMLElement>('.badge')!.hidden = false;
    });
    $('trail').setAttribute('aria-label', `Cards: ${reached.filter(Boolean).length} of 3 earned`);
    $('after').hidden = !reached.every(Boolean);
    const started = sectionStarted(s, sub, n);
    $('first-card').hidden = started;
    root.querySelector('.hero')!.classList.toggle('has-side', !started);
    nextLine();
    paintCards();

    const block = triesUsedUp(s, sub) ? `You have trained ${tries} times on this section today. Come back tomorrow.` : reason ? blockMessage(reason, s) : '';
    if (block) disable(block);
    else { triesText = triesNote(attemptsLeft(s, sub), tries); setNote(); }

    // the small numbers are read from the save (store.ts poolDisplay wrote them when the last quiz ended): no fetch, no cache.
    // A section not played since they were added has none, and its boxes stay hidden. "To retest" is checked against the
    // live states, so a Daily Review that cleared a retest shows at once.
    const box = sectionBoxes(s, sub);
    if (started && box) {
      $('st-tried').textContent = String(box.tried);
      $('st-due-box').hidden = box.due === null;
      if (box.due !== null) { $('st-due').textContent = String(box.due); $('st-due-box').classList.add(box.due ? 'hot' : 'quiet'); }
      if (box.passages) { $('st-pass').textContent = String(box.passages.done); $('st-pass-of').textContent = `of ${box.passages.total}`; $('st-pass-box').hidden = false; }
      const n3 = 1 + (box.due !== null ? 1 : 0) + (box.passages ? 1 : 0);
      $('stats').style.setProperty('--n', String(n3));
      $('stats').hidden = false;
      root.querySelector('.hero')!.classList.add('has-side');
      if (!block && box.due) {
        // a cloze quiz is one whole passage, the one holding the first due blank; else up to 3 due retests come first
        retestText = cloze ? 'Starts with a passage you have <b>to retest</b>.' : retestNote(box.due);
        setNote();
      }
    }
  } else {
    // ---------------------------------------------------------------- classic three tiers
    const cards = [...root.querySelectorAll<HTMLElement>('.tier')];
    const playable = Object.fromEntries(cards.map((c) => [c.dataset.tier, c.dataset.playable === 'true'])) as Record<Tier, boolean>;
    const { cleared, open } = tierFlags(s, sub, playable);
    const mastered = (t: Tier) => {
      const c = cards[TIERS.indexOf(t)];
      const count = Number(c.dataset.count);
      return { m: liveMastered(tierState(s, sub, t), count, c.dataset.hash), count };
    };
    const nt = nextTier(cleared, playable, open);
    const lastPlayable = [...TIERS].reverse().find((t) => playable[t]);
    const heroTier = nt ?? lastPlayable;
    const href = (t: Tier) => `/quiz/?sub=${encodeURIComponent(sub)}&tier=${t}`;
    for (const c of cards) {
      const t = c.dataset.tier as Tier;
      const state = c.querySelector('.t-state')!;
      const act = c.querySelector<HTMLAnchorElement>('.t-act');
      if (!playable[t]) { c.dataset.state = 'locked'; continue; }
      const { m, count } = mastered(t);
      if (cleared[t]) {
        c.dataset.state = 'cleared';
        state.innerHTML = `${TICK_SVG} Cleared. ${slotCard(s, sub, t) ? 'Card earned.' : 'Every question mastered.'}`;
        if (act) act.hidden = false;
      } else if (!open[t]) {
        c.dataset.state = 'locked';
        state.innerHTML = `<svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16"><rect x="5" y="11" width="14" height="10" rx="2" fill="currentColor"/><path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2.4"/></svg> Clear ${TIER_NAME[tierBelow(t, playable) ?? 'b']} first.`;
      } else if (t === nt) {
        c.dataset.state = 'next';
        state.textContent = `${m ? `${m} of ${count} mastered. ` : ''}Next to train.`;
      } else { // open, not next (the unlimited test account opens every tier)
        c.dataset.state = 'open';
        state.textContent = m ? `${m} of ${count} mastered.` : 'Open.';
        if (act) { act.textContent = `Start ${TIER_NAME[t]}`; act.hidden = false; }
      }
      // a Start / Practise link is dead while the day's limit or this tier's tries are used up, with the reason in the row
      const stop = triesUsedUp(s, sub, t) ? `You have had ${tries} tries at this tier today. Try again tomorrow.` : reason ? blockMessage(reason, s) : '';
      if (stop && act && !act.hidden) { act.setAttribute('aria-disabled', 'true'); act.removeAttribute('href'); state.textContent = stop; }
    }
    // the hero: the tier to train next, its mastery, Start and its card
    const heroReward = $('c-reward');
    if (!heroTier) {
      $('c-tag').textContent = 'Coming soon';
      $('c-name').textContent = 'No questions yet';
      $('c-mastery').hidden = true;
      heroReward.hidden = true;
      go.textContent = 'Start quiz';
      disable(`Questions are coming soon (a tier needs at least ${MIN_POOL}).`);
    } else {
      const { m, count } = mastered(heroTier);
      const allDone = !nt;
      const name = TIER_NAME[heroTier];
      $('c-tag').textContent = allDone ? 'Every tier cleared' : 'Next to train';
      $('c-name').textContent = name;
      // the real mastered count either way: a perfect first try clears a tier with most questions still unanswered
      root.querySelector<HTMLElement>('#c-bar > span')!.style.width = `${count ? Math.min(100, (100 * m) / count) : 0}%`;
      $('c-bar').setAttribute('aria-label', `${m} of ${count} mastered`);
      $('c-mtext').innerHTML = allDone ? `<b>Cleared.</b> ${m} of ${count} questions mastered. You can keep practising.` : `<b>${m} of ${count}</b> questions mastered. Master all ${count} to clear it.`;
      go.href = href(heroTier);
      go.textContent = allDone ? `Practise ${name} again` : `Start ${name} quiz`;
      // the hero card is the card of the tier to train; it moves with the tier (the reward map is keyed by tier)
      heroReward.dataset.tier = heroTier;
      heroReward.hidden = allDone; // its label is painted by paintCards (and again once the economy data arrives)
      const block = triesUsedUp(s, sub, heroTier) ? `You have had ${tries} tries at this tier today. Try again tomorrow.` : reason ? blockMessage(reason, s) : '';
      if (block) disable(block);
      else {
        triesText = [triesNote(attemptsLeft(s, sub, heroTier), tries), `About ${minutesFor(s, heroTier)} minutes.`].filter(Boolean).join(' ');
        setNote();
        // due retests from this section's generated bank (a public static file), after first paint; a failure hides the count
        const file = root.dataset.file;
        if (file && !allDone) requestAnimationFrame(() => setTimeout(() => {
          fetch(`/data/quiz/${file}.json`).then((r) => (r.ok ? r.json() : null)).then((bank: { id: string; sub: string }[] | null) => {
            if (!Array.isArray(bank)) return;
            const cur = load();
            const due = bank.filter((q) => q.sub === sub && isDue(cur, q.id, Date.now(), true)).length;
            retestText = retestNote(due);
            setNote();
          }).catch(() => {});
        }, 0));
      }
    }
    paintCards();
  }

  // The exact card a clear gives now (crumbs.ts rewardPreview, the same rule store.ts awards by): the slot card, or the
  // next unowned card of its rarity when the slot card is owned, or a star plus Crumbs when none is left.
  fetch('/data/economy.json').then((r) => (r.ok ? r.json() : null)).then((d: EconomyData | null) => {
    if (!d) return;
    const eco = toEconomy(d);
    // in slot order, each unearned slot previewed with the cards of the earlier ones counted as owned (two slots of one
    // rarity must not both promise the same replacement)
    const order = TIERS.filter((t) => rw.has(t));
    const prev = previewSlots(s, order.map((t) => ({ slug: rw.get(t)!.slug, earned: rw.get(t)!.kind === 'earned' })), eco);
    order.forEach((t, k) => {
      const r = rw.get(t)!, p = prev[k];
      let slug: string;
      if (!p) { const got = slotCard(s, sub, t); if (!got) return; if (got === r.slug) { r.noCard = false; return; } slug = got; }
      else { slug = p.slug; r.kind = p.kind; r.crumbs = p.kind === 'star' ? p.crumbs : undefined; r.replaces = p.kind === 'card' && p.replaces ? (d.cards[p.replaces]?.name ?? r.name) : undefined; }
      const c = d.cards[slug];
      if (!c) return;
      Object.assign(r, { slug, name: c.name, image: c.image, rarity: c.rarity });
      if (r.kind === 'earned') r.noCard = false;
    });
    paintCards();
    onEco?.();
  }).catch(() => { /* offline: the cards above (slot card or star) still hold */ });
</script>

