---
import Base from '../../../layouts/Base.astro';
import { SCHOOLS, subs, subSlug, slots, cookieBySlug, MIN_POOL } from '../../../lib/train';
import { TIER_MIN } from '../../../lib/store';

export function getStaticPaths() {
  return subs.map((s) => ({ params: { school: s.school, sub: subSlug(s.id) }, props: { sub: s } }));
}
const { sub } = Astro.props as { sub: (typeof subs)[number] };
const school = SCHOOLS.find((x) => x.id === sub.school)!;
const tiers = (['b', 'i', 'c'] as const).map((k) => {
  const slot = slots[`${sub.id}|${k}`];
  return { k, name: { b: 'Basic', i: 'Intermediate', c: 'Competent' }[k], slot, cookie: cookieBySlug.get(slot.slug)!,
    count: sub.count[k], playable: sub.playable[k], min: TIER_MIN[k] };
});
---
<Base title={`${sub.name} · ${school.name} training`} description={`Three tiers of PSLE ${school.name} practice on ${sub.name}.`}>
  <section class="wrap sub-page" data-sub={sub.id}>
    <p class="crumbs"><a href="/train/">Schools</a> › <a href={`/train/${school.id}/`}>{school.name}</a> › {sub.topicName}</p>
    <h1>{sub.name}</h1>
    <p class="rules">Each quiz has up to 10 questions. Score 8 out of 10 on two quizzes, on two different days, to clear a tier and earn its card. Clear a tier to open the next one.</p>
    <p id="cap" class="cap" hidden>Done for today! You have reached today's training time. Come back tomorrow.</p>

    <div class="tiers">
      {tiers.map((t) => (
        <article class="tier-card" data-tier={t.k} data-playable={String(t.playable)} data-slug={t.cookie.slug}>
          <h2>{t.name}</h2>
          <a class="reward" href={`/cookie/${t.cookie.slug}/`} style={`--rc: var(--r-${t.cookie.rarity})`}>
            <img src={t.cookie.image} alt="" width="96" height="96" loading="lazy" />
            <span>
              <span class="reward-label">{t.slot.dup ? 'Reward: +1 star for' : 'Reward card'}</span>
              <span class="reward-name">{t.cookie.name}</span>
              <span class="reward-rarity">{t.cookie.rarity.replace('-', ' ')}</span>
            </span>
          </a>
          <p class="meta">{t.min} minutes · {t.count} questions in the bank</p>
          <p class="state" aria-live="polite">{t.playable ? '' : `Questions coming soon (needs at least ${MIN_POOL}).`}</p>
          {t.playable && <a class="start" href={`/quiz/?sub=${encodeURIComponent(sub.id)}&tier=${t.k}`}>Start {t.name} quiz</a>}
        </article>
      ))}
    </div>
  </section>
</Base>

<script>
  import { load, tierState, tierOpen, attemptsToday, capReached, minutesFor, actualReward, ATTEMPTS_PER_DAY, type Tier } from '../../../lib/store';
  const s = load();
  const root = document.querySelector<HTMLElement>('.sub-page')!;
  const sub = root.dataset.sub!;
  const cap = capReached(s);
  const playable = Object.fromEntries([...root.querySelectorAll<HTMLElement>('.tier-card')].map((c) => [c.dataset.tier, c.dataset.playable === 'true'])) as Record<Tier, boolean>;
  document.getElementById('cap')!.hidden = !cap;
  root.querySelectorAll<HTMLElement>('.tier-card').forEach((card) => {
    // the preview always matches the real reward: a star only if the card is already owned
    card.querySelector('.reward-label')!.textContent = actualReward(s, card.dataset.slug!) === 'star' ? 'Reward: +1 star for' : 'Reward card';
    if (card.dataset.playable !== 'true') return;
    const t = card.dataset.tier as Tier;
    const st = tierState(s, sub, t);
    const start = card.querySelector<HTMLAnchorElement>('.start')!;
    const msg = card.querySelector('.state')!;
    card.querySelector('.meta')!.textContent = card.querySelector('.meta')!.textContent!.replace(/^\d+(\.\d+)? minutes/, `${minutesFor(s, t)} minutes`);
    let block = '';
    if (st.cleared) msg.textContent = `Cleared ✓ (best ${st.best}%). You can keep practising.`;
    else if (!tierOpen(s, sub, t, playable)) block = `Clear ${t === 'i' ? 'Basic' : 'Intermediate'} first.`;
    else msg.textContent = st.passes.length ? `1 of 2 passes (best ${st.best}%). Pass again on another day.` : st.best ? `Best so far: ${st.best}%. Not yet, keep going!` : 'Ready when you are.';
    if (!block && attemptsToday(s, sub, t) >= ATTEMPTS_PER_DAY) block = 'You have had 3 tries at this tier today. Try again tomorrow.';
    if (!block && cap) block = 'Done for today.';
    if (block) { msg.textContent = block; start.setAttribute('aria-disabled', 'true'); start.removeAttribute('href'); }
  });
</script>

<style>
  .sub-page { padding-block: 1.5rem 2rem; }
  .crumbs { margin: 0; font-size: 0.95rem; color: var(--cocoa-soft); }
  .rules { color: var(--cocoa-soft); max-width: 65ch; }
  .cap { color: var(--berry); font-weight: 600; }
  .tiers { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .tier-card { background: var(--paper); border: 1.5px solid var(--crust); border-radius: var(--radius-card); padding: 1rem 1.25rem; display: grid; gap: 0.5rem; align-content: start; }
  .tier-card[data-playable='false'] { opacity: 0.65; }
  .tier-card h2 { margin: 0; }
  .reward { display: flex; gap: 0.75rem; align-items: center; color: var(--cocoa); text-decoration: none; }
  .reward img { width: 72px; height: 72px; object-fit: contain; background: var(--plate); border-radius: 50%; box-shadow: 0 0 0 3px var(--rc); }
  .reward > span { display: grid; }
  .reward-label, .reward-rarity { font-size: 0.85rem; color: var(--cocoa-soft); text-transform: capitalize; }
  .reward-name { font: 600 1.05rem var(--font-display); }
  .meta, .state { margin: 0; font-size: 0.95rem; }
  .state { color: var(--cocoa-soft); }
  .start {
    justify-self: start; font: 600 1rem var(--font-display); background: var(--berry); color: var(--berry-ink);
    border-radius: var(--radius-control); padding: 0.5rem 1rem; min-height: 44px; display: inline-flex; align-items: center; text-decoration: none;
  }
  .start[aria-disabled='true'] { background: var(--crust); color: var(--cocoa-soft); cursor: not-allowed; }
</style>
