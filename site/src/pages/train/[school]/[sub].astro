---
import Base from '../../../layouts/Base.astro';
import { SCHOOLS, subs, subSlug, slots, cookieBySlug, MIN_POOL, listGroup } from '../../../lib/train';
import { TIER_MIN, triesPerDay, milestoneAt } from '../../../lib/store';

export function getStaticPaths() {
  return subs.map((s) => ({ params: { school: s.school, sub: subSlug(s.id) }, props: { sub: s } }));
}
const { sub } = Astro.props as { sub: (typeof subs)[number] };
const tries = triesPerDay(sub.id);
const school = SCHOOLS.find((x) => x.id === sub.school)!;
// a one-pool sub-topic (ADR 0011): one pool of past-paper questions, the three card slots are milestones
const pool = sub.pool ?? 0;
const at = milestoneAt(pool);
const tiers = (['b', 'i', 'c'] as const).map((k, n) => {
  const slot = slots[`${sub.id}|${k}`];
  return { k, name: pool ? { b: 'Milestone 1', i: 'Milestone 2', c: 'Exam-ready' }[k] : { b: 'Basic', i: 'Intermediate', c: 'Competent' }[k],
    slot, cookie: cookieBySlug.get(slot.slug)!, at: at[n],
    count: pool || sub.count[k], hash: pool ? undefined : sub.hash[k], playable: pool ? true : sub.playable[k], min: TIER_MIN[k] };
});
---
<Base title={`${sub.name} · ${school.name} training`} description={`Three tiers of PSLE ${school.name} practice on ${sub.name}.`}>
  <section class="wrap sub-page" data-sub={sub.id} data-tries={tries} data-pool={String(pool)}>
    <p class="crumbs"><a href="/train/">Schools</a> › <a href={`/train/${school.id}/`}>{school.name}</a> › {listGroup(sub).topicName}</p>
    <h1>{sub.name}</h1>
    {pool ? (
      <p class="rules">{pool} real past-paper questions, easier ones first. A question counts when you answer it right, the first time or when it comes back the next day. Count {at[0]} for your first card, {at[1]} for the second, and more than half ({at[2]}) to be Exam-ready. You can train up to {tries} times a day.</p>
    ) : (
      <p class="rules">Each quiz has up to 10 questions. Master every question in a tier to clear it and earn its card. A question is mastered when you answer it right the first time, or right again after its retests. You can try each tier up to {tries} times a day. Clear a tier to open the next one.</p>
    )}
    <p id="cap" class="cap" hidden>Done for today! You have reached today's training time. Come back tomorrow.</p>
    {pool > 0 && (
      <div class="pool-panel">
        <p class="pool-count" aria-live="polite"><strong id="pool-n">0</strong> of {pool} past-paper questions counted</p>
        <div class="pool-bar" role="img" aria-label="Progress toward the milestones">
          <span class="pool-fill" style="width: 0%"></span>
          {at.map((a, n) => <span class="pool-mark" style={`left: ${(100 * a) / pool}%`} title={tiers[n].name}></span>)}
        </div>
        <p class="pool-state" aria-live="polite"></p>
        <a class="start pool-start" href={`/quiz/?sub=${encodeURIComponent(sub.id)}`}>Train with past papers</a>
      </div>
    )}

    <div class="tiers">
      {tiers.map((t) => (
        <article class="tier-card" data-tier={t.k} data-count={String(t.count)} data-hash={t.hash} data-playable={String(t.playable)} data-slug={t.cookie.slug}>
          <h2>{t.name}</h2>
          <p class="tier-help">{pool ? `At ${t.at} of ${pool} counted.` : { b: 'The main ideas, step by step.', i: 'Trickier, mixed questions.', c: 'The hardest, exam-style questions.' }[t.k]}</p>
          <a class="reward" href={`/cookie/${t.cookie.slug}/`} style={`--rc: var(--r-${t.cookie.rarity})`}>
            <img src={t.cookie.image} alt="" width="96" height="96" loading="lazy" />
            <span>
              <span class="reward-label">{t.slot.dup ? 'Reward: +1 star for' : 'Reward card'}</span>
              <span class="reward-name">{t.cookie.name}</span>
              <span class="reward-rarity">{t.cookie.rarity.replace('-', ' ')}</span>
            </span>
          </a>
          {!pool && <p class="meta">{t.min} minutes · {t.count} questions in the bank</p>}
          <p class="state" aria-live="polite">{t.playable ? '' : `Questions coming soon (needs at least ${MIN_POOL}).`}</p>
          {t.playable && !pool && <a class="start" href={`/quiz/?sub=${encodeURIComponent(sub.id)}&tier=${t.k}`}>Start {t.name} quiz</a>}
        </article>
      ))}
    </div>
  </section>
</Base>

<script>
  import { load, tierState, tierOpen, triesUsedUp, dayBlock, blockMessage, minutesFor, actualReward, liveMastered, poolProgress, milestoneReached, slotCard, type Tier } from '../../../lib/store';
  import { rewardPreview, toEconomy, type EconomyData } from '../../../lib/crumbs';
  const s = load();
  /** A cleared slot never pays again: "Earned:" when it gave this card, "Cleared ✓" when it gave a star or a replacement
   * (the economy fetch below swaps a replacement in); null for a slot not cleared. */
  const paidLabel = (card: HTMLElement) => {
    const t = card.dataset.tier as Tier;
    if (!tierState(s, sub, t).cleared) return null;
    return slotCard(s, sub, t) === card.dataset.slug ? 'Earned:' : 'Cleared ✓';
  };
  const root = document.querySelector<HTMLElement>('.sub-page')!;
  const sub = root.dataset.sub!;
  const tries = Number(root.dataset.tries);
  const reason = dayBlock(s, 'tier');
  const playable = Object.fromEntries([...root.querySelectorAll<HTMLElement>('.tier-card')].map((c) => [c.dataset.tier, c.dataset.playable === 'true'])) as Record<Tier, boolean>;
  const capEl = document.getElementById('cap')!;
  capEl.hidden = !reason;
  if (reason) capEl.textContent = blockMessage(reason);
  const pool = Number(root.dataset.pool) || 0;
  if (pool) { // one pool (ADR 0011): the counted share, each milestone's state, one Train button
    // syncMilestones stores the count and the live pool size on every slot; the build-time size may differ slightly
    const pp = poolProgress(s, sub), total = pp.total || pool, counted = pp.counted;
    document.getElementById('pool-n')!.textContent = String(counted);
    root.querySelector('.pool-count')!.lastChild!.textContent = ` of ${total} past-paper questions counted`;
    root.querySelector<HTMLElement>('.pool-fill')!.style.width = `${Math.min(100, (100 * counted) / total)}%`;
    root.querySelectorAll<HTMLElement>('.tier-card').forEach((card) => {
      card.querySelector('.reward-label')!.textContent = paidLabel(card) // cleared (before the pool, or by its milestone)
        ?? (actualReward(s, card.dataset.slug!) === 'star' ? 'Reward: +1 star for' : 'Reward card');
      if (milestoneReached(s, sub, card.dataset.tier as Tier)) { card.dataset.state = 'cleared'; card.querySelector('.state')!.textContent = 'Reached ✓'; }
    });
    const start = root.querySelector<HTMLAnchorElement>('.pool-start')!;
    const block = triesUsedUp(s, sub) ? `You have trained ${tries} times on this topic today. Come back tomorrow.` : reason ? blockMessage(reason) : '';
    root.querySelector('.pool-state')!.textContent = block || (milestoneReached(s, sub, 'c') ? 'Exam-ready ✓ Keep practising to count them all.' : 'Ready when you are.');
    if (block) { start.setAttribute('aria-disabled', 'true'); start.removeAttribute('href'); }
  }
  if (!pool) root.querySelectorAll<HTMLElement>('.tier-card').forEach((card) => {
    // the preview always matches the real reward: a star only if the card is already owned; a cleared tier never pays again
    card.querySelector('.reward-label')!.textContent = paidLabel(card)
      ?? (actualReward(s, card.dataset.slug!) === 'star' ? 'Reward: +1 star for' : 'Reward card');
    if (card.dataset.playable !== 'true') return;
    const t = card.dataset.tier as Tier;
    const st = tierState(s, sub, t);
    const start = card.querySelector<HTMLAnchorElement>('.start')!;
    const msg = card.querySelector('.state')!;
    card.querySelector('.meta')!.textContent = card.querySelector('.meta')!.textContent!.replace(/^\d+(\.\d+)? minutes/, `${minutesFor(s, t)} minutes`);
    let block = '';
    if (st.cleared) { msg.textContent = `Cleared ✓ Every question mastered. You can keep practising.`; card.dataset.state = 'cleared'; }
    else if (!tierOpen(s, sub, t, playable)) block = `Clear ${t === 'i' ? 'Basic' : 'Intermediate'} first.`;
    else { const n = card.dataset.count ? Number(card.dataset.count) : undefined; const m = liveMastered(st, n, card.dataset.hash); msg.textContent = m ? `${m} of ${n} questions mastered. Keep going!` : 'Ready when you are.'; }
    if (!block && triesUsedUp(s, sub, t)) block = `You have had ${tries} tries at this tier today. Try again tomorrow.`;
    if (!block && reason) block = blockMessage(reason);
    if (block) { msg.textContent = block; start.setAttribute('aria-disabled', 'true'); start.removeAttribute('href'); }
  });

  // The exact card a clear gives now (crumbs.ts rewardPreview, the same rule store.ts awards by): the slot card, or the
  // next unowned card of its rarity when the slot card is owned, or a star plus Crumbs when none is left.
  fetch('/data/economy.json').then((r) => (r.ok ? r.json() : null)).then((d: EconomyData | null) => {
    if (!d) return;
    const eco = toEconomy(d);
    root.querySelectorAll<HTMLElement>('.tier-card').forEach((card) => {
      const t = card.dataset.tier as Tier;
      let slug: string, label: string;
      if (tierState(s, sub, t).cleared) { // never pays again: show the card this slot gave (a replacement, say)
        const got = slotCard(s, sub, t);
        if (!got || got === card.dataset.slug) return; // its own card (labelled above) or a star: nothing to swap
        slug = got; label = 'Earned:';
      } else {
        const p = rewardPreview(s, card.dataset.slug!, eco);
        slug = p.slug;
        label = p.kind === 'star' ? `Reward: +1 star and +${p.crumbs} Crumbs for`
          : p.replaces ? `Reward card (you already have ${d.cards[p.replaces]?.name ?? 'this tier\'s card'})` : 'Reward card';
      }
      const c = d.cards[slug];
      if (!c) return;
      const a = card.querySelector<HTMLAnchorElement>('.reward')!;
      a.href = `/cookie/${encodeURIComponent(slug)}/`;
      a.style.setProperty('--rc', `var(--r-${c.rarity})`);
      a.querySelector('img')!.src = c.image;
      a.querySelector('.reward-name')!.textContent = c.name;
      a.querySelector('.reward-rarity')!.textContent = c.rarity.replace('-', ' ');
      a.querySelector('.reward-label')!.textContent = label;
    });
  }).catch(() => { /* offline: the label above (card or star) still holds */ });
</script>

<style>
  .sub-page { padding-block: 1.5rem 2rem; }
  .crumbs { margin: 0; font-size: 0.95rem; color: var(--cocoa-soft); }
  .rules { color: var(--cocoa-soft); max-width: 65ch; }
  .cap { color: var(--berry); font-weight: 600; }
  .tiers { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .tier-card { background: var(--paper); border: 1.5px solid var(--crust); border-radius: var(--radius-card); padding: 1rem 1.25rem; display: grid; gap: 0.5rem; align-content: start; }
  .tier-card[data-playable='false'] { opacity: 0.65; }
  .tier-card[data-state='cleared'] { border-color: #2e7d4f; }
  .tier-card[data-state='cleared'] .state { color: #1f6b3a; font-weight: 700; }
  .tier-card h2 { margin: 0; }
  .tier-help { margin: 0; font-size: 0.9rem; color: var(--cocoa-soft); }
  .reward { display: flex; gap: 0.75rem; align-items: center; color: var(--cocoa); text-decoration: none; }
  .reward img { width: 72px; height: 72px; object-fit: contain; background: var(--plate); border-radius: 50%; box-shadow: 0 0 0 3px var(--rc); }
  .reward > span { display: grid; }
  .reward-label, .reward-rarity { font-size: 0.85rem; color: var(--cocoa-soft); }
  .reward-rarity { text-transform: capitalize; } /* the label is a sentence (it can name the card you already have) */
  .reward-name { font: 600 1.05rem var(--font-display); }
  .meta, .state { margin: 0; font-size: 0.95rem; }
  .state { color: var(--cocoa-soft); }
  .start {
    justify-self: start; font: 600 1rem var(--font-display); background: var(--berry); color: var(--berry-ink);
    border-radius: var(--radius-control); padding: 0.5rem 1rem; min-height: 44px; display: inline-flex; align-items: center; text-decoration: none;
  }
  .start[aria-disabled='true'] { background: var(--crust); color: var(--cocoa-soft); cursor: not-allowed; }
  .pool-panel { background: var(--paper); border: 1.5px solid var(--crust); border-radius: var(--radius-card); padding: 1rem 1.25rem; margin-bottom: 1rem; display: grid; gap: 0.6rem; }
  .pool-count { margin: 0; font-size: 1.05rem; }
  .pool-bar { position: relative; height: 14px; background: var(--plate); border-radius: 999px; overflow: visible; }
  .pool-fill { position: absolute; inset: 0 auto 0 0; background: var(--berry); border-radius: 999px; }
  .pool-mark { position: absolute; top: -4px; bottom: -4px; width: 3px; margin-left: -1.5px; background: var(--cocoa); border-radius: 2px; }
  .pool-state { margin: 0; color: var(--cocoa-soft); }
</style>
