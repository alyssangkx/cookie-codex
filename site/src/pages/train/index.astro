---
import Base from '../../layouts/Base.astro';
import { SCHOOLS, subsOf, hasContent, unitName, banksHash } from '../../lib/train';

const schools = SCHOOLS.map((s) => {
  const list = subsOf(s.id);
  return { ...s, total: list.length, withQs: list.filter(hasContent).map((x) => x.id) };
});
---
<Base title="Schools of Mastery · PSLE training" description="Daily PSLE practice in four Schools of Mastery: Math, Science, English and Chinese.">
  <section class="wrap train-hub" data-banks={banksHash}>
    <h1>Schools of Mastery</h1>
    <p class="lede">Train every day, clear tiers and earn cookie cards. Each sub-topic has three tiers: Basic, Intermediate and Competent.</p>

    <section class="assigned" id="assigned" aria-labelledby="assigned-h" hidden>
      <h2 id="assigned-h">To do first: set by your parent (one 10-question quiz each)</h2>
      <ul id="assigned-list"></ul>
    </section>
    <div class="today-strip" id="today" aria-live="polite">
      <p><strong id="goal">Today: 0 of 2 quizzes</strong> · <span id="streak">No streak yet</span></p>
      <p class="goal-help" id="goal-help">Finish your quizzes each day to meet your daily goal.</p>
      <a id="review" class="btn-review" href="/quiz/?mode=review" hidden>Daily Review</a>
      <p id="done" class="done" hidden>Done for today! Come back tomorrow. You can still browse the Codex and your cards.</p>
    </div>

    <ul class="schools">
      {schools.map((s) => (
        <li class={`school ${s.ready ? '' : 'soon'}`}>
          <a href={`/train/${s.id}/`}>
            <span class="school-name">{s.name}</span>
            <span class="school-meta">
              {s.ready ? `${s.withQs.length} of ${s.total} ${unitName(s.id)} have questions` : `${s.total} ${unitName(s.id)} · questions coming soon`}
            </span>
            {s.ready && <span class="school-progress" data-subs={JSON.stringify(s.withQs)}></span>}
          </a>
        </li>
      ))}
    </ul>
    <p class="links"><a href="/paper/">Practice test paper</a><a href="/collection/">My cards</a><a href="/parent/">For parents</a></p>
  </section>
</Base>

<script>
  import { load, today, liveStreak, dayBlock, blockMessage, reviewDueCount, revisionDue, assignedPending, TIERS } from '../../lib/store';
    const s = load();
    // a parent's assignments come first until a quiz on each is finished (names set as text only)
    const todo = assignedPending(s); // links already limited to sub-topic pages (ASSIGN_HREF)
    if (todo.length) {
      const ul = document.getElementById('assigned-list')!;
      for (const a of todo) { const li = document.createElement('li'), link = document.createElement('a'); link.href = a.href; link.textContent = a.name || a.sub; li.append(link); ul.append(li); }
      document.getElementById('assigned')!.hidden = false;
    }
  const t = today(s);
  document.getElementById('goal')!.textContent =
    `Today: ${Math.min(t.quizzes, s.settings.dailyGoalQuizzes)} of ${s.settings.dailyGoalQuizzes} quizzes` +
    (t.quizzes >= s.settings.dailyGoalQuizzes ? ' ✓ goal met' : '');
  document.getElementById('goal-help')!.textContent = `Your daily goal is ${s.settings.dailyGoalQuizzes} quiz${s.settings.dailyGoalQuizzes === 1 ? '' : 'zes'} a day.`;
  const st = liveStreak(s);
  document.getElementById('streak')!.textContent = st ? `${st}-week streak` : 'Meet your goal on 4 days this week to start a streak';
  // counts states an older tab or build parked too (reviewDueCount): only Daily Review can re-check them
  const due = reviewDueCount(s, Date.now(), document.querySelector<HTMLElement>('.train-hub')!.dataset.banks);
  const review = document.getElementById('review') as HTMLAnchorElement;
  const rev = revisionDue(s, Date.now(), document.querySelector<HTMLElement>('.train-hub')!.dataset.banks).length; // a revision test from the parent goes first (the quiz page asks it on its own)
  if (due && !dayBlock(s, 'review')) { review.hidden = false; review.textContent = rev ? `Revision test from your parent (${rev})` : 'Daily Review'; } // the exact count (bank ids only) is on each school page and the quiz start screen
  const doneEl = document.getElementById('done')!;
  const reason = dayBlock(s, 'tier');
  doneEl.hidden = !reason;
  if (reason) doneEl.textContent = reason === 'time' ? `${blockMessage(reason, s)} You can still browse the Codex and your cards.` : blockMessage(reason, s);
  document.querySelectorAll<HTMLElement>('.school-progress').forEach((el) => {
    const subs: string[] = JSON.parse(el.dataset.subs!);
    const cleared = subs.reduce((n, id) => n + TIERS.filter((k) => s.progress[id]?.[k]?.cleared).length, 0);
    el.textContent = `${cleared} tiers cleared`;
  });
</script>

<style>
  .train-hub { padding-block: 2rem; }
  .lede { color: var(--cocoa-soft); max-width: 60ch; }
  .today-strip {
    background: var(--paper); border: 1.5px solid var(--crust); border-radius: var(--radius-card);
    padding: 0.75rem 1rem; margin: 1rem 0 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem;
  }
  .today-strip p { margin: 0; }
  .btn-review {
    font: 600 1rem var(--font-display); background: var(--berry); color: var(--berry-ink);
    border-radius: var(--radius-control); padding: 0.5rem 1rem; min-height: 44px; display: inline-flex; align-items: center;
    text-decoration: none;
  }
  .done { color: var(--berry); font-weight: 600; flex-basis: 100%; }
  .schools { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .school a {
    display: grid; gap: 0.25rem; padding: 1.25rem; min-height: 44px; border-radius: var(--radius-card);
    background: var(--paper); border: 1.5px solid var(--crust); color: var(--cocoa); text-decoration: none;
  }
  .school a:hover, .school a:focus-visible { border-color: var(--berry); }
  .school.soon a { opacity: 0.7; }
  .school-name { font: 600 1.5rem var(--font-display); }
  .school-meta, .school-progress { color: var(--cocoa-soft); font-size: 0.95rem; }
  .links { margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0 1.5rem; }
  .links a { display: inline-flex; align-items: center; min-height: 44px; }
  .goal-help { color: var(--cocoa-soft); font-size: 0.9rem; flex-basis: 100%; }
  .assigned { background: #fff4e0; border: 2px solid var(--r-ancient); border-radius: var(--radius-card); padding: 0.8rem 1rem; margin: 1rem 0; }
  .assigned h2 { font-size: 1.15rem; margin: 0 0 0.4rem; }
  .assigned ul { margin: 0; padding-left: 1.2rem; }
  .assigned a { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--font-display); font-weight: 600; color: var(--berry); }
</style>
